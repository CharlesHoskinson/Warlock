-- Private qualification proposal; append only to Root's isolated protocol package.
-- Runtime opener fixture/Cabal ownership remains Root's separate task.
test-suite window-watch-boundary-controls
  type: exitcode-stdio-1.0
  hs-source-dirs: test-window-watch
  main-is: Main.hs
  build-depends: base >=4.18 && <5, bytestring, text, warlock-protocol
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
