#!/bin/sh
# Graphify's installed interpreter supplies its own Graphify and NetworkX.
graphify_data="${XDG_DATA_HOME:-$HOME/.local/share}"
graphify_python="${GRAPHIFY_PYTHON:-$graphify_data/uv/tools/graphifyy/bin/python}"
if [ ! -x "$graphify_python" ]; then
    printf '%s\n' "Graphify interpreter unavailable: $graphify_python" >&2
    exit 127
fi
exec "$graphify_python" -B "$(dirname "$(readlink -f "$0")")/warlock_ctx.py" "$@"
