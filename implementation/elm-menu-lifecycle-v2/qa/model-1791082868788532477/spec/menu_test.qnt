module menu_test {
  import menu.* from "./menu"
  action check(predicate: bool): bool = all { assert(predicate), state' = state, monitor' = monitor }
  action openA = openMenu(bindingA, Set(0, 2))
  action openB = openMenu(bindingB, Set(0, 2))
  action openC = openMenu(bindingC, Set(0, 2))
  action actCurrent = activate(visibleId(state), currentBinding(state), 0)
  action rejectCurrent = rejectedActivate(visibleId(state), currentBinding(state), 0)
  pure def outcomeOf(s: State, id: int): Outcome =
    s.operations.foldl(Committed, (outcome, op) => if (op.id == id) op.outcome else outcome)

  run concreteAbstractionBudgetsTest = init.then(check(ledgerLimit == 2 and retirementLimit == 3))
  run openNonmutatingTest = init.then(openA).then(check(opened and monitor.intents.length() == 0 and state.operations.length() == 0))
  run navigationNonmutatingTest = init.then(openA).then(navigate("down")).then(check(navigated and monitor.intents.length() == 0 and (match state.view { | Closed => false | Visible(view) => view.selected == 2 })))
  run allDisabledNavigationTest = init.then(openMenu(bindingA, Set())).then(navigate("down")).then(navigate("home")).then(rejectCurrent).then(check(monitor.intents.length() == 0 and (match state.view { | Closed => false | Visible(view) => view.selected == -1 })))
  run disabledActivationTest = init.then(openA).then(rejectedActivate(visibleId(state), bindingA, 1)).then(check(rejectedActivation and state.operations.length() == 0))
  run exactDispatchTest = init.then(openA).then(actCurrent).then(check(activated and exactDispatch and monitor.intents.length() == 1 and state.operations == List({ id: 1, binding: bindingA, outcome: Pending })))
  run pendingDuplicateTest = init.then(openA).then(actCurrent).then(rejectCurrent).then(check(state.operations.length() == 1 and monitor.intents.length() == 1))
  run unknownDuplicateTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Unknown)).then(rejectCurrent).then(check(outcomeOf(state, 1) == Unknown and monitor.intents.length() == 1))
  run independentTargetsTest = init.then(openA).then(actCurrent).then(openB).then(actCurrent).then(check(capacityReached and state.operations.length() == 2 and stableSingleFlight))
  run capacityRefusalTest = init.then(openA).then(actCurrent).then(openB).then(actCurrent).then(openC).then(capacityRefusal(visibleId(state), bindingC, 0)).then(check(capacityRefused and state.operations.length() == 2 and monitor.intents.length() == 2))
  run receiptFreesOneCapacityTest = init.then(openA).then(actCurrent).then(openB).then(actCurrent).then(openC).then(capacityRefusal(visibleId(state), bindingC, 0)).then(receipt(1, bindingA, Refused)).then(check(capacityFreed and monitor.intents.length() == 2)).then(actCurrent).then(check(state.operations.length() == 2 and monitor.intents.length() == 3 and state.nextOperation == 4))
  run unknownRebindNoRetryTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Unknown)).then(dismiss).then(openMenu(reboundA, Set(0, 2))).then(check(unknownRebound)).then(rejectCurrent).then(check(state.operations.length() == 1 and monitor.intents.length() == 1 and outcomeOf(state, 1) == Unknown))
  run reboundReceiptBindingRefusedTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Unknown)).then(openMenu(reboundA, Set(0, 2))).then(rejectReceipt(1, reboundA, Refused)).then(check(rejectedReceipt and state.operations.length() == 1)).then(receipt(1, bindingA, Refused)).then(check(state.operations.length() == 0 and monitor.intents.length() == 1)).then(actCurrent).then(check(monitor.intents.length() == 2))
  run lateAReceiptAfterBTest = init.then(openA).then(actCurrent).then(openB).then(actCurrent).then(receipt(2, bindingB, Committed)).then(openB).then(actCurrent).then(receipt(1, bindingA, Committed)).then(check(state.operations == List({ id: 3, binding: bindingB, outcome: Pending }) and currentBinding(state) == bindingB and hasView(state) and monitor.intents.length() == 3))
  run definitiveReceiptDoesNotRetryTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Refused)).then(check(received and exactReceipt and state.operations.length() == 0 and hasView(state) and monitor.intents.length() == 1))
  run cancelledReceiptDoesNotRetryTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Cancelled)).then(check(hasView(state) and state.operations.length() == 0 and monitor.intents.length() == 1))
  run committedReceiptDoesNotObserveTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Committed)).then(check(not(hasView(state)) and monitor.intents.length() == 1 and state.operations.length() == 0))
  run duplicateReceiptNoMutationTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Refused)).then(rejectReceipt(1, bindingA, Committed)).then(check(rejectedReceipt and state.operations.length() == 0 and monitor.intents.length() == 1))
  run oldReceiptNewPendingTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Refused)).then(actCurrent).then(rejectReceipt(1, bindingA, Refused)).then(check(state.operations == List({ id: 2, binding: bindingA, outcome: Pending }) and monitor.intents.length() == 2))
  run wrongReceiptEveryBindingFieldTest = init.then(openA).then(actCurrent)
    .then(rejectReceipt(1, { ...bindingA, frontend: 2 }, Committed))
    .then(rejectReceipt(1, { ...bindingA, revision: 2 }, Committed))
    .then(rejectReceipt(1, { ...bindingA, output: 2 }, Committed))
    .then(rejectReceipt(1, { ...bindingA, outputGeneration: 2 }, Committed))
    .then(rejectReceipt(1, { ...bindingA, provider: 2 }, Committed))
    .then(rejectReceipt(1, { ...bindingA, capabilities: 2 }, Committed))
    .then(rejectReceipt(1, { ...bindingA, target: { ...targetA, lifetime: 2 } }, Committed))
    .then(rejectReceipt(1, { ...bindingA, target: { ...targetA, session: 2 } }, Committed))
    .then(rejectReceipt(1, { ...bindingA, target: { ...targetA, incarnation: 2 } }, Committed))
    .then(check(state.operations == List({ id: 1, binding: bindingA, outcome: Pending }) and monitor.intents.length() == 1))
  run staleMenuIdTest = init.then(openA).then(dismiss).then(openA).then(rejectedActivate(1, bindingA, 0)).then(check(monitor.intents.length() == 0 and visibleId(state) == 2))
  run retiredBindingRejectsOpenTest = init.then(openB).then(invalidate(bindingA)).then(rejectedOpen(bindingA, Set(0, 2))).then(check(currentBinding(state) == bindingB and monitor.intents.length() == 0))
  run duplicateRetirementDeduplicatedTest = init.then(invalidate(bindingA)).then(duplicateRetirement(bindingA)).then(check(duplicateRetired and retiredCount(state) == 1 and not(state.exhausted)))
  run combinedTombstoneCapacityTest = init.then(invalidate(bindingA)).then(invalidate(bindingB)).then(retireOutput({ output: 2, generation: 1 })).then(duplicateRetirement(bindingA)).then(check(retiredCount(state) == 3 and not(state.exhausted))).then(exhaust(bindingC)).then(check(exhaustedReached and retiredCount(state) == 3 and not(hasView(state))))
  run duplicateOutputAtCapacityTest = init.then(invalidate(bindingA)).then(invalidate(bindingB)).then(retireOutput({ output: 2, generation: 1 })).then(duplicateOutput({ output: 2, generation: 1 })).then(check(duplicateRetired and not(state.exhausted) and retiredCount(state) == 3))
  run outputOverflowExhaustionTest = init.then(invalidate(bindingA)).then(invalidate(bindingB)).then(invalidate(bindingC)).then(exhaustOutput({ output: 2, generation: 1 })).then(check(state.exhausted and state.retiredOutputs.size() == 0 and state.invalidated.size() == 3))
  run exhaustedReceiptStillAcceptedTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Unknown)).then(invalidate(bindingA)).then(invalidate(bindingB)).then(invalidate(bindingC)).then(exhaust(reboundA)).then(rejectedOpen(reboundA, Set(0, 2))).then(receipt(1, bindingA, Refused)).then(check(exhaustedReceipt and state.exhausted and state.operations.length() == 0 and retiredCount(state) == 3 and monitor.intents.length() == 1))
  run retiredOutputOriginalReceiptTest = init.then(openA).then(actCurrent).then(retireOutput({ output: 1, generation: 1 })).then(receipt(1, bindingA, Cancelled)).then(check(state.operations.length() == 0 and monitor.intents.length() == 1 and retiredCount(state) == 1))
  run dismissalPreservesUnknownTest = init.then(openA).then(actCurrent).then(receipt(1, bindingA, Unknown)).then(dismiss).then(check(dismissed and state.operations.length() == 1 and outcomeOf(state, 1) == Unknown))
}
