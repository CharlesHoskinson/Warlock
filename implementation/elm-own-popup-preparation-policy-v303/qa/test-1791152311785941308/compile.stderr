-- BAD FLAGS ---------------------------------------------------- src/Replay.elm

Your `main` program wants an unspecified type from JavaScript.

77| main = Platform.worker {init=\_ -> ((),report (E.list (\(name,value)->E.object [("name",E.string name),("passed",E.bool value)]) cases)),update=\_ model -> (model,Cmd.none),subscriptions=\_ -> Sub.none}
