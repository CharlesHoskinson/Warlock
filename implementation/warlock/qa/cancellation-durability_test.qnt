module CancellationDurability_test {
  import CancellationDurability.* from "./cancellation-durability"
  run commitToAckTest = init.then(hostPending(1)).then(reserve(1)).then(syncFile).then(renameEnvelope).then(syncEnvelopeDir).then(attemptPrepare(1)).then(syncFile).then(renameEnvelope).then(syncEnvelopeDir).then(nativePrepare(1)).then(receivePrepared(1,1,11,100)).then(observePrepared(1)).then(syncFile).then(renameEnvelope).then(syncEnvelopeDir).then(attemptCommit(1)).then(syncFile).then(renameEnvelope).then(syncEnvelopeDir).then(nativeCommit(1)).then(receiveTerminal(1,1,11,100)).then(observeTerminal(1)).then(syncFile).then(renameEnvelope).then(syncEnvelopeDir).expect(s.a.durable==TerminalStored and s.a.live and s.a.file and s.a.nativeAck==0).then(unlinkPending(1)).then(syncAdmissionsDir(1)).then(finish(1)).then(syncFile).then(renameEnvelope).then(syncEnvelopeDir).then(ackPending(1)).then(syncFile).then(renameEnvelope).then(syncEnvelopeDir).then(nativeAck(1)).then(acknowledged(1)).then(syncFile).then(renameEnvelope).then(syncEnvelopeDir).expect(s.a.durable==Acknowledged and s.a.nativeAck==1 and s.a.mutations==1 and not(s.a.live) and s.a.absenceSynced)
