module NativeCancellation_test {
  import NativeCancellation.* from "./native-cancellation"
  run cancelFirstTest = init.then(prepare(1,1,11,3)).then(prepare(2,2,22,4)).then(cancel(1,1,11,3)).expect(s.old.phase==Cancelled and s.old.mutations==0 and s.old.retired==1 and s.peer.token and peerUntouched).then(lateDecision(1,1,11,3)).expect(s.old.phase==Cancelled and s.old.retired==1)
  run commitFirstTest = init.then(prepare(1,1,11,3)).then(commit(1,1,11,3,false)).then(lateDecision(1,1,11,3)).expect(s.old.phase==Committed and s.old.mutations==1 and s.old.retired==1 and terminalImmutable)
  run lostPrepareAckCancelTest = init.then(prepare(1,1,11,3)).then(loseAck(1)).expect(s.old.front==TransportUnknown and s.old.phase==Prepared).then(cancel(1,1,11,3)).then(recover(1,1,11,3)).expect(s.old.front==FrontCancelled and s.old.phase==Cancelled and s.old.mutations==0)
  run unknownCannotCancelTest = init.then(prepare(1,1,11,3)).then(commit(1,1,11,3,true)).then(lateDecision(1,1,11,3)).expect(s.old.phase==ExecutionUnknown and s.old.token and s.old.mutations==1 and not(s.old.acked))
  run unknownCannotAckTest = init.then(prepare(1,1,11,3)).then(commit(1,1,11,3,true)).then(ack(1,1,11,3,true).fail())
  run unknownBlocksHigherTest = init.then(prepare(1,1,11,3)).then(commit(1,1,11,3,true)).then(busy(3)).expect(s.cursorA==1 and s.slotA==1 and s.old.phase==ExecutionUnknown).then(prepare(3,1,33,5).fail())
  run exactRetryQueryTest = init.then(prepare(1,1,11,3)).then(tick).then(retry(1,1,11,3)).then(cancel(1,1,11,3)).then(query(1,1,11,3)).then(lateDecision(1,1,11,3)).expect(s.old.phase==Cancelled and s.old.deadline==3 and s.old.pid==11 and s.old.retired==1 and s.cursorA==1)
  run foreignPeerTest = init.then(prepare(1,1,11,3)).then(prepare(2,2,22,4)).then(cancel(2,2,22,4)).expect(s.old.phase==Prepared and s.old.token and s.old.retired==0 and s.peer.phase==Cancelled and peerUntouched)
  run foreignOwnerRefusedTest = init.then(prepare(1,1,11,3)).then(cancel(1,2,11,3).fail())
  run wrongMetadataRefusedTest = init.then(prepare(1,1,11,3)).then(cancel(1,1,12,3).fail())
  run wrongDeadlineRefusedTest = init.then(prepare(1,1,11,3)).then(cancel(1,1,11,4).fail())
  run higherBusyNoCursorTest = init.then(prepare(1,1,11,3)).then(busy(3)).expect(s.cursorA==1 and s.slotA==1 and s.old.phase==Prepared and s.old.deadline==3).then(prepare(3,1,33,5).fail())
  run directBusyTest = init.then(prepare(1,1,11,3)).then(direct(1).fail())
  run peerIndependentDirectTest = init.then(prepare(1,1,11,3)).then(direct(2)).expect(s.slotA==1 and s.cursorA==1 and s.old.token)
  run terminalUnackedBusyTest = init.then(prepare(1,1,11,3)).then(cancel(1,1,11,3)).expect(s.slotA==1 and s.cursorA==1 and not(s.old.acked)).then(prepare(3,1,33,5).fail())
  run terminalUnackedDirectBusyTest = init.then(prepare(1,1,11,3)).then(cancel(1,1,11,3)).then(direct(1).fail())
  run durableRequiredTest = init.then(prepare(1,1,11,3)).then(cancel(1,1,11,3)).then(ack(1,1,11,3,false).fail())
  run ackThenHigherOldExpiredTest = init.then(prepare(1,1,11,3)).then(cancel(1,1,11,3)).then(ack(1,1,11,3,true)).then(retry(1,1,11,3)).expect(s.slotA==0 and s.cursorA==1 and s.old.phase==Cancelled and s.old.acked).then(prepare(3,1,33,5)).expect(s.slotA==3 and s.cursorA==2 and s.old.phase==Cancelled).then(retry(1,1,11,3).fail())
  run expiryDeadlineTest = init.then(prepare(1,1,11,3)).then(tick).then(tick).then(tick).then(expire(1,1,11,3)).expect(s.old.phase==Refused and s.old.mutations==0 and s.old.retired==1 and s.old.deadline==3)
  run cancelledPrerequisiteWithheldTest = init.then(prepare(1,1,11,3)).then(cancel(1,1,11,3)).then(releaseWaiter(1).fail())
  run wrongKeyCommitWithheldTest = init.then(prepare(1,1,11,3)).then(prepare(2,2,22,4)).then(commit(2,2,22,4,false)).then(releaseWaiter(1).fail())
  run exactCommittedReleasesTest = init.then(prepare(1,1,11,3)).then(commit(1,1,11,3,false)).then(releaseWaiter(1)).expect(s.waiterReleased and dependencySafe)
  run brokenLateCancelTest = init.then(prepare(1,1,11,3)).then(commit(1,1,11,3,false)).then(brokenLateCancel).expect(not(cancelledNoMutation) and not(terminalImmutable))
  run brokenWrongOwnerReleaseTest = init.then(prepare(1,1,11,3)).then(prepare(2,2,22,4)).then(brokenWrongRelease).expect(not(peerUntouched) and s.peer.retired==1)
}
