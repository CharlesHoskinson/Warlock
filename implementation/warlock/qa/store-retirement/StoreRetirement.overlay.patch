+ check "actual close failure propagated" (case failed of Left _ -> True; _ -> False)
+ unknown "Uncertain is retained and never retried" uncertain uncertainCloses Uncertain
+ asyncOwner <- newStoreOwner
+ asyncCloses <- newIORef (0 :: Int)
