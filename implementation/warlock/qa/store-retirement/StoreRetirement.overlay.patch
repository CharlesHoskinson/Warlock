+-- QA-ONLY same-module declaration fragment. Append through the paired QA
+-- overlay to an isolated compiled Store variant; NEVER ship its exports/hooks.
+-- Root supplies an independently pinned, owned0700 empty test directory. Unit
+-- resources exercise actual tracked/closeResource transitions without unsafe FD
+-- double-close. The final missing-file case uses actual public store IO.
+storeRetirementControls :: DirectoryPin -> IO ()
+storeRetirementControls missingPin = do
+ let check label ok = unless ok (ioError (userError ("settled Store: " ++ label)))
+     states (StoreOwner _ rows) = readIORef rows >>= mapM (\(Resource cell _) -> readIORef cell)
+     sealed (StoreOwner gate _) = tryReadMVar gate
+     denied owner = do
+      r <- try (runOwned owner (pure ())) :: IO (Either SomeException ())
+      pure (case r of Left _ -> True; _ -> False)
+     noClose ref = readIORef ref >>= check "retirement never replays a closer" . (== (1 :: Int))
+     unknown label owner closes expected = do
+      first <- retireStoreOwnerIfSettled owner
+      second <- retireStoreOwnerIfSettled owner
+      actual <- states owner
+      gate <- sealed owner
+      blocked <- denied owner
+      check label (not first && not second && actual == [expected] && gate == Just True && blocked)
+      noClose closes
+ empty <- newStoreOwner
+ firstEmpty <- retireStoreOwnerIfSettled empty
+ againEmpty <- retireStoreOwnerIfSettled empty
+ emptyBlocked <- denied empty
+ check "empty owner seals once and denies new work" (firstEmpty && againEmpty && emptyBlocked)
+ closed <- newStoreOwner
+ closeCount <- newIORef (0 :: Int)
+ runOwned closed (tracked closed (pure (Acquired ())) (\_ -> modifyIORef' closeCount (+1)) (\_ -> pure ()))
+ closedBefore <- states closed
+ closedResult <- retireStoreOwnerIfSettled closed
+ noClose closeCount
+ check "actual tracked close receipt permits seal" (closedBefore == [Closed] && closedResult)
+ busy <- newStoreOwner
+ busyCloses <- newIORef (0 :: Int)
+ runOwned busy $ tracked busy (pure (Acquired ())) (\_ -> modifyIORef' busyCloses (+1)) $ \_ -> do
+  refused <- retireStoreOwnerIfSettled busy
+  count <- readIORef busyCloses
+  check "held actual runOwned gate refuses without closing" (not refused && count == 0)
+ busyDone <- retireStoreOwnerIfSettled busy
+ check "busy is not permanently fabricated closed" busyDone
+ noClose busyCloses
+ openOwner <- newStoreOwner
+ openCloses <- newIORef (0 :: Int)
+ tracked openOwner (pure (Acquired ())) (\_ -> modifyIORef' openCloses (+1)) $ \_ -> do
+  observed <- retireStoreOwnerIfSettled openOwner
+  rows <- states openOwner
+  count <- readIORef openCloses
+  blocked <- denied openOwner
+  check "Open resource is unconfirmed and gate sealed, never force-closed" (not observed && rows == [Open] && count == 0 && blocked)
+ openDone <- retireStoreOwnerIfSettled openOwner
+ check "already admitted close completion can later be observed" openDone
+ noClose openCloses
+ closingOwner <- newStoreOwner
+ closingCloses <- newIORef (0 :: Int)
+ let closingRelease _ = do
+      modifyIORef' closingCloses (+1)
+      observed <- retireStoreOwnerIfSettled closingOwner
+      rows <- states closingOwner
+      check "Closing is unconfirmed and never reentered" (not observed && rows == [Closing])
+ tracked closingOwner (pure (Acquired ())) closingRelease (\_ -> pure ())
+ closingDone <- retireStoreOwnerIfSettled closingOwner
+ check "normal close return records Closed" closingDone
+ noClose closingCloses
+ uncertain <- newStoreOwner
+ uncertainCloses <- newIORef (0 :: Int)
+ failed <- try (runOwned uncertain (tracked uncertain (pure (Acquired ()))
+   (\_ -> modifyIORef' uncertainCloses (+1) >> ioError (userError "injected close failure"))
