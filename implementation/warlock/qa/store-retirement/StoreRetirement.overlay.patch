+ check "async close failure is propagated, not swallowed" wasAsync
+ unknown "async uncertainty never becomes closed" asyncOwner asyncCloses Uncertain
+ absent <- newStoreOwner
+ absentCloses <- newIORef (0 :: Int)
+ absentResult <- try (runOwned absent (tracked absent
+   (pure (NotAcquired (userError "explicit no-resource receipt")))
+   (\(_ :: ()) -> modifyIORef' absentCloses (+1)) (\_ -> pure ()))) :: IO (Either SomeException ())
+ absentRows <- states absent
+ absentSettled <- retireStoreOwnerIfSettled absent
+ absentCount <- readIORef absentCloses
+ check "typed no-resource receipt permits Closed without release" (case absentResult of Left _ -> absentRows == [Closed] && absentSettled && absentCount == 0; _ -> False)
+ -- Two exact publication fault points on the real tracked algorithm, via the
+ -- isolated QA-only overlay. Neither is a native descriptor cleanup claim.
+ let publicationFault afterRetain = do
+      owner <- newStoreOwner
+      acquisitions <- newIORef (0 :: Int)
+      releases <- newIORef (0 :: Int)
+      let failNow = ioError (userError "injected publication failure")
