// ROOT ONLY: named source-correspondence traces, not executed by worker.
module store_retirement_test {
  import store_retirement.* from "./store-retirement"
  run twoNestedSuccessThenSeal = init.then(begin).then(register(1)).then(acquireRaw(1)).then(retainValue(1)).then(markOpen(1))
    .then(register(2)).then(acquireRaw(2)).then(retainValue(2)).then(markOpen(2)).then(closeBegin(2)).then(closeSuccess(2))
    .then(closeBegin(1)).then(closeSuccess(1)).then(endRun).then(sealScan)
    .expect(witnessTwoClosed and safety).then(begin.fail())
  run explicitNegativeReceiptIsSettled = init.then(begin).then(register(1)).then(notAcquired(1))
    .then(endRun).then(sealScan).expect(s.observation==Settled and s.r1.noResource and s.r1.closeAttempts==0 and safety)
  run genericAcquireExceptionNeverLooksClean = init.then(begin).then(register(1)).then(acquisitionUnknown(1,true))
    .then(endRun).then(sealScan).expect(witnessUnconfirmedAcquire and s.observation==Unsettled and safety).then(begin.fail())
  run publicationFailureAfterRetainNeverLooksClean = init.then(begin).then(register(1)).then(acquireRaw(1)).then(retainValue(1))
    .then(acquisitionUnknown(1,true)).then(endRun).then(sealScan)
    .expect(s.r1.retained and s.r1.phase==Acquiring and s.observation==Unsettled and safety).then(markOpen(1).fail())
  run rawAcquirePublicationFailureCannotLookClean = init.then(begin).then(register(1)).then(acquireRaw(1))
    .then(acquisitionUnknown(1,false)).then(endRun).then(sealScan)
    .expect(s.r1.possibleOwned and not(s.r1.retained) and s.observation==Unsettled and safety).then(begin.fail())
  run openRequiresRetainedValue = init.then(begin).then(register(1))
    .expect(not(s.r1.retained) and safety).then(markOpen(1).fail())
  run genericExceptionIsNotNegativeReceipt = init.then(begin).then(register(1)).then(acquisitionUnknown(1,true))
    .expect(s.r1.phase==Acquiring and not(s.r1.noResource) and safety).then(notAcquired(1).fail())
  run busyProbeDoesNotSealOrCallClose = init.then(begin).then(register(1)).then(probeBusy)
    .expect(witnessBusy and s.r1.phase==Acquiring and s.r1.closeAttempts==0 and safety)
    .then(notAcquired(1)).then(endRun).then(sealScan).expect(s.observation==Settled and safety)
  run openResourcePreventsSettledSeal = init.then(begin).then(register(1)).then(acquireRaw(1)).then(retainValue(1)).then(markOpen(1))
    .then(endRun).then(sealScan).expect(s.r1.phase==Open and s.observation==Unsettled and safety).then(begin.fail())
  run uncertainCloseNeverRetried = init.then(begin).then(register(1)).then(acquireRaw(1)).then(retainValue(1)).then(markOpen(1))
    .then(closeBegin(1)).then(closeUnknown(1)).then(endRun).then(sealScan)
    .expect(witnessUnknown and s.r1.closeAttempts==1 and s.observation==Unsettled and safety).then(closeBegin(1).fail())
  run oneClosedOneUncertainCannotSealClean = init.then(begin).then(register(1)).then(acquireRaw(1)).then(retainValue(1)).then(markOpen(1))
    .then(register(2)).then(acquireRaw(2)).then(retainValue(2)).then(markOpen(2)).then(closeBegin(1)).then(closeSuccess(1))
    .then(closeBegin(2)).then(closeUnknown(2)).then(endRun).then(sealScan)
    .expect(s.r1.phase==Closed and s.r2.phase==Uncertain and s.observation==Unsettled and safety)
  run scanExceptionSealsAndRethrows = init.then(scanException)
    .expect(s.gate==Sealed and s.observation==ScanThrew and safety).then(begin.fail())
  run afterSuccessfulCloseCannotReclose = init.then(begin).then(register(1)).then(acquireRaw(1)).then(retainValue(1)).then(markOpen(1))
    .then(closeBegin(1)).then(closeSuccess(1)).expect(s.r1.closeAttempts==1 and safety).then(closeBegin(1).fail())
  run emptyOwnerCanSeal = init.then(sealScan).expect(s.observation==Settled and safety).then(begin.fail())
}
