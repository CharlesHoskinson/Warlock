module http_owner_test {
  import http_owner.* from "./http_owner"

  run helloReplyTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(finishRequest)
    .expect(s.elm == Available and s.serverReplyGeneration == 1 and s.nativeOps == Set())
    .then(closeOwned).then(cleanup).expect(s.request == Empty and s.closeCount == 1)
  run slowDeadlineTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(tick).then(chunk).then(tick).then(chunk).then(tick)
    .expect(s.clock == 3 and s.deadline == 3).then(expire).then(closeOwned).then(cleanup)
    .expect(s.elm == Failed and s.request == Empty)
  run incompleteReuseTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(tick).then(tick).then(tick).then(expire)
    .then(closeOwned).then(cleanup).then(retireElm).then(newElm)
    .then(beginCookie).then(completeCookie).then(startConnect).then(admit(true, true, true))
    .expect(s.request == Reading and s.requestGeneration == 2 and s.closeCount == 1)
  run overflowReuseTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(chunk).then(chunk).then(overflow).then(closeOwned).then(cleanup)
    .then(retireElm).then(newElm).then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).expect(s.request == Reading and s.closeCount == 1)
  run stopDrainTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(callbackEnter).then(stopListening)
    .expect(s.request == Reading and s.callbacks == 1).then(detach).then(closeOwned)
    .then(callbackDone).then(cleanup).then(freeOwner).expect(s.freed and s.closeCount == 1)
  run expiryWinsTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(tick).then(tick).then(tick).then(expire)
    .then(finishRequest.fail())
  run finishWinsTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(tick).then(finishRequest).then(tick).then(tick)
    .then(expire.fail())
  run lateCookieTest = init.then(beginCookie).then(retireElm).then(completeCookie)
    .expect(not(s.cookieInstalled) and s.elm == Retired and s.callbacks == 0)
  run failedCookieTest = init.then(beginCookie).then(failCookie)
    .expect(not(s.cookieInstalled) and s.callbacks == 0)
  run cancelCookieTest = init.then(beginCookie).then(cancelCookie).then(completeCookie)
    .expect(not(s.cookieInstalled) and s.callbacks == 0)
  run staleReplyTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(retireElm).then(newElm).then(beginCookie)
    .then(completeCookie).then(startConnect).then(finishRequest)
    .expect(s.elm == Connecting and s.generation == 2 and s.serverReplyGeneration == 1)
  run wrongHostTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(false, true, true).fail())
  run wrongOriginTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, false, true).fail())
  run wrongCookieTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, false).fail())
  run capacityTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(admit(true, true, true).fail())
  run cannotFreeCallbackTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(callbackEnter).then(stopListening).then(detach).then(closeOwned)
    .then(freeOwner.fail())
  run cannotDoubleCloseTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(abortRequest).then(closeOwned).then(closeOwned.fail())
  run timeoutExitsConnectingTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(elmTimeout).expect(s.elm == Failed)
  run stopRejectsAdmissionTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(stopListening).then(admit(true, true, true).fail())
  run callbackDrainBeforeSlotTest = init.then(beginCookie).then(completeCookie).then(startConnect)
    .then(admit(true, true, true)).then(callbackEnter).then(abortRequest).then(closeOwned)
    .then(cleanup.fail())
}
