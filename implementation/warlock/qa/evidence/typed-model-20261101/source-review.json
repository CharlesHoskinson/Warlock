  "clauseVerdicts": [
    {
      "classificationLimits": [
        "Bounded descriptive network state, titles, target/application/workspace IDs, user draft text and display notices remain text; the display-only network state is not an operation/lifecycle discriminator.",
        "Provider.Raw kinds/capability names and Protocol JSON values are intermediate wire data. SurfaceSnapshot and theme mode/motion/kind data are read-only projection/render metadata. Serialized preview outbox JSON preserves encoded policy commands; it is not a second policy-state issuer.",
        "Files/JumpList/SystemMenu/Shortcut String receive parameters are transient wire/API values routed through declared frontend decoders; this is not a claim that every standalone child receive API independently validates all malformed statuses."
      ],
      "clause": "Represent lifecycle, receipt and operation state with custom types",
      "mapping": [
        {
          "basis": "Finite operation and lifecycle distinctions are constructors, with matching requests, generations, scopes and unresolved reservations retained separately from presentation notices.",
          "functionsAndTypes": [
            "Effects.Operation/Status/Transaction",
