            "OverviewRecovery.elm"
          ]
        },
        {
          "basis": "Awaiting and Unconfirmed are retained typed states; pending intent/choices/revision/binding are retained request baselines. Native source/profile distinctions are typed; transient wire status text is not retained as an alternative lifecycle field.",
          "functionsAndTypes": [
            "Confirmation/PendingState/ReceiptStatus/Source",
            "propose",
