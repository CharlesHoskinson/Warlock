      "clause": "Keep native observations separate from desired UI state",
      "mapping": [
        {
          "basis": "Admitted native scenes, geometry and negotiated facts remain observations; desired operations carry captured native context/incarnation/revision/generation. Proposing does not optimistically rewrite observed window state; matching receipts/observations and explicit reconciliation settle uncertainty.",
