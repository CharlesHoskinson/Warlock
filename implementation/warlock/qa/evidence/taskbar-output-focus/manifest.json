  "schema": 1,
  "requirement": "ELM-UI-004",
  "scenarios": [
    "taskbar-inactive",
    "taskbar-active"
  ],
  "ears": "The taskbar SHALL follow the INTERACTION.md primary-action table for zero, single and multiple family entries, distinguish application pin from always-on-top, and expose explicit new-instance actions without launching duplicates on ordinary activation.",
  "verificationScope": "Named native, keyboard and assistive-technology fixtures where applicable; independent observed results, exact identities, source hashes and frozen product-policy oracle.",
  "originalRequirements": [
    {
      "id": "ELM-UI-004",
      "capability": "elm-taskbar",
      "phase": "P3",
      "pattern": "ubiquitous",
      "priority": "must",
      "ears": "The taskbar SHALL follow the INTERACTION.md primary-action table for zero, single and multiple family entries, distinguish application pin from always-on-top, and expose explicit new-instance actions without launching duplicates on ordinary activation.",
      "task": "Implement taskbar decision table with matching pointer/keyboard routes.",
      "verification": "Named native, keyboard and assistive-technology fixtures where applicable; independent observed results, exact identities, source hashes and frozen product-policy oracle.",
      "legacyEvidence": "docs/elm-roadmap/INTERACTION.md; new coverage: final UI/UX review",
      "scenarios": [
        {
          "name": "taskbar-zero",
          "given": "a pinned app with zero windows",
          "when": "primary pointer or keyboard activation occurs",
          "then": "one launch request is issued"
        },
        {
          "name": "taskbar-inactive",
          "given": "one inactive member",
          "when": "primary pointer or keyboard activation occurs",
          "then": "the member visibly activates"
        },
        {
          "name": "taskbar-minimized",
          "given": "one minimized member",
          "when": "primary pointer or keyboard activation occurs",
          "then": "the member restores and visibly activates"
        },
        {
          "name": "taskbar-active",
          "given": "one active eligible member",
          "when": "primary pointer or keyboard activation occurs",
          "then": "the family minimizes with declared focus succession"
        },
        {
          "name": "taskbar-group",
          "given": "multiple family entries",
          "when": "primary pointer or keyboard activation occurs",
          "then": "a group picker opens without new launch and selecting a member visibly activates it"
        },
        {
          "name": "taskbar-refusal",
          "given": "native authority refuses the requested action",
          "when": "primary pointer or keyboard activation occurs",
          "then": "observed state remains authoritative with feedback"
        }
      ],
      "source": "docs/elm-roadmap/coordinator-requirements.json",
      "status": "proposed",
      "taskId": "P3-ELM-UI-004",
      "accountableOwnerRole": "Elm presentation lead",
      "verifierRole": "Independent acceptance reviewer"
    }
