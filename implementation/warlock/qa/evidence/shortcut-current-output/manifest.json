{
  "schema": 1,
  "requirements": [
    {
      "id": "ELM-UX-023",
      "ears": "The Elm desktop SHALL provide keyboard routes for launcher, taskbar groups, switcher, Task View, snap chooser, menus, settings, notifications and jump lists without requiring pointer input.",
      "scenario": {
        "name": "ux-023",
        "given": "pointer is unused",
        "when": "keyboard-only acceptance script visits all migrated surfaces",
        "then": "each surface can be opened, operated and dismissed without pointer events"
      },
      "verification": "Elm replay assertion and isolated native recording: each surface can be opened, operated and dismissed without pointer events."
    },
    {
      "id": "ELM-UI-005",
      "ears": "The launcher SHALL bind results and selection to the current query and catalog generation, apply the frozen matching/ranking policy, expose initial, loading, no-match and unavailable states, and preserve the query with reachable recovery on refusal.",
      "scenario": {
        "name": "search-no-match",
        "given": "a query and catalog fixture",
        "when": "no entries match",
        "then": "no-match message and query remain reachable without launch"
      },
      "verification": "Named native, keyboard and assistive-technology fixtures where applicable; independent observed results, exact identities, source hashes and frozen product-policy oracle."
    }
  ],
