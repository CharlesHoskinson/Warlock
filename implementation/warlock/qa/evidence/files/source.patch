+ app=root/'ipc-fixture';app.mkdir();(app/'scripts').mkdir();(app/'spec').mkdir();(app/'scripts/ops.sh').symlink_to(APP/'scripts/ops.sh');(app/'spec/fileops.qnt').symlink_to(APP/'spec/fileops.qnt')
