module ShortcutDraft_test {
  import ShortcutDraft.* from "./shortcut-draft"
  run baselineBugWitness = init.then(editA).then(beginRead).then(currentBug).expect(not(readPreservesIntent))
  run dirtySameWitness = init.then(editA).then(beginRead).then(sameRead).expect(s.draftA == 1 and s.submitted == 0 and readPreservesIntent)
  run cleanReadWitness = init.then(beginRead).then(changedRead).expect(s.draftA == 2 and s.draftB == 2 and not(s.conflictA) and not(s.conflictB) and s.submitted == 0)
  run conflictWitness = init.then(editA).then(beginRead).then(changedRead).expect(s.conflictA and s.conflictB and not(ready)).then(editA).expect(not(s.conflictA) and s.conflictB and not(ready)).then(beginRead).then(sameRead).expect(s.conflictB).then(reaffirmB).expect(ready).then(submit).expect(s.submitted == 1)
  run unavailableWitness = init.then(editA).then(beginRead).then(unavailableRead).expect(s.draftA == 1 and not(ready)).then(keepA).expect(ready)
  run failedReadWitness = init.then(editA).then(submit).then(beginRead).then(failRead).expect(s.phase == Waiting and s.draftA == 1 and s.storedA == 0 and not(s.inventory) and s.submitted == 1)
  run waitingMismatchWitness = init.then(editA).then(submit).then(beginRead).then(nativeMismatch).expect(s.phase == Waiting and s.submitted == 1).then(submit.fail())
  run storedMismatchWitness = init.then(editA).then(submit).then(lose).then(beginRead).then(storedMismatch).expect(s.phase == Unknown and s.storedA != s.pendingA and s.nativeA == s.pendingA and s.submitted == 1)
  run unknownMismatchWitness = init.then(editA).then(submit).then(lose).then(beginRead).then(nativeMismatch).expect(s.phase == Unknown and s.storedA == s.pendingA and s.nativeA != s.pendingA and s.submitted == 1).then(submit.fail())
  run waitingExactWitness = init.then(editA).then(submit).then(beginRead).then(exactRead).expect(s.phase == Editing and s.submitted == 1 and not(differs)).then(submit.fail())
  run unknownExactWitness = init.then(editA).then(submit).then(lose).then(beginRead).then(exactRead).expect(s.phase == Editing and s.submitted == 1 and not(differs)).then(submit.fail())
  run staleStoredWitness = init.then(editA).then(submit).then(beginRead).then(newerPendingRead).expect(s.revision == 3 and s.conflictA and s.conflictB).then(staleStored).expect(s.phase == Waiting and s.revision == 3 and s.submitted == 1).then(refused).expect(not(ready) and s.conflictA and s.conflictB)
  run staleSavedWitness = init.then(editA).then(submit).then(beginRead).then(newerPendingRead).then(staleSaved).expect(s.phase == Waiting and s.revision == 3 and s.conflictA and s.submitted == 1)
  run savedRequiresNativeWitness = init.then(editA).then(submit).then(savedReceipt(1, s.pendingRequest, committed(s, 2, false))).expect(s.phase == Waiting and s.submitted == 1).then(saved).expect(s.phase == Editing and not(differs))
  run staleReadWitness = init.then(editA).then(beginRead).then(changedRead).then(beginRead).then(staleRead).expect(s.revision == 2 and s.draftA == 1 and s.conflictA and s.submitted == 0)
  run metadataOnlyReadWitness = init.then(editA).then(beginRead).then(changedRead).then(editA).expect(not(s.conflictA) and s.conflictB).then(beginRead).then(changedRead).expect(not(s.conflictA) and s.conflictB and s.draftA == 1)
  run defaultUnavailableWitness = init.then(defaultA).then(beginRead).then(unavailableRead).expect(s.draftA == 2 and not(ready)).then(keepA).expect(ready)
  run foreignWriteBindingWitness = init.then(editA).then(submit).expect(s.phase == Waiting and s.submitted == 1).then(refusedReceipt(2, s.pendingRequest).fail())
  run foreignWriteRequestWitness = init.then(editA).then(submit).expect(s.phase == Waiting and s.revision == 1 and s.submitted == 1).then(storedReceipt(1, s.pendingRequest + 1, committed(s, 2, false)).fail())
  run storedOnlyKeepsConflictWitness = init.then(editA).then(submit).then(beginRead).then(newerPendingRead).then(stored).expect(s.phase == Editing and s.conflictA and s.conflictB and not(ready) and s.submitted == 1).then(beginRead).then(sameRead).expect(s.conflictA and not(s.conflictB) and not(ready) and s.submitted == 1).then(editA).expect(ready).then(submit).expect(s.submitted == 2)
  run duplicateWriteWitness = init.then(editA).then(submit).then(saved).then(ignoredWrite(s.binding, s.pendingRequest)).expect(s.phase == Editing and s.submitted == 1 and not(differs))
  run foreignWitness = init.then(editA).then(submit).then(beginRead).then(foreignRead).expect(s.phase == Waiting and s.expectedRequest > 0 and s.submitted == 1).then(lose).then(foreignRead).expect(s.phase == Unknown and s.expectedRequest > 0)
  // A blocked action has no successor; terminal negative witnesses keep these
  // guard checks executable without inventing a state after a failed update.
  run conflictCannotSubmitWitness = init.then(editA).then(beginRead).then(changedRead).expect(s.conflictA and s.conflictB).then(submit.fail())
  run unavailableCannotSubmitWitness = init.then(editA).then(beginRead).then(unavailableRead).expect(s.draftA == 1).then(submit.fail())
  run unavailableDefaultCannotSubmitWitness = init.then(defaultA).then(beginRead).then(unavailableRead).expect(s.draftA == 2).then(submit.fail())
  run unavailableDefaultCannotEditWitness = init.then(defaultA).then(beginRead).then(unavailableRead).expect(s.draftA == 2).then(defaultA.fail())
}
