  "originals": [
    {
      "requirement": "ELM-UX-031",
      "verification": "Valid/expired/reused notification identity fixtures with exactly-once current dispatch and no stale producer action.",
      "scenarios": [
        {
          "name": "ux-031",
          "given": "notification expires while center is open",
          "when": "user attempts its former action",
          "then": "expired action sends no request to another notification"
        },
        {
          "name": "notification-valid",
          "given": "a current live notification with action identity A",
          "when": "A is invoked",
          "then": "the current producer receives exactly that action once and another notification is unaffected"
        },
        {
          "name": "notification-reused",
          "given": "an expired notification id has been reused by a new native incarnation",
          "when": "an old queued action arrives",
          "then": "the old action is rejected and the new incarnation receives no unintended action"
        }
      ]
    }
  ],
  "scope": "Integrated immutable Elm notification center, live count, semantic history and native session-bus lifecycle in the existing broker. Actual physical GUI current dispatch, expiry withdrawal and old queued refusal after expired numeric ID reuse. Independent original-scenario acceptance remains open.",
