  "originals": [
    {
      "id": "ELM-UX-010",
      "capability": "elm-taskbar",
      "pattern": "event-driven",
      "ears": "WHEN a user invokes an application jump list, the Elm desktop SHALL show only catalog-declared actions and supported recent-item actions for that application identity.",
      "phase": "P5",
      "priority": "must",
      "verification": "Elm replay assertion and isolated native recording: two declared actions appear and unsupported actions are absent.",
      "legacyEvidence": "window-behavior-spec/taskbar_menu.qnt; new recent-item provider coverage",
      "task": "Define jump-list providers and dispatch identity-bound actions.",
      "scenarios": [
        {
          "name": "ux-010",
          "given": "catalog declares two actions",
          "when": "jump list opens",
          "then": "two declared actions appear and unsupported actions are absent"
        },
        {
          "name": "jump-list-recent-identity",
          "given": "an application with supported recent-item provider and a foreign item",
          "when": "its jump list opens and an item is selected",
          "then": "only identity-bound supported recent actions appear and dispatch; foreign items never dispatch"
        }
      ],
      "source": "docs/elm-roadmap/contributions/experience.json",
      "status": "proposed",
      "taskId": "P5-ELM-UX-010",
      "accountableOwnerRole": "Elm presentation lead",
      "verifierRole": "Independent acceptance reviewer"
    }
  ],
  "scope": "Integrated immutable application jump lists with catalog-declared native GIO actions and exact desktop-identity local XBEL recent files. Physical private compositor shows the two declared actions, excludes unsupported/foreign entries and dispatches a declared action plus the owned document once with actual native argv. Foreign/stale/replay refusals use separate real GIO adapter evidence. Independent original-scenario acceptance remains open.",
