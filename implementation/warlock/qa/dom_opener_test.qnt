module dom_opener_test {
  import dom_opener.* from "./dom_opener"
  run menuPositiveTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 1 and s.forwarded == 0).then(verify(true)).expect(s.forwarded == 1 and not(s.nativeRejected))
  run f10ShiftFirstTest = init.then(capture("F10","F10",true)).then(nativeRelease).then(shiftUp).then(documentKeyup("F10","F10",true,false,false,false)).then(verify(true)).expect(s.forwarded == 1)
  run f10KeyFirstTest = init.then(capture("F10","F10",true)).then(nativeRelease).then(documentKeyup("F10","F10",true,false,false,false)).then(shiftUp).then(verify(true)).expect(s.forwarded == 1)
  run f10NoShiftTest = init.then(capture("F10","F10",false).fail())
  run wrongKeyTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("F10","ContextMenu",true,false,false,false)).expect(s.sent == 0 and s.phase == "cancelled")
  run wrongCodeTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","other",true,false,false,false)).expect(s.sent == 0 and s.phase == "cancelled")
  run untrustedTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",false,false,false,false)).expect(s.sent == 0)
  run staleDocumentTest = init.then(capture("ContextMenu","ContextMenu",false)).then(mutate("document")).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 0)
  run staleFocusTest = init.then(capture("ContextMenu","ContextMenu",false)).then(mutate("control")).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 0)
  run staleRootTest = init.then(capture("ContextMenu","ContextMenu",false)).then(mutate("root")).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 0)
  run stalePublicationTest = init.then(capture("ContextMenu","ContextMenu",false)).then(mutate("publication")).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 0)
  run staleLeaseTest = init.then(capture("ContextMenu","ContextMenu",false)).then(mutate("lease")).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 0)
  run disabledTest = init.then(capture("ContextMenu","ContextMenu",false)).then(mutate("disabled")).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 0)
  run disconnectedTest = init.then(capture("ContextMenu","ContextMenu",false)).then(mutate("disconnected")).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 0)
  run blurTest = init.then(capture("ContextMenu","ContextMenu",false)).then(cancel("blur")).then(duplicateKeyup).expect(s.sent == 0)
  run compositionTest = init.then(capture("ContextMenu","ContextMenu",false)).then(cancel("composition")).then(duplicateKeyup).expect(s.sent == 0)
  run scrollTest = init.then(capture("ContextMenu","ContextMenu",false)).then(cancel("scroll")).then(duplicateKeyup).expect(s.sent == 0)
  run dragTest = init.then(capture("ContextMenu","ContextMenu",false)).then(cancel("drag")).then(duplicateKeyup).expect(s.sent == 0)
  run newPressTest = init.then(capture("ContextMenu","ContextMenu",false)).then(cancel("newPress")).then(duplicateKeyup).expect(s.sent == 0)
  run cancelTest = init.then(capture("ContextMenu","ContextMenu",false)).then(cancel("cancel")).then(duplicateKeyup).expect(s.sent == 0)
  run duplicateReleaseTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).then(duplicateKeyup).then(verify(true)).then(duplicateKeyup).expect(s.sent == 1 and s.forwarded == 1)
  run gdkOnlyTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).expect(s.sent == 0 and s.forwarded == 0)
  run missingNativeReleaseTest = init.then(capture("ContextMenu","ContextMenu",false)).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false).fail())
  run failedDomTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).then(verify(false)).expect(s.sent == 1 and s.forwarded == 0 and s.nativeRejected)
  run expiredTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).then(elapse(500001)).then(verify(true)).expect(s.capturedAt == 1 and s.forwarded == 0 and s.nativeRejected)
  run exactDeadlineTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).then(elapse(500000)).then(verify(true)).expect(s.forwarded == 1)
  run changedAfterSendTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).then(mutate("publication")).then(verify(true)).expect(s.sent == 1 and s.forwarded == 0 and s.nativeRejected)
  run cancelledAfterSendTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).then(cancel("newPress")).then(verify(true)).expect(s.forwarded == 0 and s.nativeRejected)
  run epochBeforeSendTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(mutate("epoch")).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).expect(s.sent == 1 and s.forwarded == 0).then(verify(true)).expect(s.sent == 1 and s.forwarded == 0 and s.nativeRejected)
  run epochAfterSendTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,false)).then(mutate("epoch")).then(verify(true)).expect(s.sent == 1 and s.forwarded == 0 and s.nativeRejected)
  run ctrlReleaseTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,true,false,false)).expect(s.sent == 0 and s.phase == "cancelled")
  run altReleaseTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,true,false)).expect(s.sent == 0 and s.phase == "cancelled")
  run metaReleaseTest = init.then(capture("ContextMenu","ContextMenu",false)).then(nativeRelease).then(documentKeyup("ContextMenu","ContextMenu",true,false,false,true)).expect(s.sent == 0 and s.phase == "cancelled")
}
