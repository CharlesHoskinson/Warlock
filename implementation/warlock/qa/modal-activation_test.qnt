module modal_activation_test {
  import modal_activation.* from "./modal-activation"
  run parentRedirectNoClickTest = init.then(constraint(1)).then(commit).then(press)
    .then(all { assert(modalFocused and s.suppressed and s.presses == 0 and safety), s' = s })
  run redirectReleaseSwallowedTest = init.then(constraint(1)).then(commit).then(press).then(release)
    .then(all { assert(s.releases == 0 and not(s.suppressed) and safety), s' = s })
  run nestedDeepestRecipientTest = init.then(constraint(2)).then(commit).then(press)
    .then(all { assert(nestedFocused and safety), s' = s })
  run ambiguousCannotActivateLowerTest = init.then(constraint(3)).then(commit).then(press)
    .then(all { assert(s.focus == 1 and ambiguousRefused and s.presses == 0 and safety), s' = s })
  run cyclicRefusedTest = init.then(constraint(4)).then(commit).then(press)
    .then(all { assert(s.focus == 1 and s.refusals == 1 and s.presses == 0 and safety), s' = s })
  run ineligibleRefusedTest = init.then(constraint(5)).then(commit).then(press)
    .then(all { assert(s.focus == 1 and s.refusals == 1 and s.presses == 0 and safety), s' = s })
  run staleRefusedTest = init.then(constraint(1)).then(press)
    .then(all { assert(s.focus == 1 and s.refusals == 1 and s.presses == 0 and safety), s' = s })
  run protectedOwnerUnaffectedTest = init.then(constraint(1)).then(commit).then(protect).then(press)
    .then(all { assert(s.focus == 1 and not(s.suppressed) and s.redirects == 0 and s.refusals == 0 and safety), s' = s })
  run unrelatedUpperRemainsEligibleTest = init.then(constraint(1)).then(commit).then(point(false)).then(press)
    .then(all { assert(s.focus == 1 and s.presses == 1 and s.redirects == 0 and safety), s' = s })
  run modalRetirementRestoresOwnerTest = init.then(constraint(1)).then(commit).then(press).then(release)
    .then(constraint(0)).then(commit).then(press).then(release)
    .then(all { assert(ownerAfterRetirement and s.presses == 1 and s.releases == 1 and safety), s' = s })
}
