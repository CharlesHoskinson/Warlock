module output_retirement_test {
 import output_retirement.* from "./output-retirement"
 run keyboardLayerOutputTest=init.then(press).then(receive).then(all{assert(keyboardRight and safety),live'=live,highest'=highest,selected'=selected,popup'=popup,workspace'=workspace,keyboard'=keyboard,pointer'=pointer,captured'=captured,serial'=serial,seen'=seen,mutations'=mutations,fallback'=fallback})
 run focusedOutputRetiresTest=init.then(press).then(receive).then(remove(2)).then(all{assert(retiredPopup and safety),live'=live,highest'=highest,selected'=selected,popup'=popup,workspace'=workspace,keyboard'=keyboard,pointer'=pointer,captured'=captured,serial'=serial,seen'=seen,mutations'=mutations,fallback'=fallback})
 run replacementCannotReplayTest=init.then(press).then(remove(2)).then(reconnect).then(receive).then(staleView(2)).then(all{assert(replacementIsolated and safety),live'=live,highest'=highest,selected'=selected,popup'=popup,workspace'=workspace,keyboard'=keyboard,pointer'=pointer,captured'=captured,serial'=serial,seen'=seen,mutations'=mutations,fallback'=fallback})
 run unrelatedRemovalPreservesPopupTest=init.then(press).then(receive).then(remove(1)).then(all{assert(popup==2 and selected==2 and safety),live'=live,highest'=highest,selected'=selected,popup'=popup,workspace'=workspace,keyboard'=keyboard,pointer'=pointer,captured'=captured,serial'=serial,seen'=seen,mutations'=mutations,fallback'=fallback})
 run allOutputsReturnTest=init.then(press).then(receive).then(remove(2)).then(remove(1)).then(reconnect).then(receive).then(all{assert(popup==0 and selected==3 and safety),live'=live,highest'=highest,selected'=selected,popup'=popup,workspace'=workspace,keyboard'=keyboard,pointer'=pointer,captured'=captured,serial'=serial,seen'=seen,mutations'=mutations,fallback'=fallback})
 run internalFallbackCannotReceivePopupTest=init.then(remove(2)).then(remove(1)).then(press).then(receive).then(all{assert(allGone and safety and serial==seen),live'=live,highest'=highest,selected'=selected,popup'=popup,workspace'=workspace,keyboard'=keyboard,pointer'=pointer,captured'=captured,serial'=serial,seen'=seen,mutations'=mutations,fallback'=fallback})
}
