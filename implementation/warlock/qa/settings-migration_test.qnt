// Source proposal only; all tests untypechecked and unrun.
module settings_migration_test {
  import settings_migration.* from "./settings-migration"
  run readOnlyWitness = init.then(readLegacy).expect(s.active == 1 and s.backup == 0 and s.outcome == ReadOnly)
  run successWitness = init.then(readLegacy).then(begin).then(flushBackup).then(linkBackup).then(unlinkBackupTemp).then(syncBackupDirectory).then(writeActive).then(flushActive).then(renameActive).then(syncActiveDirectory).expect(s.active == 2 and s.backup == s.old and s.backupLinks == 1 and s.backupSynced and s.activeDirSynced and s.outcome == Saved)
  run existingExactWitness = init.then(existingExact).then(begin).then(syncExistingFile).then(syncBackupDirectory).then(writeActive).then(flushActive).then(renameActive).then(syncActiveDirectory).expect(s.backup == s.old and s.outcome == Saved)
  run invalidWitness = init.then(invalid).expect(s.outcome == Refused and s.active == 1 and s.backup == 0)
  run casWitness = init.then(casConflict).expect(s.outcome == Refused and s.active == 1 and s.backup == 0)
  run noopWitness = init.then(readLegacy).then(noChange).expect(s.outcome == Refused and s.active == 1 and s.backup == 0)
  run currentSchemaWitness = init.then(currentSchema).then(begin).then(writeActive).then(flushActive).then(renameActive).then(syncActiveDirectory).expect(s.outcome == Saved and s.backup == 0 and s.active == 4 and s.old == 2)
  run unsafeActiveWitness = init.then(unsafeActiveFixture).then(rejectActive).expect(s.outcome == Refused and s.active == 1 and s.backup == 0)
  run invalidSchemaWitness = init.then(invalidSchemaFixture).then(rejectActive).expect(s.outcome == Refused and s.active == 1 and s.backup == 0)
  run foreignBackupWitness = init.then(existingForeign).then(rejectBackup).expect(s.outcome == Refused and s.backup == 3 and s.active == 1)
  run unsafeBackupWitness = init.then(existingUnsafe).then(rejectBackup).expect(s.outcome == Refused and s.backup == 1 and s.active == 1)
  run backupFaultWitness = init.then(begin).then(preRenameFault).expect(s.outcome == Raised and s.active == 1 and s.backup == 0)
  run backupPublishFaultWitness = init.then(begin).then(flushBackup).then(preRenameFault).expect(s.outcome == Raised and s.active == 1 and s.backup == 0)
  run backupDirectoryFaultWitness = init.then(begin).then(flushBackup).then(linkBackup).then(unlinkBackupTemp).then(preRenameFault).expect(s.outcome == Raised and s.active == 1 and s.backup == s.old and not(s.backupSynced))
  run activeFileFaultWitness = init.then(begin).then(flushBackup).then(linkBackup).then(unlinkBackupTemp).then(syncBackupDirectory).then(writeActive).then(preRenameFault).expect(s.outcome == Raised and s.active == 1 and s.backupSynced and s.backup == s.old)
  run activeRenameFaultWitness = init.then(begin).then(flushBackup).then(linkBackup).then(unlinkBackupTemp).then(syncBackupDirectory).then(writeActive).then(flushActive).then(preRenameFault).expect(s.outcome == Raised and s.active == 1 and s.backup == s.old)
  run activeBarrierUnknownWitness = init.then(begin).then(flushBackup).then(linkBackup).then(unlinkBackupTemp).then(syncBackupDirectory).then(writeActive).then(flushActive).then(renameActive).then(postRenameFault).expect(s.outcome == Unknown and s.active == 2 and not(s.activeDirSynced) and s.backup == s.old and s.backupSynced).then(restartRead).expect(s.active == 2 and s.backup == s.old)
  run twoLinkFailClosedWitness = init.then(begin).then(flushBackup).then(linkBackup).then(linkedInterrupt).then(restartRead).then(restartSaveRefusesLinks).expect(s.restartBlocked and s.outcome == RestartRefused and s.active == s.old and s.backup == s.old and s.backupLinks == 2)
  run crashOldWitness = init.then(begin).then(flushBackup).then(linkBackup).then(unlinkBackupTemp).then(syncBackupDirectory).then(writeActive).then(flushActive).then(renameActive).then(crashBeforeBarrierOld).then(restartRead).expect(s.active == 1 and s.backup == s.old and s.backupSynced)
  run brokenWitness = init.then(brokenActivate).expect(s.active == 2 and s.backup == 0 and s.broken and not(originalBeforeActivation))
  run refuseInvalidActivation = init.then(begin).then(flushBackup).then(linkBackup).then(renameActive.fail())
  run repeatedReadWitness = init.then(readLegacy).then(readLegacy).expect(s.active == 1 and s.backup == 0 and not(s.fixtureOpen))
  run repeatedCurrentReadWitness = init.then(currentSchema).then(readCurrent).then(readCurrent).expect(s.active == 2 and s.old == 2 and s.backup == 0 and not(s.fixtureOpen))
  run schema2NoopWitness = init.then(currentSchema).then(noChange).expect(s.outcome == Refused and s.active == 2 and s.old == 2 and s.backup == 0)
  run currentUnsafeBackupWitness = init.then(currentWithUnsafeBackup).then(begin).then(writeActive).then(flushActive).then(renameActive).then(syncActiveDirectory).expect(s.outcome == Saved and s.active == 4 and s.backup == 3 and s.backupLinks == 2 and not(s.publishedBackup))
  run setupCannotCompose = init.then(existingUnsafe).then(currentSchema.fail())
  run setupCannotReset = init.then(currentSchema).then(currentSchema.fail())
  run readClosesSetup = init.then(readLegacy).then(existingExact.fail())
  run refuseForeignStart = init.then(existingForeign).then(begin.fail())
}
