cabal-version: 2.4
name: warlock-elf-observation-proposal
version: 0.1.0.0
build-type: Simple
library
  hs-source-dirs: src
  exposed-modules: Warlock.Elf.Readelf, Warlock.Elf.Graph
  build-depends: base >= 4.18 && < 5, bytestring, containers
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

test-suite elf-cases
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: ElfCases.hs
  other-modules: GoldenNames
  build-depends: base >= 4.18 && < 5, bytestring, containers, warlock-elf-observation-proposal
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
