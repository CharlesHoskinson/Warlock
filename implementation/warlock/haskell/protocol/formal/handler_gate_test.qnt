module handler_gate_test {
 import handler_gate.* from "./handler_gate"
 run validCallbackOnceTest = init.then(beginAdmission(1)).then(publishAdmission).then(enterCallback(1)).then(complete(1,Normal)).expect(s.admitted==1 and s.count==0 and s.normal==1 and s.completed==Set(1) and safety)
 run sequentialTokenReuseTest = init.then(beginAdmission(1)).then(publishAdmission).then(enterCallback(1)).then(complete(1,Normal)).then(beginAdmission(1)).then(publishAdmission).then(enterCallback(1)).then(complete(1,Normal)).expect(s.admitted==2 and s.normal==2 and s.count==0 and safety)
 run invalidUnsupportedNoHandlerTest = init.then(rejectInvalid(UnsupportedVersion)).expect(s.count==0 and s.admitted==0 and s.entered==Set() and s.reasons==[UnsupportedVersion] and safety)
 run boolVersionBadSchemaTest = init.then(rejectInvalid(BadSchema)).expect(s.reasons==[BadSchema] and s.admitted==0 and safety)
