 run normalAndThreadKilledTest = init.then(beginAdmission(1)).then(publishAdmission).then(beginAdmission(2)).then(publishAdmission).then(enterCallback(1)).then(enterCallback(2)).then(retire).then(complete(1,Normal)).then(complete(2,ThreadKilled)).expect(s.mode==Retired and s.normal==1 and s.interrupted==1 and s.reasons==[HandlerFailed] and safety)
 run syncErrorTest = init.then(beginAdmission(1)).then(publishAdmission).then(enterCallback(1)).then(complete(1,SyncError)).expect(s.syncErrors==1 and s.count==0 and s.reasons==[HandlerFailed] and safety)
 run callbackOutsideLockWhileRetiringTest = init.then(beginAdmission(1)).then(publishAdmission).then(enterCallback(1)).then(retire).expect(s.lock==Free and s.mode==Draining and s.active.contains(1) and safety).then(complete(1,Normal)).expect(s.mode==Retired and safety)
 run closedAdmissionRefusesTest = init.then(retire).then(beginAdmission(1).fail())
 run duplicateCompletionRefusesTest = init.then(beginAdmission(1)).then(publishAdmission).then(enterCallback(1)).then(complete(1,Normal)).then(complete(1,Normal).fail())
 run reasonSuffixOrderTest = init.then(rejectInvalid(BadSchema)).then(127.reps(i => rejectInvalid(UnsupportedVersion))).then(rejectInvalid(BadUtf8)).expect(s.reasons.length()==128 and s.reasons.head()==UnsupportedVersion and s.reasons.nth(127)==BadUtf8 and s.admitted==0 and safety)
 run brokenDoubleCompletionCounterexampleTest = init.then(beginAdmission(1)).then(publishAdmission).then(enterCallback(1)).then(complete(1,Normal)).expect(s.admitted==1 and s.count==0 and s.normal==1 and countOwned and accounting).then(brokenDoubleComplete(1)).expect(s.admitted==1 and s.normal==2 and s.count== -1 and not(countOwned) and accounting)
 run brokenInvalidAdmissionCounterexampleTest = init.then(brokenAdmitInvalid(1)).expect(s.admitted==1 and s.active.contains(1) and not(noInvalidAdmission))

