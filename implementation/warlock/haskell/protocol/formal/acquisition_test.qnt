module acquisition_test {
 import acquisition.* from "./acquisition"
 run prepareFailureKeepsCallerTest = init.then(prepareFailure).expect(s.phase==NoShell and s.caller==resources and not(s.retained) and safety)
 run interruptionBeforeTransferTest = init.then(prepare).then(interruptBeforeOffer).expect(s.retained and not(s.accepted) and s.caller==resources and s.transferResult==TransferInterrupted and safety)
 run pendingBeforeConfigureFailureTest = init.then(prepare).then(offer(1)).expect(s.accepted and s.phase==Pending and s.held==Set(1) and s.caller==Set(2) and safety).then(transferReturned).then(beginSetup).then(finishSetup(SyncFault)).expect(s.phase==Failed and s.retained and s.endpoint==Open and safety)
 run interruptedAfterOfferRetainsOwnerTest = init.then(prepare).then(offer(1)).then(interruptAfterOffer).expect(s.accepted and s.retained and s.held==Set(1) and s.transferResult==TransferInterrupted and safety)
 run transferReturnsOwnerTest = init.then(prepare).then(offer(1)).then(transferReturned).expect(s.accepted and s.retained and s.transferResult==TransferReturned and safety)
 run validAcquireAndRetireTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(NoFault)).then(deliver).expect(s.phase==Live and s.transferResult==TransferReturned and s.activationResult==ActivationReturned and safety).then(requestRetire).then(claimClose).then(closeResult(NoFault)).expect(s.endpoint==Confirmed and s.attempts==1 and s.retained and s.accepted and s.transferResult==TransferReturned and s.activationResult==ActivationReturned and safety)
 run setupSyncCloseAsyncTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(SyncFault)).then(claimClose).then(closeResult(AsyncFault)).then(deliver).expect(s.transferResult==TransferReturned and s.setupFault==SyncFault and s.closeFault==AsyncFault and s.activationResult==ThrownCleanupAsync and s.retained and s.endpoint==Uncertain and safety)
 run setupAsyncCloseSyncTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(AsyncFault)).then(claimClose).then(closeResult(SyncFault)).then(deliver).expect(s.transferResult==TransferReturned and s.setupFault==AsyncFault and s.closeFault==SyncFault and s.activationResult==ThrownOriginalAsync and s.endpoint==Uncertain and safety)
 run repeatedUncertainCloseRefusesTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(AsyncFault)).then(claimClose).then(closeResult(SyncFault)).then(requestRetire).then(retireGate).then(repeatRetire).expect(s.gateRetired and s.endpoint==Uncertain and s.attempts==1 and safety).then(claimClose.fail())
 run retirementDuringSetupTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(requestRetire).expect(s.lease and s.retireRequested and s.attempts==0 and s.endpoint==Open and safety).then(finishSetup(NoFault)).then(claimClose).then(closeResult(NoFault)).expect(s.attempts==1 and s.endpoint==Confirmed and safety)
 run secondOfferRetainedByCallerTest = init.then(prepare).then(offer(1)).then(rejectOffer(2)).expect(s.caller==Set(2) and s.held==Set(1) and s.rejectedOffers==1 and safety)
 run acceptedNeverReusedTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(SyncFault)).then(claimClose).then(closeResult(NoFault)).then(requestRetire).then(repeatRetire).expect(s.accepted and s.retained and s.endpoint==Confirmed and safety).then(offer(2).fail())
 run normalRetireEmptyTest = init.then(prepare).then(requestRetire).then(retireGate).then(repeatRetire).expect(s.gateRetired and not(s.accepted) and s.caller==resources and s.phase==Stopped and safety)
 run brokenSetupHandoffTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(brokenSetupHandoff).then(requestRetire).expect(s.lease and s.retireRequested and s.attempts==0 and not(noAbandonedSetup)).then(claimClose.fail())
 run brokenConsumeBeforeShellTest = init.then(brokenConsumeBeforeShell).expect(not(ownerCustody) and not(s.retained))
 run brokenCloseDuringSetupTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(brokenCloseDuringSetup).expect(s.lease and s.attempts==1 and not(noCloseDuringLease))
 run brokenRetryUncertainTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(SyncFault)).then(claimClose).then(closeResult(SyncFault)).then(brokenRetryUncertain).expect(s.attempts==2 and not(oneClose))
 run brokenSecondOfferTest = init.then(prepare).then(offer(1)).then(brokenConsumeSecond).expect(s.held==resources and not(ownerCustody) and not(acceptedOwnsOne))
 run brokenGateClosedTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(SyncFault)).then(claimClose).then(closeResult(SyncFault)).then(requestRetire).then(retireGate).then(brokenGateMeansClosed).expect(s.gateRetired and s.endpoint==Confirmed and not(uncertaintySticky))

 run returnedTransferThenSyncSetupAsyncCloseTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(SyncFault)).then(claimClose).then(closeResult(AsyncFault)).then(deliver).expect(s.retained and s.accepted and s.held==Set(1) and s.transferResult==TransferReturned and s.activationResult==ThrownCleanupAsync and s.setupFault==SyncFault and s.closeFault==AsyncFault and s.endpoint==Uncertain and s.attempts==1 and safety).then(claimClose.fail())
 run returnedTransferThenAsyncSetupSyncCloseTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(AsyncFault)).then(claimClose).then(closeResult(SyncFault)).then(deliver).expect(s.retained and s.accepted and s.held==Set(1) and s.transferResult==TransferReturned and s.activationResult==ThrownOriginalAsync and s.setupFault==AsyncFault and s.closeFault==SyncFault and s.endpoint==Uncertain and s.attempts==1 and safety).then(deliver.fail())
 run activationDuplicateDeliveryRefusedTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(NoFault)).then(deliver).expect(s.transferResult==TransferReturned and s.activationResult==ActivationReturned and s.phase==Live and safety).then(deliver.fail())
 run originalAsyncWinsBothAsyncTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(AsyncFault)).then(claimClose).then(closeResult(AsyncFault)).then(deliver).expect(s.transferResult==TransferReturned and s.activationResult==ThrownOriginalAsync and s.setupFault==AsyncFault and s.closeFault==AsyncFault and s.endpoint==Uncertain and safety)
 run v1SingleResultGuardRegressionTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(SyncFault)).then(claimClose).then(closeResult(AsyncFault)).expect(s.transferResult==TransferReturned and s.activationResult==ActivationPending and not(v1DeliverWouldBeEnabled(s.transferResult)) and s.endpoint==Uncertain and safety).then(deliver).expect(s.transferResult==TransferReturned and s.activationResult==ThrownCleanupAsync and s.retained and safety)
 run laterRetirementCannotStealSuccessfulActivationTest = init.then(prepare).then(offer(1)).then(transferReturned).then(beginSetup).then(finishSetup(NoFault)).then(requestRetire).then(claimClose).then(closeResult(AsyncFault)).then(deliver).expect(s.selectedBranch==SuccessfulBranch and s.transferResult==TransferReturned and s.activationResult==ActivationReturned and s.endpoint==Uncertain and safety)
 run brokenForeignCloseStealsSuccessTest = init.then(prepare).then(offer(1)).then(beginSetup).then(finishSetup(NoFault)).then(requestRetire).then(claimClose).then(closeResult(AsyncFault)).then(brokenForeignCloseStealsSuccess).expect(not(successfulBranchReturns) and not(safety))
}
