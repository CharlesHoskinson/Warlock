  hs-source-dirs: test-ui
  main-is: Main.hs
  build-depends: base >=4.18 && <5, bytestring, text, containers, unix, directory, filepath, process ==1.6.19.0, cryptohash-sha256 ==0.11.102.1, warlock-runtime, warlock-protocol
