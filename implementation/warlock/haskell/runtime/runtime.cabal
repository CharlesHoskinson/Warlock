cabal-version: 3.0
name: warlock-runtime
version: 0.1.0.0
build-type: Simple
extra-source-files: README.md, qualification.json, formal/*.qnt, formal/*.md, formal/*.json
flag vm-security
  description: Enable VM-only WebKit execution security controls
  default: False
  manual: True

library
  hs-source-dirs: src
  exposed-modules: Warlock.Bootstrap, Warlock.Backend, Warlock.Backend.Catalog, Warlock.Backend.PinStore, Warlock.Ui.Http, Warlock.Ui.Owner, Warlock.Ui.Native, Warlock.Ui.Config, Warlock.Ui.Policy, Warlock.Ui.PrivateNetwork, Warlock.Ui.Display, Warlock.Ui.ThreadNamespace, Warlock.Ui.EngineProtocol, Warlock.Ui.EngineAdapter, Warlock.Ui.EngineDeadline, Warlock.Ui.EngineBroker
  other-modules: Warlock.Bootstrap.Aggregate, Warlock.Bootstrap.CurrentSessions, Warlock.Bootstrap.ScopedPeer, Warlock.Bootstrap.SocketOwner, Warlock.Bootstrap.CredentialScopeGuard, Warlock.Backend.Store
  build-depends: base >=4.18 && <5, bytestring, text, containers, network ==3.2.0.0, unix, process ==1.6.19.0, directory, filepath, cryptohash-sha256 ==0.11.102.1, warlock-held-document-proposal, warlock-process-custody, warlock-protocol
  cc-options: -D_GNU_SOURCE
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

executable warlock-ui-backend
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base >=4.18 && <5, bytestring, warlock-runtime
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -threaded

-- Deliberately nonthreaded: enterPrivateNetwork precedes GTK/IO workers.
executable warlock-ui-owner
  hs-source-dirs: ui
  main-is: Main.hs
  other-modules: Warlock.Ui.EngineEntrypoint, Warlock.Ui.WebKit, Warlock.Ui.WebKitABI, Warlock.Ui.EngineCustody, Warlock.Ui.Mvp
  pkgconfig-depends: gobject-2.0
  extra-libraries: webkitgtk-6.0, gtk-4, gobject-2.0, gio-2.0, glib-2.0, soup-3.0
  build-depends: base >=4.18 && <5, bytestring, text, unix, directory, filepath, warlock-runtime, warlock-protocol, warlock-process-custody, network ==3.2.0.0, cryptohash-sha256 ==0.11.102.1
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -with-rtsopts=-V0

executable ui-stream-child
  hs-source-dirs: fixture-ui
  main-is: Main.hs
  build-depends: base >=4.18 && <5, bytestring, text, unix, warlock-protocol
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -threaded

