// Component scheduling model for ELM-ARC-002 / ownership-presentation.
// Source-only traces; root owns pinned model execution.
// Negative actions end in fail() because a blocked action has no successor.
module desktop_idle_lifetime_test {
  import desktop_idle_lifetime.* from "./desktop-idle-lifetime"
  run desktopIdleThenSecondFrameTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(admit).then(beginDesktopWait).then(tick).then(tick).then(tick)
    .expect(witnessIdleBeyondFrameBudget and safety).then(bytesBecomeReady).then(startReadyFrame)
    .then(header).then(completeBody).then(beginCallback).then(applyEffect).then(admit).expect(witnessSecondDelivery and safety)
  run firstReceiveStillTimesOutTest = initialize(Desktop).then(beginFirst).then(tick).then(tick)
    .then(frameTimeout).expect(s.timeoutObserved and s.delivered == 0 and safety)
  run nativeNextStillTimesOutTest = initialize(Native).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(admit).then(beginNativeNext).then(tick).then(tick)
    .then(frameTimeout).expect(s.timeoutObserved and s.delivered == 1 and safety)
  run partialHeaderTimesOutTest = initialize(Desktop).then(beginFirst).then(header)
    .then(tick).then(tick).then(frameTimeout).expect(witnessPartialTimeout and safety)
  run idleLeaderExitWakesEofTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(admit).then(beginDesktopWait).then(leaderExits)
    .expect(witnessExitWaiting).then(shutdownOwnedPeerWrite).then(observeEof)
    .expect(s.eofObserved and not(s.settled) and safety)
  run retirementBeforeReadinessTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(admit).then(beginDesktopWait).then(publishRetirement)
    .expect(witnessRetireWaiting and safety).then(startReadyFrame.fail())
  run retiredWaitSettlesTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(admit).then(beginDesktopWait).then(publishRetirement)
    .then(settleRetired).expect(s.settled and s.delivered == 1 and safety)
  run readinessThenLeaderExitRefusesFrameTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(admit).then(beginDesktopWait).then(bytesBecomeReady).then(leaderExits)
    .expect(s.bytesReady and not(s.leaderAlive) and safety).then(startReadyFrame.fail())
  run originalDeadlineEndsIdleTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(admit).then(beginDesktopWait).then(8.reps(i => tick))
    .then(originalDeadline).expect(s.timeoutObserved and s.time == d and s.delivered == 1 and safety)
  run foreignFrameRefusedTest = initialize(Desktop).then(beginFirst).then(header)
    .then(foreignCredential).then(completeBody).expect(not(s.credentialsMatch) and safety)
    .then(beginCallback.fail())
  run foreignFrameQuarantinedTest = initialize(Desktop).then(beginFirst).then(header)
    .then(foreignCredential).then(completeBody).then(rejectCredential)
    .expect(s.terminalUnknown and s.delivered == 0 and safety)
  run revokedAdmissionRefusedTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(revokeAdmission).expect(s.revoke and safety).then(beginCallback.fail())
  run noConcurrentReaderTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(admit).then(beginDesktopWait)
    .expect(s.ingressHeld and s.readHeld and safety).then(beginDesktopWait.fail())
  run retirementBeforeCallbackRefusesNewAdmissionTest = initialize(Desktop).then(beginFirst)
    .then(header).then(completeBody).then(publishRetirement)
    .expect(s.retired and s.phase == Admitting and safety).then(beginCallback.fail())
  run alreadyAdmittedCallbackMayFinishAfterRetireTest = initialize(Desktop).then(beginFirst)
    .then(header).then(completeBody).then(beginCallback).then(applyEffect).then(publishRetirement)
    .expect(s.effects == 1 and s.delivered == 0 and s.ingressHeld and not(s.readHeld) and safety)
    .then(admit).expect(s.delivered == 1 and s.retired and safety)
    .then(settleRetired).expect(s.settled and s.effects == 1 and safety)
  run alreadyAdmittedCallbackMayFinishAfterFrameDeadlineTest = initialize(Desktop)
    .then(beginFirst).then(header).then(completeBody).then(beginCallback).then(tick).then(tick)
    .expect(s.time == s.frameEnd and s.phase == Callback and safety)
    .then(admit).expect(s.delivered == 1 and s.time == s.frameEnd and safety)
  run validReadOnlyCallbackWithoutEffectTest = initialize(Desktop).then(beginFirst)
    .then(header).then(completeBody).then(beginCallback).then(admit)
    .expect(s.effects == 0 and s.delivered == 1 and safety)
  run exceptionAfterEffectIsUnknownTest = initialize(Desktop).then(beginFirst).then(header)
    .then(completeBody).then(beginCallback).then(applyEffect).then(publishRetirement)
    .then(callbackUncertain).expect(s.effects == 1 and s.delivered == 0 and
      s.terminalUnknown and not(s.settled) and safety)
    .then(settleRetired).expect(s.settled and s.effects == 1 and safety)
  run retirementCannotSettleRunningCallbackTest = initialize(Desktop).then(beginFirst)
    .then(header).then(completeBody).then(beginCallback).then(publishRetirement)
    .expect(s.phase == Callback and s.ingressHeld and safety).then(settleRetired.fail())
  run frameDeadlineDoesNotRenewAcrossFragmentsTest = initialize(Desktop).then(beginFirst)
    .expect(s.frameStart == 0 and s.frameEnd == f).then(header).then(tick).then(completeBody)
    .expect(s.frameStart == 0 and s.frameEnd == f and s.time == 1 and safety)
    .then(tick).then(frameTimeout).expect(s.timeoutObserved and s.time == f and safety)
  run guidedIdleAndSecondDeliveryTest = init.then(9.reps(i => guidedIdleStep))
    .expect(witnessIdleBeyondFrameBudget and safety)
    .then(6.reps(i => guidedIdleStep)).expect(witnessSecondDelivery and safety)
  run guidedLeaderExitWaitingTest = init.then(7.reps(i => guidedLeaderExitStep))
    .expect(witnessExitWaiting and safety)
    .then(2.reps(i => guidedLeaderExitStep)).expect(s.eofObserved and safety)
  run guidedRetirementWaitingTest = init.then(7.reps(i => guidedRetirementStep))
    .expect(witnessRetireWaiting and safety)
    .then(guidedRetirementStep).expect(s.settled and safety)
  run guidedPartialTimeoutTest = init.then(5.reps(i => guidedPartialTimeoutStep))
    .expect(witnessPartialTimeout and safety)
  // Gate permit was issued before both deadlines; actual callback execution
  // can be scheduled afterwards. This is not a new late admission or proof of
  // liveness/cleanup and may race independent supervisor cancellation.
  run preAdmittedEffectMayStartAfterOriginalDeadlineTest = initialize(Desktop)
    .then(beginFirst).then(header).then(completeBody).then(beginCallback)
    .then(8.reps(i => tick)).expect(s.time == d and s.phase == Callback and s.effects == 0 and safety)
    .then(applyEffect).then(admit).expect(s.time == d and s.effects == 1 and s.delivered == 1 and safety)
}
