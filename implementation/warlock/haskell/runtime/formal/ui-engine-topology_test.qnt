// PREPARATION ONLY: companion traces for proposed, unimplemented topology.
// No execution or native acceptance is implied. Root owns all model checks.
// Negative cases assert their reachable prestate and END with action.fail();
// a failed action has no successor. Positive continuations use separate traces.
module ui_engine_topology_test {
  import ui_engine_topology.* from "./ui-engine-topology"
  run mismatchRefusesBrokerGtkTest = init.then(unshareForChildren)
    .expect(witnessMismatch)
  run heldExecNeedsOwnedPidfdTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(registerParentDeath).then(releaseExec.fail())
  run leakedWriterBlocksEofTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(leakWriter).then(brokerDies)
    .expect(witnessLeakedWriter).then(observeLifeEof.fail())
  run earlyParentDeathWitnessTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(brokerDies).expect(witnessDeathBeforeRegistration)
    .then(observeLifeEof).then(detectParentLoss)
    .expect(s.stop and s.quarantine)
  run noSignalForEarlierParentDeathTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(brokerDies).then(registerParentDeath)
    .expect(not(s.deathArmedBeforeLoss)).then(observeParentSignal.fail())
  run positiveVisibleTest = init.then(unshareForChildren).then(pinImage).then(spawnHeld)
    .then(capturePidfd).then(registerParentDeath).then(releaseExec).then(execEngine)
    .then(qualifyProvider).then(gtkStart).then(showMvp)
    .expect(witnessVisibleUnqualifiedCleanup and enginePlacement)
  run callbackOutlivesExitTest = init.then(unshareForChildren).then(pinImage).then(spawnHeld)
    .then(capturePidfd).then(registerParentDeath).then(releaseExec).then(execEngine)
    .then(qualifyProvider).then(gtkStart).then(requestStop).then(pidfdStop)
    .then(observeNsExit).then(reapOwned).expect(witnessExitLateCallback)
    .then(cleanup.fail())
  run positiveOwnedRetirementTest = init.then(unshareForChildren).then(pinImage).then(spawnHeld)
    .then(capturePidfd).then(registerParentDeath).then(releaseExec).then(execEngine)
    .then(qualifyProvider).then(gtkStart).then(requestStop).then(pidfdStop)
    .then(observeNsExit).then(reapOwned).then(callbackComplete).then(disconnectSignal)
    .then(notifyFinalizer).then(retireCallback).then(cleanup).expect(witnessClean and safety)
  run externalHelperSurvivesLocalExitTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(execEngine).then(externalSpawn).then(requestStop).then(pidfdStop)
    .then(observeNsExit).then(reapOwned).expect(witnessExternalSurvives)
    .then(cleanup.fail())
  run readonlyCallbackAdmittedTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(execEngine).then(receiveGoodFragment).then(readonlyCallback)
    .expect(s.readonlyCallbacks == 1 and s.brokerFd0 and not(s.poisoned))
  run deathAfterGoodFragmentBlocksCallbackTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(execEngine).then(receiveGoodFragment).then(observeUnexpectedExit)
    .expect(s.validFragment and s.quarantine and s.readonlyCallbacks == 0)
    .then(readonlyCallback.fail())
  run activeSignalNeedsFinalizerTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(execEngine).then(qualifyProvider).then(gtkStart).then(enterCallback)
    .then(requestStop).then(disconnectSignal).expect(s.callbackActive == 1)
    .then(notifyFinalizer.fail())
  run unknownCallbackRefusesCleanTest = init.then(unshareForChildren).then(pinImage).then(spawnHeld)
    .then(capturePidfd).then(registerParentDeath).then(releaseExec).then(execEngine)
    .then(qualifyProvider).then(gtkStart).then(requestStop).then(pidfdStop)
    .then(observeNsExit).then(reapOwned).then(callbackComplete).then(disconnectSignal)
    .then(notifyFinalizer).then(unknownCallback).then(retireCallback)
    .expect(s.quarantine and not(s.callbackHeld) and s.nsExit and s.reaped)
    .then(cleanup.fail())
  run startupConsumesOriginalDeadlineTest = init.then(tick).then(tick).then(tick)
    .expect(witnessDeadline and s.stop).then(unshareForChildren.fail())
  run expiryBlocksHeldSpawnTest = init.then(unshareForChildren).then(pinImage)
    .then(tick).then(tick).then(tick).expect(witnessDeadline).then(spawnHeld.fail())
  run deadlineQuarantinesTest = init.then(unshareForChildren).then(pinImage).then(spawnHeld)
    .then(capturePidfd).then(registerParentDeath).then(releaseExec).then(execEngine)
    .then(qualifyProvider).then(gtkStart).then(requestStop).then(pidfdStop)
    .then(observeNsExit).then(reapOwned).then(callbackComplete).then(disconnectSignal)
    .then(notifyFinalizer).then(retireCallback).then(tick).then(tick).then(tick)
    .expect(witnessDeadline and s.nsExit and s.reaped and not(s.callbackHeld))
    .then(cleanup.fail())
  run badCredentialsNoCallbackTest = init.then(unshareForChildren).then(pinImage).then(spawnHeld)
    .then(capturePidfd).then(registerParentDeath).then(releaseExec).then(execEngine)
    .then(receiveBadFragment).expect(s.poisoned and s.readonlyCallbacks == 0)
    .then(readonlyCallback.fail())

  // Linux child current namespace equals its for-children namespace after fork;
  // the broker's unshare leaves its own current namespace unchanged.
  run threadCompatibilityAndPid1Test = init.then(unshareForChildren)
    .expect(not(brokerGuardAllowsGtk) and s.brokerCurrent == Original and
      s.brokerChildren == ChildNs and not(namespaceCompatible(UnknownNs, UnknownNs)))
    .then(pinImage).then(spawnHeld).then(capturePidfd).then(registerParentDeath)
    .then(releaseExec).then(execEngine).then(qualifyProvider).then(gtkStart)
    .expect(s.enginePid1 and namespaceCompatible(s.engineCurrent, s.engineChildren) and
      s.engineCurrent == ChildNs and s.brokerFd0 and not(s.brokerGtk) and safety)
  run heldChildParentDeathBlocksExecTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(brokerDies).expect(not(s.brokerAlive) and s.execReleased and s.launch == Held)
    .then(execEngine.fail())
  run heldChildParentDeathEofQuarantinesTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(brokerDies).then(observeLifeEof).then(detectParentLoss)
    .expect(s.stop and s.quarantine and s.lifeEof and s.unrelatedAlive and safety)
  run heldChildEscapedWriterEofAfterCloseTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(leakWriter).then(brokerDies).then(closeEscapedWriter)
    .then(observeLifeEof).then(detectParentLoss)
    .expect(s.lifeEof and s.quarantine and s.unrelatedAlive and safety)
  run stopTargetsOnlyOwnedPidfdTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(execEngine).then(requestStop).then(pidfdStop)
    .expect(s.signalTarget == OwnedPidfd and s.pidfdSent and s.unrelatedAlive and
      not(s.nsExit) and s.reapCount == 0 and safety)
  run noPidfdNoSignalTest = init.then(unshareForChildren).then(pinImage).then(spawnHeld)
    .then(requestStop).expect(not(s.pidfd) and s.signalTarget == NoSignal and
      s.unrelatedAlive and safety).then(pidfdStop.fail())
  run oneReaperOnlyTest = init.then(unshareForChildren).then(pinImage).then(spawnHeld)
    .then(capturePidfd).then(registerParentDeath).then(releaseExec).then(execEngine)
    .then(requestStop).then(pidfdStop).then(observeNsExit).then(reapOwned)
    .expect(s.reapCount == 1 and s.reaped and s.unrelatedAlive and safety)
    .then(reapOwned.fail())
  run callbackActiveAfterNamespaceExitTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(execEngine).then(qualifyProvider).then(gtkStart).then(enterCallback)
    .then(requestStop).then(pidfdStop).then(observeNsExit).then(reapOwned)
    .then(disconnectSignal).expect(s.nsExit and s.callbackActive == 1 and
      s.notifyPending and s.backingHeld and not(s.clean) and safety)
    .then(cleanup.fail())
  run namespaceExitWithNoProviderProofTest = init.then(unshareForChildren).then(pinImage)
    .then(spawnHeld).then(capturePidfd).then(registerParentDeath).then(releaseExec)
    .then(execEngine).then(requestStop).then(pidfdStop).then(observeNsExit).then(reapOwned)
    .expect(s.nsExit and not(s.providerQualified) and s.backingHeld and not(s.clean) and safety)
    .then(cleanup.fail())
  // Directed reachability only; not a replacement for the broad step.
  run guidedCleanReachabilityTest = init.then(19.reps(i => guidedCleanStep))
    .expect(witnessClean and safety)
  run guidedVisibleExitAndCleanTest = init.then(10.reps(i => guidedCleanStep))
    .expect(witnessVisibleUnqualifiedCleanup and safety)
    .then(3.reps(i => guidedCleanStep)).expect(witnessExitLateCallback and safety)
    .then(6.reps(i => guidedCleanStep)).expect(witnessClean and safety)
  run guidedExternalSurvivesTest = init.then(11.reps(i => guidedExternalStep))
    .expect(witnessExternalSurvives and safety)
  run guidedUnknownCallbackTest = init.then(12.reps(i => guidedUnknownCallbackStep))
    .expect(witnessUnknownQuarantine and s.callbackHeld and safety)
}
