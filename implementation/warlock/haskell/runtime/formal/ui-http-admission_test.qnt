// Named traces are unexecuted source until root runs the pinned Quint 0.33.
module ui_http_admission_test {
  import ui_http_admission.* from "./ui-http-admission"
  run controllerCommit = init.then(receive(validCommit)).then(dispatch).then(close).expect(s.sends == 1 and s.reservations == 1 and s.responses == 1 and safety)
  run emptyCommit = init.then(receive({...validCommit, requestCount: 0, firstBinding: false, secondBinding: false})).then(dispatch).expect(s.sends == 1 and safety)
  run barAction = init.then(receive(validBar)).then(dispatch).expect(s.actions == 1 and s.req.role == Bar and safety)
  run popupAction = init.then(receive(validPopup)).then(dispatch).expect(s.actions == 1 and s.req.role == Popup and safety)
  run controllerRead = init.then(receive(validEvents)).then(dispatch).expect(s.dequeues == 1 and safety)
  run barRead = init.then(receive({...validEvents, role: Bar})).then(dispatch).expect(s.dequeues == 1 and safety)
  run popupRead = init.then(receive({...validEvents, role: Popup})).then(dispatch).expect(s.dequeues == 1 and safety)
  run documentWithoutApi = init.then(receive(validDocument)).then(dispatch).expect(s.documents == 1 and safety)
  run readMissingApi = init.then(receive({...validEvents, api: false})).then(dispatch).expect(s.result == Rejected and s.dequeues == 0)
  run wrongHost = init.then(receive({...validCommit, host: false})).then(dispatch).expect(s.result == Rejected and s.records == 0 and s.sends == 0)
  run foreignOrigin = init.then(receive({...validEvents, origin: Foreign})).then(dispatch).expect(s.result == Rejected and s.dequeues == 0)
  run missingPostOrigin = init.then(receive({...validCommit, origin: Absent})).then(dispatch).expect(s.result == Rejected and s.sends == 0)
  run missingPostApi = init.then(receive({...validCommit, api: false})).then(dispatch).expect(s.result == Rejected and s.sends == 0)
  run optionsRefused = init.then(receive({...validEvents, method: Options})).then(dispatch).expect(s.result == Rejected and s.dequeues == 0)
  run unknownRoute = init.then(receive({...validEvents, route: Other})).then(dispatch).expect(s.result == Rejected and s.dequeues == 0)
  run wrongMethod = init.then(receive({...validEvents, method: Post})).then(dispatch).expect(s.result == Rejected and s.dequeues == 0)
  run roleIsolation = init.then(receive({...validCommit, role: Bar})).then(dispatch).expect(s.result == Rejected and s.sends == 0)
  run controllerCannotAct = init.then(receive({...validBar, role: Controller})).then(dispatch).expect(s.result == Rejected and s.actions == 0)
  run badType = init.then(receive({...validCommit, contentType: false})).then(dispatch).expect(s.result == Rejected and s.sends == 0)
  run getBody = init.then(receive({...validEvents, declared: 1, observed: 1})).then(dispatch).expect(s.result == Rejected and s.dequeues == 0)
  run getContentType = init.then(receive({...validEvents, contentType: true})).then(dispatch).expect(s.result == Rejected and s.dequeues == 0)
  run emptyPost = init.then(receive({...validCommit, declared: 0, observed: 0})).then(dispatch).expect(s.result == Rejected and s.sends == 0)
  run commitLimit = init.then(receive({...validCommit, declared: 131072, observed: 131072})).then(dispatch).expect(s.sends == 1 and safety)
  run actionLimit = init.then(receive({...validBar, declared: 8192, observed: 8192})).then(dispatch).expect(s.actions == 1 and safety)
  run actionOverLimit = init.then(receive({...validBar, declared: 8193, observed: 8193})).then(dispatch).expect(s.result == Rejected and s.actions == 0)
  run wireOverLimit = init.then(receive({...validCommit, declared: 131073, observed: 131073})).expect(s.result == Rejected and s.sends == 0)
  run duplicateHeader = init.then(receive({...validCommit, duplicate: true})).expect(s.result == Rejected and s.records == 0)
  run transferEncoding = init.then(receive({...validCommit, forbidden: true})).expect(s.result == Rejected and s.records == 0)
  run malformedHeader = init.then(receive({...validCommit, headerSyntax: false})).expect(s.result == Rejected and s.records == 0)
  run noncanonicalLength = init.then(receive({...validCommit, canonicalLength: false})).expect(s.result == Rejected and s.records == 0)
  run truncatedBody = init.then(receive({...validCommit, observed: 9})).expect(s.result == Rejected and s.records == 0)
  run observedExtra = init.then(receive({...validCommit, observed: 11})).expect(s.result == Rejected and s.records == 0)
  run malformedUtf8OrSchema = init.then(receive({...validCommit, payload: false})).then(dispatch).expect(s.result == Rejected and s.sends == 0 and s.reservations == 0 and s.records == 1)
  // Framing/policy refusal still sends a refusal response; it has no owner
  // record, scope read, dequeue, action, reservation or native send.
  run invalidWireRefusalIo = init.then(receive({...validCommit, duplicate: true})).then(close).expect(s.refusalResponses == 1 and s.records == 0 and s.scopeReads == 0 and s.dequeues == 0 and s.actions == 0 and s.reservations == 0 and s.sends == 0 and safety)
  run invalidPolicyRefusalIo = init.then(receive({...validCommit, host: false})).then(dispatch).then(close).expect(s.refusalResponses == 1 and s.records == 0 and s.scopeReads == 0 and s.dequeues == 0 and s.actions == 0 and s.reservations == 0 and s.sends == 0 and safety)
  // Code-as-built divergence from the separately named desired ordering.
  run invalidCommitOwnerIoGap = init.then(receive({...validCommit, secondBinding: false})).then(dispatch).then(close).expect(s.records == 1 and s.scopeReads == 1 and s.refusalResponses == 1 and s.reservations == 0 and s.sends == 0 and not(desiredWholeBeforeOwnerIO) and safety)
  run positiveWitnessesCommit = init.then(receive(validCommit)).then(dispatch).expect(witnessCommit and safety)
  run positiveWitnessesBar = init.then(receive(validBar)).then(dispatch).expect(witnessBar and safety)
  run positiveWitnessesPopup = init.then(receive(validPopup)).then(dispatch).expect(witnessPopup and safety)
  run positiveWitnessesRead = init.then(receive(validEvents)).then(dispatch).expect(witnessRead and safety)
  run positiveWitnessesDocument = init.then(receive(validDocument)).then(dispatch).expect(witnessDocument and safety)
  run firstForeignBinding = init.then(receive({...validCommit, firstBinding: false})).then(dispatch).expect(s.result == Rejected and s.sends == 0 and s.reservations == 0)
  run secondForeignBinding = init.then(receive({...validCommit, secondBinding: false})).then(dispatch).expect(s.result == Rejected and s.sends == 0 and s.reservations == 0)
  run projectionFailure = init.then(receive({...validCommit, presentation: false})).then(dispatch).expect(s.result == Rejected and s.sends == 0 and s.reservations == 0)
  run tooManyRequests = init.then(receive({...validCommit, requestCount: 3})).then(dispatch).expect(s.result == Rejected and s.sends == 0)
  run invalidAction = init.then(receive({...validPopup, payload: false})).then(dispatch).expect(s.result == Rejected and s.actions == 0)
  // fail() terminates the trace without a successor; verify the pre-state first.
  run oneRequestClose = init.then(receive(validEvents)).then(dispatch).then(close).expect(s.dequeues == 1 and s.responses == 1 and safety)
  run closedRejectsRequest = init.then(receive(validEvents)).then(dispatch).then(close).expect(s.dequeues == 1 and s.responses == 1 and safety).then(receive(validEvents).fail())
  run closedRejectsSecondClose = init.then(receive(validEvents)).then(dispatch).then(close).expect(s.dequeues == 1 and s.responses == 1 and safety).then(close.fail())
  run noDispatchBeforeFraming = init.expect(s.records == 0 and s.sends == 0).then(dispatch.fail())
}
