// Source-only directed tests. Root must execute with the pinned Quint 0.33.
module ui_frontend_delivery_test {
  import ui_frontend_delivery.* from "./ui-frontend-delivery"
  run delivery204NotReceiptTest = initController.then(policyRequest).then(enqueue).then(posted(Empty204)).expect(s.completed == 1 and s.policy == Waiting and s.nativeAck == 0 and safety)
  run explicitCorrelatedReceiptTest = initController.then(policyRequest).then(enqueue).then(posted(Empty204)).then(receipt).expect(s.policy == Confirmed and s.nativeAck == 1 and safety)
  run queuedOrderAndDrainTest = initController.then(enqueue).then(enqueue).then(enqueue).then(posted(Empty204)).expect(s.sent == 2 and s.pending == 1 and s.active).then(posted(Empty204)).then(posted(Empty204)).expect(s.sent == 3 and s.completed == 3 and not(s.active) and safety)
  run boundedQueueFailureTest = initRenderer.then(16.reps(i => enqueue)).expect(s.active and s.pending == 15).then(enqueue).expect(s.failed and s.lost == 1 and s.sent == 1 and safety)
  run post200FailsTest = initController.then(policyRequest).then(enqueue).then(posted(Body200)).expect(s.failed and s.policy == Unknown and s.completed == 0 and s.nativeAck == 0)
  run transportLossNoReplayTest = initController.then(policyRequest).then(enqueue).then(enqueue).then(posted(TransportError)).then(lateCallback).expect(s.failed and s.policy == Unknown and s.sent == 1 and s.pending == 1 and s.nativeAck == 0 and safety).then(enqueue.fail())
  run transportLossNoReceiptTest = initController.then(policyRequest).then(enqueue).then(enqueue).then(posted(TransportError)).then(lateCallback).expect(s.failed and s.policy == Unknown and s.sent == 1 and s.pending == 1 and s.nativeAck == 0 and safety).then(receipt.fail())
  run stopLateCallbackTest = initRenderer.then(enqueue).then(stop).then(lateCallback).expect(s.failed and s.sent == 1 and s.completed == 0 and s.lost == 1).then(posted(Empty204).fail())
  run controllerGatewayTest = initController.then(polled(Body200, NativeEvent)).then(polled(Body200, ViewTopology)).then(polled(Body200, ViewAction)).then(polled(Body200, ViewDisposition)).then(polled(Body200, ViewDismiss)).then(polled(Body200, ViewEscape)).then(polled(Body200, ViewReflow)).expect(s.delivered == 7 and not(s.failed))
  run rendererGatewayTest = initRenderer.then(polled(Body200, Presentation)).then(polled(Body200, Announcements)).then(polled(Body200, Focus)).expect(s.delivered == 3 and not(s.failed))
  run wrongRoleGatewayTest = initRenderer.then(polled(Body200, NativeEvent)).expect(s.failed and s.delivered == 0)
  run controllerRejectsRendererTest = initController.then(polled(Body200, Focus)).expect(s.failed and s.delivered == 0)
  run emptyPollTest = initRenderer.then(polled(Empty204, Other)).expect(not(s.failed) and s.delivered == 0)
  run pollDelayLossNoRestartTest = initController.then(policyRequest).then(enqueue).then(enqueue).then(polled(Empty204, Other)).then(posted(TransportError)).then(lateCallback).expect(s.failed and not(s.polling) and s.policy == Unknown and s.sent == 1 and s.pending == 1 and s.completed == 0 and s.nativeAck == 0 and safety).then(pollTick.fail())
  run pollDelayLossNoPostTest = initController.then(policyRequest).then(enqueue).then(enqueue).then(polled(Empty204, Other)).then(posted(TransportError)).then(lateCallback).expect(s.failed and not(s.polling) and s.policy == Unknown and s.sent == 1 and s.pending == 1 and s.completed == 0 and s.nativeAck == 0 and safety).then(posted(Empty204).fail())
  run pollDelayEarlyResponseTest = initRenderer.then(polled(Empty204, Other)).expect(not(s.polling) and s.delivered == 0 and not(s.failed)).then(polled(Body200, Focus).fail())
  run pollDelayResumeTest = initRenderer.then(polled(Empty204, Other)).then(pollTick).then(polled(Body200, Focus)).expect(s.delivered == 1 and s.polling and not(s.failed))
  run fixedRolesTest = initRenderer.expect(s.policy == Idle and s.nativeAck == 0).then(policyRequest.fail())
  run rendererNoReceiptTest = initRenderer.expect(s.policy == Idle and s.nativeAck == 0).then(receipt.fail())
  run controllerCannotRenderTest = initController.expect(s.publication == Zero and s.focusCount == 0).then(frame(First, First, Popup, HugeA, true, false).fail())
  run wrongStatusTest = initController.then(polled(OtherResponse, NativeEvent)).expect(s.failed and s.delivered == 0)
  run exactFocusTest = initRenderer.then(frame(First, First, Popup, HugeA, true, false)).then(focus(First, First, Popup, HugeA)).expect(s.focused == HugeA and s.focusCount == 1 and safety)
  run focusOnlyTest = initRenderer.then(frame(First, First, Bar, HugeB, false, true)).then(focus(First, First, Bar, HugeB)).expect(s.focused == HugeB and s.focusCount == 1)
  run disabledTargetTest = initRenderer.then(frame(First, First, Popup, HugeA, false, false)).expect(s.focusCount == 0).then(focus(First, First, Popup, HugeA).fail())
  run mismatchedPublicationFocusTest = initRenderer.then(frame(First, First, Popup, HugeA, true, false)).expect(s.focusCount == 0).then(focus(Next, First, Popup, HugeA).fail())
  run mismatchedLeaseFocusTest = initRenderer.then(frame(First, First, Popup, HugeA, true, false)).expect(s.focusCount == 0).then(focus(First, Next, Popup, HugeA).fail())
  run mismatchedSurfaceFocusTest = initRenderer.then(frame(First, First, Popup, HugeA, true, false)).expect(s.focusCount == 0).then(focus(First, First, Bar, HugeA).fail())
  run mismatchedTargetFocusTest = initRenderer.then(frame(First, First, Popup, HugeA, true, false)).expect(s.focusCount == 0).then(focus(First, First, Popup, HugeB).fail())
  run stalePublicationTest = initRenderer.then(frame(Next, First, Popup, HugeA, true, false)).expect(s.publication == Next and s.target == HugeA).then(frame(First, First, Popup, HugeB, true, false).fail())
  run staleLeaseTest = initRenderer.then(frame(First, Next, Popup, HugeA, true, false)).expect(s.lease == Next and s.target == HugeA).then(frame(Next, First, Popup, HugeB, true, false).fail())
  run imeRejectsFocusTest = initRenderer.then(frame(First, First, Popup, HugeA, true, false)).then(focus(First, First, Popup, HugeA)).then(preedit).then(frame(Next, First, Popup, HugeB, true, false)).expect(s.composing and s.focused == HugeA and s.focusCount == 1).then(focus(Next, First, Popup, HugeB).fail())
  run imeRetainsFocusTest = initRenderer.then(frame(First, First, Popup, HugeA, true, false)).then(focus(First, First, Popup, HugeA)).then(preedit).then(frame(Next, First, Popup, HugeB, true, false)).expect(s.composing and s.focused == HugeA and s.focusCount == 1).then(endPreedit).then(focus(Next, First, Popup, HugeB)).expect(s.focused == HugeB and s.focusCount == 2)
  run fullWidthPublicationMismatchTest = initRenderer.then(frame(HugeA, HugeA, Bar, HugeA, true, false)).expect(s.focusCount == 0).then(focus(HugeB, HugeA, Bar, HugeA).fail())
  run fullWidthLeaseMismatchTest = initRenderer.then(frame(HugeA, HugeA, Bar, HugeA, true, false)).expect(s.focusCount == 0).then(focus(HugeA, HugeB, Bar, HugeA).fail())
  run fullWidthTargetMismatchTest = initRenderer.then(frame(HugeA, HugeA, Bar, HugeA, true, false)).expect(s.focusCount == 0).then(focus(HugeA, HugeA, Bar, HugeB).fail())
  run distinctFullWidthAtomsTest = initRenderer.then(frame(HugeA, HugeA, Bar, HugeA, true, false)).then(focus(HugeA, HugeA, Bar, HugeA)).expect(s.focusCount == 1 and s.focused == HugeA)
}
