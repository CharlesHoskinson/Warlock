// Directed traces for root only; author has not executed these tests.
module ui_engine_rpc_test {
  import ui_engine_rpc.* from "./ui-engine-rpc"
  run positiveStop = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, true, true, 1)).then(response(1, Stop, true, true, 1)).then(confirmReplySent).expect(s.readCalls == 1 and s.ownerEventAttempts == 0 and s.responses == 1 and s.nativeWindowEffects == 0 and safety)
  run positiveRemaining = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Remaining, true, true, 1)).then(response(1, Remaining, true, true, 1)).then(confirmReplySent).expect(s.readCalls == 1 and s.ownerEventAttempts == 0 and s.responses == 1 and s.nativeWindowEffects == 0 and safety)
  run positiveLastProjection = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, LastProjection, true, true, 1)).then(response(1, LastProjection, true, true, 1)).then(confirmReplySent).expect(s.readCalls == 1 and s.ownerEventAttempts == 0 and s.responses == 1 and s.nativeWindowEffects == 0 and safety)
  run positiveTopology = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Topology, true, true, 1)).then(viewDisposition(true, true)).then(response(1, Topology, true, true, 1)).then(confirmReplySent).expect(s.ownerEventAttempts == 1 and s.acceptedViews == 1 and s.readCalls == 0 and s.responses == 1 and s.nativeWindowEffects == 0 and safety)
  run positiveDismiss = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Dismiss, true, true, 1)).then(viewDisposition(true, true)).then(response(1, Dismiss, true, true, 1)).then(confirmReplySent).expect(s.ownerEventAttempts == 1 and s.acceptedViews == 1 and s.readCalls == 0 and s.responses == 1 and s.nativeWindowEffects == 0 and safety)
  run positiveEscape = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Escape, true, true, 1)).then(viewDisposition(true, true)).then(response(1, Escape, true, true, 1)).then(confirmReplySent).expect(s.ownerEventAttempts == 1 and s.acceptedViews == 1 and s.readCalls == 0 and s.responses == 1 and s.nativeWindowEffects == 0 and safety)
  run positiveReflow = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Reflow, true, true, 1)).then(viewDisposition(true, true)).then(response(1, Reflow, true, true, 1)).then(confirmReplySent).expect(s.ownerEventAttempts == 1 and s.acceptedViews == 1 and s.readCalls == 0 and s.responses == 1 and s.nativeWindowEffects == 0 and safety)
  run staleViewIsNotTransportPoison = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Dismiss, true, true, 1)).then(viewDisposition(false, true)).then(response(1, Dismiss, true, true, 1)).then(confirmReplySent).expect(s.staleViews == 1 and not(s.ownerFailed) and not(s.poisoned) and s.nativeWindowEffects == 0 and safety)
  run staleTopologyRefused = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Topology, true, true, 1)).then(viewDisposition(false, true)).then(response(1, Topology, true, true, 1)).then(confirmReplySent).expect(s.ownerFailed and s.staleViews == 0 and s.acceptedViews == 0 and not(s.poisoned) and safety)
  run invalidViewFailsOwner = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Dismiss, true, true, 1)).then(viewDisposition(true, false)).expect(s.ownerFailed and not(s.poisoned) and s.acceptedViews == 0 and safety)
  run malformedPoisons = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, false, true, 1)).expect(s.poisoned and s.admitted == 0 and safety)
  run foreignPeerPoisons = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, true, false, 1)).expect(s.poisoned and s.admitted == 0 and safety)
  run foreignIncarnationPoisons = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, true, true, 2)).expect(s.poisoned and s.admitted == 0 and safety)
  run skippedIdPoisons = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(2, Stop, true, true, 1)).expect(s.poisoned and s.admitted == 0 and safety)
  run mismatchedMethodPoisons = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, true, true, 1)).then(response(1, Remaining, true, true, 1)).expect(s.poisoned and s.responses == 0 and safety)
  run unknownMethodPoisons = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Other, true, true, 1)).expect(s.poisoned and s.admitted == 0 and safety)
  run eofNoReplay = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, true, true, 1)).then(response(1, Stop, true, true, 1)).then(eof).expect(s.poisoned and s.admitted == 1 and s.responses == 0 and s.nativeWindowEffects == 0 and safety).then(request(1, Stop, true, true, 1).fail())
  run replayPoisons = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, true, true, 1)).then(response(1, Stop, true, true, 1)).then(confirmReplySent).then(request(1, Stop, true, true, 1)).expect(s.poisoned and s.admitted == 1 and s.responses == 1 and safety)
  run overlappingReplyPoisons = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, true, true, 1)).then(response(1, Stop, true, true, 1)).then(request(2, Remaining, true, true, 1)).expect(s.poisoned and s.admitted == 1 and s.responses == 0 and safety)
  run originalDeadlineNoRenewal = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(deadlineReached).then(request(1, Dismiss, true, true, 1)).then(viewDisposition(true, true)).expect(s.expired and s.deadline == originalD and s.acceptedViews == 0 and not(s.poisoned) and safety)
  run idExhaustionNoWrap = init.then(spawnHeld).then(bindPeer(true, true)).then(releaseExec).then(observeExec).then(request(1, Stop, true, true, 1)).then(response(1, Stop, true, true, 1)).then(confirmReplySent).then(request(2, Remaining, true, true, 1)).then(response(2, Remaining, true, true, 1)).then(confirmReplySent).then(request(3, LastProjection, true, true, 1)).then(response(3, LastProjection, true, true, 1)).then(confirmReplySent).then(request(4, Topology, true, true, 1)).then(viewDisposition(true, true)).then(response(4, Topology, true, true, 1)).then(confirmReplySent).then(request(5, Dismiss, true, true, 1)).then(viewDisposition(true, true)).then(response(5, Dismiss, true, true, 1)).then(confirmReplySent).then(request(6, Escape, true, true, 1)).then(viewDisposition(true, true)).then(response(6, Escape, true, true, 1)).then(confirmReplySent).then(request(7, Reflow, true, true, 1)).then(viewDisposition(true, true)).then(response(7, Reflow, true, true, 1)).then(confirmReplySent).then(request(8, Stop, true, true, 1)).expect(s.poisoned and s.lastId == 7 and s.responses == 7 and s.nativeWindowEffects == 0 and safety)
}
