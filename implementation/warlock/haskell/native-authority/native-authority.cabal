cabal-version: 3.0
name: warlock-native-authority
version: 0.1.0.0
build-type: Simple
extra-source-files: README.md qualification.json
library
  hs-source-dirs: src
  exposed-modules: Warlock.Native.Cancellation
  other-modules: Warlock.Native.Cancellation.Internal
  build-depends: base >=4.18 && <5, bytestring, text, warlock-protocol
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

test-suite native-cancellation-controls
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test, src
  other-modules: Warlock.Native.Cancellation.Internal
  build-depends: base >=4.18 && <5, bytestring, text, warlock-protocol
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -threaded
