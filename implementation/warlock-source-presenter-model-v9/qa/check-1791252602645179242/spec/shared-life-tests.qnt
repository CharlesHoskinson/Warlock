module shared_life_tests {
 import shared_life.* from "./shared-life"
 action check(ok:bool):bool=all{s'=s,assert(ok and safety)}
 run SharedResumeWithHeldSibling = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Hold2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(Close2)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedResumeBlockedByOwnReader = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Hold1)).then(fire(Release1)).then(fire(Resume1)).then(fire(Close1)).then(fire(Drain1)).then(fire(Ack1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedResumeBlockedByOwnJournal = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Resume1)).then(fire(Ack1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedOldLeaseDoesNotReserve = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(fire(ResumeOld1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedMissingGateDoesNotReserve = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(fire(ResumeMissing1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedForeignScopeDoesNotReserve = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(fire(ResumeForeign1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedStoppedScopeDoesNotReserve = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(fire(ResumeStopped1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedCostCannotEnlargeBudget = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(fire(ResumeCostly1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedOldACKCannotEraseNewOwner = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(fire(Resume1)).then(fire(Capture1)).then(fire(OldAck1)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.first.floor==2 and s.first.records==0 and s.second.records==0))
 run SharedStoppedHistoricalNewLease = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(Hold2)).then(fire(Stop2)).then(fire(Present2)).then(fire(Close2)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.second.lease==2 and not(s.second.live) and s.second.floor==1 and s.first.records==0 and s.second.records==0))
 run SharedRepeatedLeaseDoesNotRePresent = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(PresentOld2)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.second.lease==1 and s.second.floor==1 and s.first.records==0 and s.second.records==0))
 run SharedForeignPresentationRejected = init.then(fire(Reserve1)).then(fire(Capture1)).then(fire(Reserve2)).then(fire(Capture2)).then(fire(PresentForeign2)).then(fire(Release2)).then(fire(Drain2)).then(fire(Ack2)).then(fire(Release1)).then(fire(Drain1)).then(fire(Ack1)).then(check(s.second.lease==1 and s.second.floor==1 and s.first.records==0 and s.second.records==0))
}
