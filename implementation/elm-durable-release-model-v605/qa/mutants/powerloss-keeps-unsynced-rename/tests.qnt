module tests {
 import release.* from "./release"
 run normalReleaseTest = init.then(establish).then(prepare).then(finish).then(fire(Ack)).then(fire(Explicit(2))).then(all {assert(s.effect and s.ack and not(reserved(s)) and allProps),fire(PowerLoss)})
 run preparedCrashStaysBlockedTest = init.then(establish).then(prepare).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(fire(Explicit(2))).then(all {assert(reserved(s) and not(s.ack) and not(s.effect) and allProps),fire(RestartRootSync).then(finish)}).then(fire(Ack)).then(all {assert(s.ack and allProps),fire(Explicit(2))})
 run unlinkBeforePrepareRefusedTest = init.then(fire(Unlink)).then(all {assert(s.file and allProps),fire(PowerLoss)})
 run ackBeforeFinalSyncRefusedTest = init.then(establish).then(prepare).then(fire(Unlink)).then(fire(SyncUnlinkDir)).then(fire(WriteReleased)).then(fire(Ack)).then(all {assert(not(s.ack) and reserved(s) and allProps),fire(SyncReleased)})
 run unlinkCrashRestoresExactReservationTest = init.then(establish).then(prepare).then(fire(Unlink)).then(fire(PowerLoss)).then(all {assert(s.file and s.durableFile and reserved(s) and allProps),fire(RestartRootSync).then(finish)})
 run durableUnlinkCrashStillBlockedTest = init.then(establish).then(prepare).then(fire(Unlink)).then(fire(SyncUnlinkDir)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(not(s.file) and reserved(s) and not(s.ack) and allProps),fire(WriteReleased)})
 run releasedCrashNeverResurrectsTest = init.then(establish).then(prepare).then(finish).then(fire(PowerLoss)).then(fire(RecreateOld)).then(all {assert(not(s.file) and not(s.durableFile) and allProps),fire(Ack)})
 run historyUnknownNotCommitTest = init.then(establish).then(prepare).then(finish).then(fire(Ack)).then(fire(Explicit(1))).then(all {assert(s.history.contains(1) and not(s.committed) and not(s.effect) and allProps),fire(PowerLoss)})
 run registeredProofRefusedTest = init.then(fire(Proof({kind:0,key:1,epoch:1,barrier:1}))).then(fire(RequestReads)).then(all {assert(not(s.proof) and not(s.reads) and allProps),fire(PowerLoss)})
 run foreignProofRefusedTest = init.then(fire(NativeRetire)).then(fire(Proof({kind:1,key:2,epoch:1,barrier:1}))).then(all {assert(not(s.proof) and allProps),fire(PowerLoss)})
 run staleProofRefusedTest = init.then(fire(NativeRetire)).then(fire(Proof({kind:1,key:1,epoch:0,barrier:1}))).then(fire(Proof({kind:1,key:1,epoch:1,barrier:0}))).then(all {assert(not(s.proof) and allProps),fire(PowerLoss)})
 run futureProofRefusedTest = init.then(fire(NativeRetire)).then(fire(Proof({kind:1,key:1,epoch:1,barrier:3}))).then(all {assert(not(s.proof) and allProps),fire(PowerLoss)})
 run oneReadCannotPrepareTest = init.then(fire(NativeRetire)).then(fire(Proof({kind:1,key:1,epoch:1,barrier:1}))).then(fire(RequestReads)).then(fire(Observe({kind:1,request:11,epoch:1,seq:2}))).then(fire(WriteProof)).then(all {assert(not(s.proofWritten) and allProps),fire(PowerLoss)})
 run crossedRequestsRefusedTest = init.then(fire(NativeRetire)).then(fire(Proof({kind:1,key:1,epoch:1,barrier:1}))).then(fire(RequestReads)).then(fire(Observe({kind:1,request:12,epoch:1,seq:2}))).then(fire(Observe({kind:2,request:11,epoch:1,seq:2}))).then(all {assert(not(s.actionRead) and not(s.geometry) and allProps),fire(PowerLoss)})
 run staleObservationRefusedTest = init.then(fire(NativeRetire)).then(fire(Proof({kind:1,key:1,epoch:1,barrier:1}))).then(fire(RequestReads)).then(fire(Observe({kind:2,request:12,epoch:1,seq:1}))).then(all {assert(not(s.geometry) and allProps),fire(PowerLoss)})
 run historyFullBlocksNewTest = init.then(establish).then(prepare).then(finish).then(fire(Ack)).then(fire(Remember(2))).then(fire(Explicit(2))).then(all {assert(not(s.effect) and s.history.size()==2 and allProps),fire(PowerLoss)})
 run releasedStageCannotRegressTest = init.then(establish).then(prepare).then(finish).then(fire(Ack)).then(fire(Explicit(2))).then(fire(SyncPreparedDir)).then(all {assert(s.stage==2 and allProps),fire(PowerLoss)})
 run futureObservationRefusedTest = init.then(fire(NativeRetire)).then(fire(Proof({kind:1,key:1,epoch:1,barrier:1}))).then(fire(RequestReads)).then(fire(Observe({kind:1,request:11,epoch:1,seq:3}))).then(all {assert(not(s.actionRead) and allProps),fire(PowerLoss)})
 run boundedHistoryNoOverwriteTest = init.then(fire(Remember(2))).then(fire(Remember(3))).then(all {assert(s.history==Set(1,2) and allProps),fire(PowerLoss)})

 run crashAfterWriteProofTest = init.then(establish).then(fire(WriteProof)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==0 and s.file==true and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterSyncProofTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==0 and s.file==true and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterSyncProofDirTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==0 and s.file==true and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterWritePreparedTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==0 and s.file==true and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterSyncPreparedTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(SyncPrepared)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==0 and s.file==true and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterSyncPreparedDirTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(SyncPrepared)).then(fire(RenamePrepared)).then(fire(SyncPreparedDir)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==1 and s.file==true and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterUnlinkTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(SyncPrepared)).then(fire(RenamePrepared)).then(fire(SyncPreparedDir)).then(fire(Unlink)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==1 and s.file==true and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterSyncUnlinkDirTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(SyncPrepared)).then(fire(RenamePrepared)).then(fire(SyncPreparedDir)).then(fire(Unlink)).then(fire(SyncUnlinkDir)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==1 and s.file==false and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterWriteReleasedTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(SyncPrepared)).then(fire(RenamePrepared)).then(fire(SyncPreparedDir)).then(fire(Unlink)).then(fire(SyncUnlinkDir)).then(fire(WriteReleased)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==1 and s.file==false and s.ack==false and allProps),fire(Explicit(1))})
 run crashAfterSyncReleasedTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(SyncPrepared)).then(fire(RenamePrepared)).then(fire(SyncPreparedDir)).then(fire(Unlink)).then(fire(SyncUnlinkDir)).then(fire(WriteReleased)).then(fire(SyncReleasedFile)).then(fire(RenameReleased)).then(fire(SyncReleased)).then(fire(PowerLoss)).then(fire(RestartRootSync)).then(fire(Ack)).then(all {assert(s.stage==2 and s.file==false and s.ack==true and allProps),fire(Explicit(1))})
 run oldReadAfterCrashRefusedTest = init.then(establish).then(fire(PowerLoss)).then(fire(Proof({kind:1,key:1,epoch:1,barrier:1}))).then(fire(RequestReads)).then(fire(Observe({kind:1,request:11,epoch:1,seq:2}))).then(all {assert(not(s.actionRead) and s.frontendEpoch==2 and allProps),fire(PowerLoss)})
 run epochExhaustionRefusesReadsTest = init.then(fire(NativeRetire)).then(fire(PowerLoss)).then(fire(PowerLoss)).then(fire(PowerLoss)).then(fire(Proof({kind:1,key:1,epoch:1,barrier:1}))).then(fire(RequestReads)).then(all {assert(s.frontendEpoch==4 and not(s.reads) and allProps),fire(PowerLoss)})

 run visiblePreparedRestartNeedsRootSyncTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(SyncPrepared)).then(fire(RenamePrepared)).then(fire(Crash)).then(fire(Unlink)).then(all {assert(s.visibleStage==1 and s.stage==0 and s.file and not(s.rootReady) and allProps),fire(RestartRootSync)}).then(fire(Unlink)).then(all {assert(s.stage==1 and not(s.file) and s.rootReady and allProps),fire(SyncUnlinkDir)})
 run visibleReleasedRestartNeedsRootSyncTest = init.then(establish).then(prepare).then(fire(Unlink)).then(fire(SyncUnlinkDir)).then(fire(WriteReleased)).then(fire(SyncReleasedFile)).then(fire(RenameReleased)).then(fire(Crash)).then(fire(Ack)).then(fire(Explicit(2))).then(all {assert(s.visibleStage==2 and s.stage==1 and not(s.ack) and not(s.effect) and not(s.rootReady) and allProps),fire(RestartRootSync)}).then(fire(Ack)).then(fire(Explicit(2))).then(all {assert(s.stage==2 and s.ack and s.effect and allProps),fire(Crash)})
 run durableReleasedRestartNeedsBarrierTest = init.then(establish).then(prepare).then(finish).then(fire(Crash)).then(fire(Ack)).then(all {assert(not(s.ack) and not(s.rootReady) and allProps),fire(RestartRootSync)}).then(fire(Ack)).then(all {assert(s.ack and allProps),fire(Crash)})
 run preparedRenameLostOnPowerLossTest = init.then(establish).then(fire(WriteProof)).then(fire(SyncProof)).then(fire(SyncProofDir)).then(fire(WritePrepared)).then(fire(SyncPrepared)).then(fire(RenamePrepared)).then(fire(PowerLoss)).then(all {assert(s.stage==0 and s.visibleStage==0 and s.file and allProps),fire(RestartRootSync)})
 run releasedRenameLostOnPowerLossTest = init.then(establish).then(prepare).then(fire(Unlink)).then(fire(SyncUnlinkDir)).then(fire(WriteReleased)).then(fire(SyncReleasedFile)).then(fire(RenameReleased)).then(fire(PowerLoss)).then(all {assert(s.stage==1 and s.visibleStage==1 and not(s.file) and reserved(s) and allProps),fire(RestartRootSync)})
}
