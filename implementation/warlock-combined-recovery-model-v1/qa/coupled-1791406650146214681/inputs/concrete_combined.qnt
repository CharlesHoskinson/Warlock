module concrete_combined {
 import combined_recovery.* from "./combined_recovery"
 action check(ok:bool):bool=all{assert(ok and safety),s'=s}
 run actualCapturedReader=init.then(check(s.reader and not(s.admitted)))
 run actualClosingReader=init.then(fire(ClosePreview)).then(check(s.reader and s.closing and not(s.closed)))
 run actualPendingNativeCommit=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(check(s.admitted and s.nativeWindowCommitted and not(s.oldUnknown)))
 run actualWindowUnknown=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(check(s.oldUnknown and s.historyUnknown and s.reader))
 run actualRendererFailureBlockedRecovery=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(check(s.rendererFailed and s.reader and not(s.recovery)))
 run actualReaderClose=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(check(not(s.reader or s.closed)))
 run actualStrictNativeClose=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(fire(NativeStrictClose)).then(check(s.closed and s.oldUnknown and not(s.recovery)))
 run actualGTKRecovery=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(fire(NativeStrictClose)).then(fire(Recovery)).then(check(s.recovery and s.closed and s.oldUnknown))
 run actualExplicitRestart=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(fire(NativeStrictClose)).then(fire(Recovery)).then(fire(Restart)).then(check(s.host==2 and s.lifetime==1 and s.oldUnknown))
 run actualFreshCoherentUnknown=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(fire(NativeStrictClose)).then(fire(Recovery)).then(fire(Restart)).then(fire(Scene)).then(check(s.scene and s.oldUnknown and s.replays==0))
 run actualHistoricalUnknownAfterRetirement=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(fire(NativeStrictClose)).then(fire(Recovery)).then(fire(Restart)).then(fire(Scene)).then(fire(WindowBindingRetired)).then(fire(ReleaseReservation)).then(check(s.reservationReleased and s.historyUnknown and s.oldUnknown))
 run actualExplicitAdvancedCommand=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(fire(NativeStrictClose)).then(fire(Recovery)).then(fire(Restart)).then(fire(Scene)).then(fire(WindowBindingRetired)).then(fire(ReleaseReservation)).then(fire(ExplicitNewCommand)).then(check(s.newCommand and s.request==2 and s.generation==2 and s.historyUnknown))
 run actualFreshOwnNativeCapture=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(fire(NativeStrictClose)).then(fire(Recovery)).then(fire(Restart)).then(fire(Scene)).then(fire(WindowBindingRetired)).then(fire(ReleaseReservation)).then(fire(ExplicitNewCommand)).then(fire(FreshCapture)).then(check(s.freshPreview and s.freshOwner==2 and s.lifetime==1 and s.historyUnknown))
 run actualFreshNativeClosePreservesHistory=init.then(fire(ClosePreview)).then(fire(AdmitWindow)).then(fire(NativeWindowCommit)).then(fire(LoseReceipt)).then(fire(RendererFailure)).then(fire(CloseReader)).then(fire(NativeStrictClose)).then(fire(Recovery)).then(fire(Restart)).then(fire(Scene)).then(fire(WindowBindingRetired)).then(fire(ReleaseReservation)).then(fire(ExplicitNewCommand)).then(fire(FreshCapture)).then(fire(CloseFreshReader)).then(fire(FreshStrictClose)).then(check(s.freshClosed and not(s.freshReader) and s.historyUnknown))
}
