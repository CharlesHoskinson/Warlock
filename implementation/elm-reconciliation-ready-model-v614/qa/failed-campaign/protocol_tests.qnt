module protocol_tests {
 import protocol.* from "./protocol"
 import release.* from "./release"
 run freshReadyRelease64Test=start.then(ready).then(actionRead).then(geometryRead).then(durableRelease).then(send(ReleaseRecords(64))).then(all {assert(q.released==64 and q.releasedScopes==Set(1) and protocolProps),send(ReleaseRecords(1))}).then(all {assert(q.released==64),send(DeliverProof)})
 run queuedBeforeAnnouncementTest=start.then(send(EnqueueRead({id:1,kind:1,output:1}))).then(send(EnqueueRead({id:2,kind:2,output:1}))).then(ready).then(send(ProcessRead(1))).then(send(ProcessRead(2))).then(send(Reply(1))).then(send(Reply(2))).then(all {assert(q.ordinary==2 and not(joined(q)) and q.actionAccepted==0 and q.geometryAccepted==0 and protocolProps),send(ReleaseRecords(64))})
 run queuedAfterProofBeforeAckTest=start.then(send(Announce(1))).then(send(DeliverProof)).then(send(EnqueueRead({id:1,kind:1,output:1}))).then(send(EnqueueReady(GOOD))).then(send(ProcessReady(GOOD))).then(send(ProcessRead(1))).then(send(Reply(1))).then(all {assert(q.actionAccepted==0 and q.ordinary==1 and protocolProps),send(DeliverProof)})
 run ackEnqueuedNotProcessedTest=start.then(send(Announce(1))).then(send(DeliverProof)).then(send(EnqueueReady(GOOD))).then(actionRead).then(geometryRead).then(all {assert(not(q.ready) and q.actionAccepted==0 and q.geometryAccepted==0 and protocolProps),send(ProcessReady(GOOD))})
 run freshEnqueueBeforeAckProcessingTest=start.then(send(Announce(1))).then(send(DeliverProof)).then(send(EnqueueReady(GOOD))).then(send(EnqueueRead({id:1,kind:1,output:1}))).then(send(ProcessReady(GOOD))).then(send(ProcessRead(1))).then(send(Reply(1))).then(all {assert(q.actionAccepted==1 and protocolProps),send(DeliverProof)})
 run foreignReadyTest=start.then(send(Announce(1))).then(send(DeliverProof)).then(send(EnqueueReady({...GOOD,current:9}))).then(send(ProcessReady({...GOOD,current:9}))).then(all {assert(not(q.ready) and not(q.ackQueued) and protocolProps),send(DeliverProof)})
 run wrongProofReadyTest=start.then(send(Announce(1))).then(send(DeliverProof)).then(send(EnqueueReady({...GOOD,scope:2}))).then(send(ProcessReady({...GOOD,scope:2}))).then(all {assert(not(q.ready) and protocolProps),send(DeliverProof)})
 run wrongOldReadyTest=start.then(send(Announce(1))).then(send(DeliverProof)).then(send(EnqueueReady({...GOOD,old:9}))).then(send(ProcessReady({...GOOD,old:9}))).then(all {assert(not(q.ready) and protocolProps),send(DeliverProof)})
 run wrongVersionReadyTest=start.then(send(Announce(1))).then(send(DeliverProof)).then(send(EnqueueReady({...GOOD,version:2}))).then(send(ProcessReady({...GOOD,version:2}))).then(all {assert(not(q.ready) and protocolProps),send(DeliverProof)})
 run proofNotDeliveredReadyTest=start.then(send(Announce(1))).then(send(EnqueueReady(GOOD))).then(send(ProcessReady(GOOD))).then(all {assert(not(q.ready) and protocolProps),send(DeliverProof)})
 run duplicateReadyRetainsReadsTest=start.then(ready).then(actionRead).then(geometryRead).then(send(EnqueueReady(GOOD))).then(send(ProcessReady(GOOD))).then(send(Announce(1))).then(all {assert(joined(q) and q.actionAccepted==1 and q.geometryAccepted==2 and protocolProps),send(DeliverProof)})
 run nextScopeClearsAcceptedTest=start.then(ready).then(actionRead).then(geometryRead).then(send(Announce(2))).then(all {assert(q.active==2 and not(q.ready) and q.actionExpected==0 and q.geometryExpected==0 and q.actionAccepted==0 and q.geometryAccepted==0 and protocolProps),send(ProcessReady(GOOD))}).then(all {assert(not(q.ready)),send(DeliverProof)})
 run retryLatestActionInvalidatesTest=start.then(ready).then(actionRead).then(geometryRead).then(send(EnqueueRead({id:3,kind:1,output:1}))).then(send(ProcessRead(3))).then(send(Reply(1))).then(all {assert(q.actionExpected==3 and q.actionAccepted==0 and not(joined(q)) and protocolProps),send(Reply(3))}).then(all {assert(joined(q) and q.actionAccepted==3),send(DeliverProof)})
 run differentOutputBlocksTest=start.then(ready).then(actionRead).then(send(EnqueueRead({id:2,kind:2,output:2}))).then(send(ProcessRead(2))).then(send(Reply(2))).then(send(Durable(NativeRetire))).then(all {assert(not(joined(q)) and not(s.nativeRetired) and protocolProps),send(ReleaseRecords(64))})
 run separateDomainsRequiredTest=start.then(ready).then(actionRead).then(send(EnqueueRead({id:3,kind:1,output:1}))).then(send(ProcessRead(3))).then(send(Reply(3))).then(all {assert(q.geometryAccepted==0 and not(joined(q)) and protocolProps),send(ReleaseRecords(64))})
 run unannouncedScopeCannotReleaseTest=start.then(all {q'=q,establish}).then(all {q'=q,prepare}).then(all {q'=q,finish}).then(all {q'=q,fire(Ack)}).then(send(ReleaseRecords(1))).then(all {assert(q.released==0 and protocolProps),send(DeliverProof)})
 run finalFsyncBeforeProtocolReleaseTest=start.then(ready).then(actionRead).then(geometryRead).then(all {q'=q,establish}).then(all {q'=q,prepare}).then(all {q'=q,fire(Unlink).then(fire(SyncUnlinkDir)).then(fire(WriteReleased)).then(fire(SyncReleasedFile)).then(fire(RenameReleased))}).then(send(Durable(Ack))).then(send(ReleaseRecords(64))).then(all {assert(q.released==0 and not(s.ack) and protocolProps),send(Durable(SyncReleased))}).then(send(Durable(Ack))).then(send(ReleaseRecords(64))).then(all {assert(q.released==64 and protocolProps),send(DeliverProof)})
 run restartInvalidatesProtocolTest=start.then(ready).then(actionRead).then(geometryRead).then(send(Restart)).then(send(Reply(1))).then(send(Reply(2))).then(all {assert(not(joined(q)) and q.actionAccepted==0 and q.geometryAccepted==0 and not(s.rootReady) and protocolProps),send(DeliverProof)})
 run scopeCap16Test=start.then(send(Announce(16))).then(send(Announce(17))).then(all {assert(q.active==16 and q.announced==Set(16) and protocolProps),send(DeliverProof)})
}
