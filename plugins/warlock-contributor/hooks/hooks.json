{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT:-$GROK_PLUGIN_ROOT}/scripts/session_hook.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT:-$GROK_PLUGIN_ROOT}/scripts/session_hook.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
