module bounded_read_authority_test {
 import bounded_read_authority.* from "./bounded_read_authority"
 action check(b:bool):bool=all{assert(b),s'=s}
 action start=fire(Startup((binding,emptyTip,true)))
 action connected(i:int):bool=fire(Begin(i)).then(fire(Connect((i,true))))
 action closed(i:int):bool=connected(i).then(fire(Reply((i,true)))).then(fire(Close((i,true))))
 action confirm(i:int):bool=fire(Confirm((i,binding,emptyTip,emptyTip,true)))
 action finish(i:int):bool=closed(i).then(confirm(i)).then(fire(Consume(i)))
 action archiveOwn=fire(Plan((0,nextTip))).then(fire(FileDurable(true))).then(fire(Publish((binding,emptyTip,true)))).then(fire(Adopt))
 run freshActualConnectionRequiredTest=init.then(start).then(fire(Consume(0))).then(check(s.fault and not(s.bytesNow)))
 run ordinaryCurrentOwnerDataTest=init.then(start).then(finish(0)).then(check(s.bytesNow and allProps))
 run fullStartupRequiredTest=init.then(fire(Startup((binding,emptyTip,false)))).then(check(s.fault and not(s.bound)))
 run newLifetimeCannotUsePartialHistoryTest=init.then(start).then(fire(Crash)).then(fire(Startup(({...binding,owner:{...owner,pid:2,start:2,lease:2}},emptyTip,false)))).then(check(s.fault and not(s.bound)))
 run allOwnerValidReplacementsRefuseTest=init.then(start).then(all{nondet n=1.to(11).oneOf();fire(Observe(({...binding,owner:{...owner,pid:if(n==1)2 else 1,start:if(n==2)2 else 1,lease:if(n==3)2 else 1,root:if(n==4)2 else 1,lock:if(n==5)2 else 1,directory:if(n==6)2 else 1,session:if(n==7)2 else 1,socket:if(n==8)2 else 1,source:if(n==9)2 else 1,executable:if(n==10)2 else 1,generation:if(n==11)2 else 1}},emptyTip)))}).then(check(s.fault and not(s.bytesNow)))
 run allBindingFDValidReplacementsRefuseTest=init.then(start).then(all{nondet n=1.to(9).oneOf();fire(Observe(({...binding,fd:{...fd,number:if(n==1)8 else 7,device:if(n==2)2 else 1,inode:if(n==3)2 else 1,name:if(n==4)2 else 1,size:if(n==5)256 else 128,flags:if(n==6)4098 else 2,digest:if(n==7)2 else 1},lineage:if(n>=8)2 else 1},emptyTip)))}).then(check(s.fault))
 run oPathCannotBindTest=init.then(fire(Startup(({...binding,fd:{...fd,noOPath:false}},emptyTip,true)))).then(check(s.fault))
 run executableAnchorCannotBindTest=init.then(fire(Startup(({...binding,fd:{...fd,noExec:false}},emptyTip,true)))).then(check(s.fault))
 run incompleteSealsCannotBindTest=init.then(fire(Startup(({...binding,fd:{...fd,seals:15}},emptyTip,true)))).then(check(s.fault))
 run wrongDataRoleCannotBindTest=init.then(fire(Startup(({...binding,fd:{...fd,dataRole:false}},emptyTip,true)))).then(check(s.fault))
 run allTipValidReplacementsRefuseTest=init.then(start).then(all{nondet n=1.to(6).oneOf();fire(Observe((binding,{...emptyTip,epoch:if(n==1)1 else 0,fd:if(n==2){...fd,inode:2} else fd,digest:if(n==3)2 else 1,previous:if(n==4)1 else 0,publication:if(n>=5)2 else 1})))}).then(check(s.fault))
 run borrowedProofReplacementRefusesTest=init.then(start).then(closed(0)).then(fire(Confirm((0,binding,emptyTip,{...emptyTip,fd:{...fd,inode:2}},true)))).then(fire(Consume(0))).then(check(s.fault and not(s.bytesNow)))
 run badPeerAfterReplyNeverOverwritesFailureTest=init.then(start).then(closed(0)).then(fire(Connect((0,false)))).then(confirm(0)).then(fire(Consume(0))).then(check(not(s.bytesNow) and s.rows.get(0).failed))
 run partialThenValidReplyNeverOverwritesFailureTest=init.then(start).then(connected(0)).then(fire(Reply((0,false)))).then(fire(Reply((0,true)))).then(fire(Close((0,true)))).then(confirm(0)).then(fire(Consume(0))).then(check(not(s.bytesNow) and s.rows.get(0).failed))
 run connectionRefusalDoesNotPreventFreshIndependentQueryTest=init.then(start).then(connected(0)).then(fire(Reply((0,false)))).then(fire(Close((0,true)))).then(fire(Release(0))).then(finish(1)).then(check(s.bytesNow and s.rows.get(0).failed and allProps))
 run deadlineAndPostDiskFailureRefuseTest=init.then(start).then(closed(0)).then(fire(Confirm((0,binding,emptyTip,emptyTip,false)))).then(fire(Consume(0))).then(check(not(s.bytesNow) and s.rows.get(0).failed))
 run unpublishedRowCannotReclaimTest=init.then(start).then(connected(0)).then(fire(Reply((0,true)))).then(fire(Close((0,false)))).then(fire(Release(0))).then(fire(Plan((0,nextTip)))).then(check(s.fault and s.rows.keys().contains(0) and s.archived==0))
 run heldRowCannotReclaimTest=init.then(start).then(finish(0)).then(fire(Plan((0,nextTip)))).then(check(s.fault and s.archived==0))
 run pendingRowCannotReclaimTest=init.then(start).then(connected(0)).then(fire(Release(0))).then(fire(Plan((0,nextTip)))).then(check(s.fault and s.archived==0))
 run durableOwnAppendPreservesStableOwnerTest=init.then(start).then(finish(0)).then(fire(Release(0))).then(archiveOwn).then(check(s.latest==nextTip and s.binding==binding and s.archived==1 and s.rows.keys().size()==0 and allProps))
 run heldIndependentQuerySurvivesAuthenticatedAppendTest=init.then(start).then(finish(0)).then(fire(Release(0))).then(closed(1)).then(archiveOwn).then(fire(Confirm((1,binding,nextTip,emptyTip,true)))).then(fire(Consume(1))).then(check(s.bytesNow and s.rows.get(1).borrow==emptyTip and s.latest==nextTip and allProps))
 run noAdoptionBeforeFileDurabilityTest=init.then(start).then(finish(0)).then(fire(Release(0))).then(fire(Plan((0,nextTip)))).then(fire(Adopt)).then(check(s.fault and s.archived==0 and s.rows.keys().contains(0)))
 run noAdoptionBeforeJournalDurabilityTest=init.then(start).then(finish(0)).then(fire(Release(0))).then(fire(Plan((0,nextTip)))).then(fire(FileDurable(true))).then(fire(Adopt)).then(check(s.fault and s.archived==0))
 run failedPublicationRetainsRowsTest=init.then(start).then(finish(0)).then(fire(Release(0))).then(fire(Plan((0,nextTip)))).then(fire(FileDurable(true))).then(fire(Publish((binding,emptyTip,false)))).then(fire(Adopt)).then(check(s.fault and s.archived==0 and s.rows.keys().contains(0)))
 run changedOwnerDuringPublicationRefusesTest=init.then(start).then(finish(0)).then(fire(Release(0))).then(fire(Plan((0,nextTip)))).then(fire(FileDurable(true))).then(fire(Publish(({...binding,owner:{...owner,lease:2}},emptyTip,true)))).then(check(s.fault and not(s.tipPublished)))
 run changedPredecessorDuringPublicationRefusesTest=init.then(start).then(finish(0)).then(fire(Release(0))).then(fire(Plan((0,nextTip)))).then(fire(FileDurable(true))).then(fire(Publish((binding,nextTip,true)))).then(check(s.fault and s.archived==0))
 run workingSetBoundIndependentOfHistoryTest=init.then(start).then(all{s'={...s,archived:1000000000}}).then(finish(0)).then(check(s.bytesNow and s.queryWork<=capacity+2 and allProps))
 // Explicit PROPOSED boundary: fresh data is not a current all-history integrity claim.
 run olderAncestorDamageIsNotSilentlyClaimedCurrentTest=init.then(start).then(fire(AncestorChanged)).then(finish(0)).then(check(s.bytesNow and not(s.fullCurrent) and allProps))
 run fullAuditRejectsAnyOlderDamageTest=init.then(start).then(fire(AncestorChanged)).then(fire(FullAudit(true))).then(check(s.fault and not(s.bytesNow)))
 run restartRejectsAnyOlderDamageTest=init.then(start).then(fire(AncestorChanged)).then(fire(Crash)).then(fire(Startup((binding,emptyTip,true)))).then(check(s.fault and not(s.bound)))
 run sourceRefusalCannotBeClearedByGoodObservationTest=init.then(start).then(fire(Observe(({...binding,owner:{...owner,source:2}},emptyTip)))).then(fire(Observe((binding,emptyTip)))).then(finish(0)).then(check(s.fault and not(s.bytesNow)))
 run releaseAfterFaultCannotClaimCompletionTest=init.then(start).then(connected(0)).then(fire(Refuse)).then(fire(Release(0))).then(check(s.fault and not(s.rows.get(0).held) and not(s.rows.get(0).closed) and not(s.bytesNow)))
 run capacityCheckedBeforeNewConnectionTest=init.then(start).then(connected(0)).then(connected(1)).then(fire(Begin(2))).then(check(s.fault and s.rows.keys().size()==capacity and not(s.rows.keys().contains(2))))
 run previousBytesNeverSurviveLaterRefusalTest=init.then(start).then(finish(0)).then(fire(Refuse)).then(check(s.fault and not(s.bytesNow)))
 run dataAuthorityNeverWaivesNativeUncertaintyTest=init.then(start).then(finish(0)).then(check(s.nativeEffects==0 and allProps))
 run wrongFDReadRoleCannotBindTest=init.then(fire(Startup(({...binding,fd:{...fd,access:0,flags:0,role:2}},emptyTip,true)))).then(check(s.fault))
 run archiveFDCannotMasqueradeAsOwnerAnchorTest=init.then(fire(Startup(({...binding,fd:nextTip.fd},emptyTip,true)))).then(check(s.fault))
 run archiveNewTipCannotHaveWritableOwnerRoleTest=init.then(start).then(finish(0)).then(fire(Release(0))).then(fire(Plan((0,{...nextTip,fd:{...nextTip.fd,access:2,flags:2,role:1}})))).then(check(s.fault and s.archived==0))
}
