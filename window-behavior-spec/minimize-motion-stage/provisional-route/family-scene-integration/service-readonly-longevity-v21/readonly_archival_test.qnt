module readonly_archival_test {
 import readonly_archival.* from "./readonly_archival"
 action check(p:bool):bool=all{assert(p),s'=s}
 action register(id:int):bool=fire(Register({id:id,durable:true}))
 action finish(id:int):bool=fire(Close(id)).then(fire(Publish({id:id,durable:true}))).then(fire(Consume({id:id,current:true}))).then(fire(Release(id)))
 action one=register(1).then(finish(1))
 val plan={issuer:1,epoch:1,previous:0,digest:100,material:10,rows:Set(1),current:true}
 action prepared=one.then(fire(Prepare(plan)))
 action written=prepared.then(fire(WriteFile({same:true,durable:true,fileToken:10})))
 action published=written.then(fire(PublishTip({same:true,durable:true})))
 action rotated=published.then(fire(Reclaim({same:true})))
 run exactClosedPublishedUnreferencedRowRotatesTest=init.then(rotated).then(check(s.rows==Set() and s.archived==Set(1) and s.epoch==1 and allProps))
 run capacityReusesStorageWithoutDroppingPendingTest=init.then(one).then(register(2)).then(finish(2)).then(register(3)).then(fire(Prepare({...plan,rows:Set(1,2)}))).then(fire(WriteFile({same:true,durable:true,fileToken:10}))).then(fire(PublishTip({same:true,durable:true}))).then(fire(Reclaim({same:true}))).then(register(4)).then(check(s.rows==Set(3,4) and s.archived==Set(1,2) and s.held==Set(3,4) and s.connections==4 and allProps))
 run pendingRowCannotBeArchivedTest=init.then(register(1)).then(fire(Prepare(plan))).then(check(s.fault and s.diskRows==Set(1) and s.diskArchived==Set()))
 run closedUnpublishedRowCannotBeArchivedTest=init.then(register(1)).then(fire(Close(1))).then(fire(Prepare(plan))).then(check(s.fault and s.diskRows==Set(1)))
 run closedPublishedCurrentReferenceCannotBeArchivedTest=init.then(register(1)).then(fire(Close(1))).then(fire(Publish({id:1,durable:true}))).then(fire(Prepare(plan))).then(check(s.fault and s.diskRows==Set(1)))
 run failedRefusalPublicationCannotReclaimTest=init.then(register(1)).then(fire(Close(1))).then(fire(Publish({id:1,durable:false}))).then(fire(Release(1))).then(fire(Prepare(plan))).then(check(s.fault and s.diskRows==Set(1) and s.diskArchived==Set()))
 run genuineClosedRefusalMayBeRetainedInArchiveTest=init.then(register(1)).then(fire(Close(1))).then(fire(Publish({id:1,durable:true}))).then(fire(Release(1))).then(fire(Prepare(plan))).then(fire(WriteFile({same:true,durable:true,fileToken:10}))).then(fire(PublishTip({same:true,durable:true}))).then(fire(Reclaim({same:true}))).then(check(s.archived==Set(1) and s.consumed==Set() and allProps))
 run fileDurabilityFailureKeepsOldFullLedgerTest=init.then(prepared).then(fire(WriteFile({same:true,durable:false,fileToken:10}))).then(check(s.fault and s.diskRows==Set(1) and s.diskTip==0))
 run fileHashOrMetadataMismatchCannotPublishTest=init.then(prepared).then(fire(WriteFile({same:false,durable:true,fileToken:10}))).then(fire(PublishTip({same:true,durable:true}))).then(check(s.fault and s.diskRows==Set(1)))
 run tipDurabilityFailureKeepsOldLedgerTest=init.then(written).then(fire(PublishTip({same:true,durable:false}))).then(check(s.fault and s.diskRows==Set(1) and s.diskArchived==Set()))
 run staleTipTokenCannotReclaimTest=init.then(written).then(fire(PublishTip({same:false,durable:true}))).then(check(s.fault and s.diskEpoch==0))
 run wrongIssuerRefusesTest=init.then(one).then(fire(Prepare({...plan,issuer:2}))).then(check(s.fault))
 run reorderedEpochRefusesTest=init.then(one).then(fire(Prepare({...plan,epoch:2}))).then(check(s.fault))
 run wrongPreviousDigestRefusesTest=init.then(one).then(fire(Prepare({...plan,previous:7}))).then(check(s.fault))
 run zeroDigestRefusesTest=init.then(one).then(fire(Prepare({...plan,digest:0}))).then(check(s.fault))
 run changedCurrentOwnerRootSourceRefusesTest=init.then(one).then(fire(Prepare({...plan,current:false}))).then(check(s.fault))
 run stillValidRowMaterialReplacementRefusesTest=init.then(written).then(fire(ReplaceMaterial(11))).then(fire(PublishTip({same:true,durable:true}))).then(check(s.fault and s.diskRows==Set(1)))
 run stillValidFileIdentityReplacementRefusesTest=init.then(written).then(fire(ReplaceFile(11))).then(fire(PublishTip({same:true,durable:true}))).then(check(s.fault and s.diskRows==Set(1)))
 run fileReplacementAfterTipCannotReclaimTest=init.then(published).then(fire(ReplaceFile(11))).then(fire(Reclaim({same:true}))).then(check(s.fault and s.rows==Set(1)))
 run distinctConcurrentRegistrationIsPreservedTest=init.then(written).then(register(2)).then(fire(PublishTip({same:true,durable:true}))).then(fire(Reclaim({same:true}))).then(check(s.rows==Set(2) and s.diskRows==Set(2) and s.archived==Set(1) and allProps))
 run crashBeforeFileKeepsOldRowsTest=init.then(prepared).then(fire(Crash)).then(fire(Recover({chain:true,issuer:true,namespace:true}))).then(check(s.rows==Set(1) and s.archived==Set() and s.recovered and allProps))
 run crashAfterFileBeforeTipLeavesUnusableOrphanTest=init.then(written).then(fire(Crash)).then(fire(Recover({chain:true,issuer:true,namespace:true}))).then(check(s.rows==Set(1) and s.archived==Set() and s.diskTip==0 and not(s.consumeNow)))
 run crashAfterTipBeforeMemoryReclaimRestoresExactDiskTest=init.then(published).then(fire(Crash)).then(fire(Recover({chain:true,issuer:true,namespace:true}))).then(check(s.rows==Set() and s.archived==Set(1) and s.epoch==1 and allProps))
 run corruptRecoveryChainRefusesTest=init.then(published).then(fire(Crash)).then(fire(Recover({chain:false,issuer:true,namespace:true}))).then(check(s.fault and not(s.recovered)))
 run replacedRecoveryIssuerRefusesTest=init.then(published).then(fire(Crash)).then(fire(Recover({chain:true,issuer:false,namespace:true}))).then(check(s.fault and not(s.recovered)))
 run changedRecoveryNamespaceRefusesTest=init.then(published).then(fire(Crash)).then(fire(Recover({chain:true,issuer:true,namespace:false}))).then(check(s.fault and not(s.recovered)))
 run recoveredOldDatasetNeverReturnsBytesTest=init.then(published).then(fire(Crash)).then(fire(Recover({chain:true,issuer:true,namespace:true}))).then(fire(Consume({id:1,current:true}))).then(check(not(s.consumeNow) and s.nativeEffects==0))
 run archivedRowIDCannotBeReusedTest=init.then(rotated).then(register(1)).then(check(s.fault and s.connections==1 and s.diskArchived==Set(1)))
 run archiveDoesNotWaiveInitialConnectionDurabilityTest=init.then(fire(Register({id:1,durable:false}))).then(check(s.fault and s.connections==0))
 run refusalCannotBeClearedByLaterGoodArchiveStepsTest=init.then(prepared).then(fire(WriteFile({same:false,durable:true,fileToken:10}))).then(fire(WriteFile({same:true,durable:true,fileToken:10}))).then(fire(PublishTip({same:true,durable:true}))).then(fire(Reclaim({same:true}))).then(check(s.fault and s.diskRows==Set(1) and s.diskArchived==Set()))
 run everyStillValidAuthorityReplacementBeforePublicationRefusesTest=init.then(written).then(all{nondet selector=Set(1,2,3).oneOf();fire(ReplaceAuthority({issuer:if(selector==1)2 else 1,root:if(selector==2)2 else 1,source:if(selector==3)2 else 1}))}).then(fire(PublishTip({same:true,durable:true}))).then(check(s.fault and s.diskRows==Set(1)))
 run stillValidIssuerReplacementCannotReturnCurrentDataTest=init.then(register(1)).then(fire(Close(1))).then(fire(Publish({id:1,durable:true}))).then(fire(ReplaceAuthority({issuer:2,root:1,source:1}))).then(fire(Consume({id:1,current:true}))).then(check(s.fault and not(s.consumeNow)))
 run capacityWithoutEligibleRowsRefusesBeforeConnectionTest=init.then(register(1)).then(register(2)).then(register(3)).then(register(4)).then(check(s.fault and s.connections==3 and s.diskRows==Set(1,2,3)))

}
