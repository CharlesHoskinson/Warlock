module readonly_archival {
 type Plan={issuer:int,epoch:int,previous:int,digest:int,material:int,rows:Set[int],current:bool}
 type State={issuer:int,boundIssuer:int,rootToken:int,sourceToken:int,epoch:int,tip:int,serial:int,rows:Set[int],closed:Set[int],published:Set[int],held:Set[int],archived:Set[int],registered:Set[int],consumed:Set[int],candidate:Set[int],planIssuer:int,planEpoch:int,planPrevious:int,planDigest:int,planMaterial:int,currentMaterial:int,capturedFileToken:int,currentFileToken:int,fileDurable:bool,phase:int,diskRows:Set[int],diskArchived:Set[int],diskEpoch:int,diskTip:int,alive:bool,recovered:bool,fault:bool,consumeNow:bool,connections:int,nativeEffects:int}
 type Event=Register({id:int,durable:bool})|Close(int)|Publish({id:int,durable:bool})|Consume({id:int,current:bool})|Release(int)|Prepare(Plan)|WriteFile({same:bool,durable:bool,fileToken:int})|PublishTip({same:bool,durable:bool})|Reclaim({same:bool})|ReplaceAuthority({issuer:int,root:int,source:int})|ReplaceMaterial(int)|ReplaceFile(int)|Crash|Recover({chain:bool,issuer:bool,namespace:bool})|Refuse
 var s:State
 action init=s'={issuer:1,boundIssuer:1,rootToken:1,sourceToken:1,epoch:0,tip:0,serial:0,rows:Set(),closed:Set(),published:Set(),held:Set(),archived:Set(),registered:Set(),consumed:Set(),candidate:Set(),planIssuer:0,planEpoch:0,planPrevious:0,planDigest:0,planMaterial:0,currentMaterial:0,capturedFileToken:0,currentFileToken:0,fileDurable:false,phase:0,diskRows:Set(),diskArchived:Set(),diskEpoch:0,diskTip:0,alive:true,recovered:false,fault:false,consumeNow:false,connections:0,nativeEffects:0}
 pure def current(st:State):bool=st.issuer==st.boundIssuer and st.rootToken==1 and st.sourceToken==1
 pure def eligible(st:State):Set[int]=st.rows.intersect(st.closed).intersect(st.published).exclude(st.held)
 action fire(e:Event):bool={val b={...s,consumeNow:false};s'=match e {
 | Crash=>{...b,alive:false,held:Set(),phase:4,recovered:false}
 | Recover(p)=>if(not(s.alive) and p.chain and p.issuer and p.namespace){...b,rows:s.diskRows,archived:s.diskArchived,epoch:s.diskEpoch,tip:s.diskTip,held:Set(),candidate:Set(),phase:4,recovered:true} else {...b,fault:true,recovered:false}
 | ReplaceAuthority(p)=>{...b,issuer:p.issuer,rootToken:p.root,sourceToken:p.source}
 | ReplaceMaterial(n)=>{...b,currentMaterial:n}
 | ReplaceFile(n)=>{...b,currentFileToken:n}
 | Refuse=>{...b,fault:true}
 | Register(p)=>if(s.alive and not(s.fault) and current(s) and s.phase!=3 and s.rows.size()<3 and p.id==s.serial+1 and p.durable){...b,serial:p.id,rows:s.rows.union(Set(p.id)),held:s.held.union(Set(p.id)),registered:s.registered.union(Set(p.id)),diskRows:s.diskRows.union(Set(p.id)),connections:s.connections+1} else {...b,fault:true}
 | Close(id)=>if(s.alive and not(s.fault) and current(s) and s.rows.contains(id)){...b,closed:s.closed.union(Set(id))} else {...b,fault:true}
 | Publish(p)=>if(s.alive and not(s.fault) and current(s) and s.rows.contains(p.id) and s.closed.contains(p.id) and p.durable){...b,published:s.published.union(Set(p.id))} else {...b,fault:true}
 | Consume(p)=>if(s.alive and not(s.fault) and current(s) and s.phase!=3 and p.current and s.rows.contains(p.id) and s.closed.contains(p.id) and s.published.contains(p.id) and s.held.contains(p.id) and not(s.consumed.contains(p.id))){...b,consumed:s.consumed.union(Set(p.id)),consumeNow:true} else {...b,fault:true}
 | Release(id)=>if(s.alive and not(s.fault) and current(s) and s.rows.contains(id) and s.closed.contains(id) and s.published.contains(id)){...b,held:s.held.exclude(Set(id))} else {...b,fault:true}
 | Prepare(p)=>if(s.alive and not(s.fault) and current(s) and s.phase==0 and p.current and p.issuer==s.issuer and p.epoch==s.epoch+1 and p.previous==s.tip and p.digest>0 and p.material>0 and p.digest!=s.tip and p.rows.size()>0 and p.rows.subseteq(eligible(s))){...b,candidate:p.rows,planIssuer:p.issuer,planEpoch:p.epoch,planPrevious:p.previous,planDigest:p.digest,planMaterial:p.material,currentMaterial:p.material,fileDurable:false,phase:1} else {...b,fault:true}
 | WriteFile(p)=>if(s.alive and not(s.fault) and current(s) and s.phase==1 and p.same and p.durable and p.fileToken>0){...b,fileDurable:true,capturedFileToken:p.fileToken,currentFileToken:p.fileToken,phase:2} else {...b,fault:true}
 | PublishTip(p)=>if(s.alive and not(s.fault) and current(s) and s.phase==2 and s.fileDurable and p.same and p.durable and s.planMaterial==s.currentMaterial and s.capturedFileToken==s.currentFileToken and s.planIssuer==s.issuer and s.planEpoch==s.epoch+1 and s.planPrevious==s.tip and s.candidate.subseteq(eligible(s))){...b,diskRows:s.rows.exclude(s.candidate),diskArchived:s.archived.union(s.candidate),diskEpoch:s.planEpoch,diskTip:s.planDigest,phase:3} else {...b,fault:true}
 | Reclaim(p)=>if(s.alive and not(s.fault) and current(s) and s.phase==3 and p.same and s.capturedFileToken==s.currentFileToken){...b,rows:s.diskRows,archived:s.diskArchived,epoch:s.diskEpoch,tip:s.diskTip,candidate:Set(),phase:0,fileDurable:false} else {...b,fault:true}
 }}
 val allProps=s.diskRows.union(s.diskArchived)==s.registered and s.diskRows.intersect(s.diskArchived).size()==0 and s.archived.subseteq(s.closed.intersect(s.published)) and s.diskArchived.subseteq(s.closed.intersect(s.published)) and s.archived.intersect(s.held).size()==0 and s.diskArchived.intersect(s.held).size()==0 and (s.consumeNow implies(s.alive and not(s.fault) and current(s) and not(s.recovered))) and s.nativeEffects==0
 action step={nondet id=Set(1,2,3,4).oneOf();nondet yes=Set(true,false).oneOf();nondet event=Set(Register({id:id,durable:yes}),Close(id),Publish({id:id,durable:yes}),Consume({id:id,current:yes}),Release(id),Prepare({issuer:1,epoch:s.epoch+1,previous:s.tip,digest:id,material:10,rows:Set(id),current:yes}),WriteFile({same:yes,durable:yes,fileToken:10}),PublishTip({same:yes,durable:yes}),Reclaim({same:yes}),ReplaceAuthority({issuer:id,root:1,source:1}),ReplaceMaterial(id),ReplaceFile(id),Crash,Recover({chain:yes,issuer:yes,namespace:yes}),Refuse).oneOf();fire(event)}
}
