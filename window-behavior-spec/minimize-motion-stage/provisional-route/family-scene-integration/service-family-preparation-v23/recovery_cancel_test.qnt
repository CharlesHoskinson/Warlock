module recovery_cancel_test {
 import recovery_cancel.* from "./recovery_cancel"
 action check(p:bool):bool=all{assert(p),s'=s}
 action ready=fire(Acquire).then(fire(Terminal({helpers:true,renderer:true,uncertain:false}))).then(fire(RetirePersist)).then(fire(Observe({complete:true,stable:true,compatible:false})))
 action acknowledged=ready.then(fire(Acknowledge))
 run exactCancellationIsDurableNonSettlementTest=init.then(acknowledged).then(check(s.cancelled and s.durable and s.directory and not(s.write)))
 run sourceCannotDisposeBeforeAcknowledgmentTest=init.then(ready).then(fire(Dispose)).then(check(s.directory and not(s.disposed)))
 run durableCancellationCanDisposeAndExposeTest=init.then(acknowledged).then(fire(Dispose)).then(fire(Expose)).then(check(s.exposed and not(s.directory) and allProps))
 run cancellationNeverWritesSurvivorOrReplacementTest=init.then(acknowledged).then(fire(Write)).then(check(not(s.write)))
 run sourceRemainsOnDurabilityFailureTest=init.then(ready).then(fire(DurabilityFail)).then(fire(Acknowledge)).then(fire(Dispose)).then(check(s.directory and not(s.cancelled)))
 run incompleteObservationCannotCancelTest=init.then(ready).then(fire(Observe({complete:false,stable:true,compatible:false}))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run unstableObservationCannotCancelTest=init.then(ready).then(fire(Observe({complete:true,stable:false,compatible:false}))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run compatibleFamilyDoesNotCancelTest=init.then(ready).then(fire(Observe({complete:true,stable:true,compatible:true}))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run uncertainNativeEffectCannotCancelTest=init.then(ready).then(fire(Terminal({helpers:true,renderer:true,uncertain:true}))).then(fire(Observe({complete:true,stable:true,compatible:false}))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run emptyGroupsWithoutHelperProofCannotCancelTest=init.then(ready).then(fire(Terminal({helpers:false,renderer:true,uncertain:false}))).then(fire(Observe({complete:true,stable:true,compatible:false}))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run liveRendererCannotCancelTest=init.then(ready).then(fire(Terminal({helpers:true,renderer:false,uncertain:false}))).then(fire(Observe({complete:true,stable:true,compatible:false}))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run replacedRootRevokesPartialProofTest=init.then(ready).then(fire(Replace(0))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run replacedLockRevokesPartialProofTest=init.then(ready).then(fire(Replace(1))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run changedSessionRevokesPartialProofTest=init.then(ready).then(fire(Replace(2))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run changedOwnerNonceRevokesPartialProofTest=init.then(ready).then(fire(Replace(3))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run changedMemberLifetimeRevokesPartialProofTest=init.then(ready).then(fire(Replace(4))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run changedReceiptRevokesPartialProofTest=init.then(ready).then(fire(Replace(5))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run changedObservationRevokesPartialProofTest=init.then(ready).then(fire(Replace(6))).then(fire(Acknowledge)).then(check(not(s.cancelled)))
 run restartCannotDisposeUsingOldProofTest=init.then(acknowledged).then(fire(Crash)).then(fire(Reload)).then(fire(Dispose)).then(check(s.directory))
 run restartCannotExposeUsingOldProofTest=init.then(acknowledged).then(fire(Dispose)).then(fire(Crash)).then(fire(Reload)).then(fire(Expose)).then(check(not(s.exposed)))
 run freshRestartMayFinishAcknowledgedCancellationTest=init.then(acknowledged).then(fire(Crash)).then(fire(Reload)).then(ready).then(fire(Dispose)).then(fire(Expose)).then(check(s.exposed and allProps))
 run cancellationRemainsWhenObstructionDisappearsTest=init.then(acknowledged).then(fire(Crash)).then(fire(Reload)).then(ready).then(fire(Observe({complete:true,stable:true,compatible:true}))).then(fire(Write)).then(fire(Dispose)).then(check(s.cancelled and not(s.write) and not(s.directory)))
 run replacementRootCannotResumeAcknowledgedIntentTest=init.then(acknowledged).then(fire(Replace(0))).then(ready).then(fire(Dispose)).then(fire(Expose)).then(check(s.directory and not(s.exposed)))
 run replacementLockCannotResumeAcknowledgedIntentTest=init.then(acknowledged).then(fire(Replace(1))).then(ready).then(fire(Dispose)).then(fire(Expose)).then(check(s.directory and not(s.exposed)))
 run replacementSessionCannotResumeAcknowledgedIntentTest=init.then(acknowledged).then(fire(Replace(2))).then(ready).then(fire(Dispose)).then(fire(Expose)).then(check(s.directory and not(s.exposed)))
 run replacementMemberLifetimeCannotResumeAcknowledgedIntentTest=init.then(acknowledged).then(fire(Replace(4))).then(ready).then(fire(Dispose)).then(fire(Expose)).then(check(s.directory and not(s.exposed)))
 run replacementReceiptCannotResumeAcknowledgedIntentTest=init.then(acknowledged).then(fire(Replace(5))).then(ready).then(fire(Dispose)).then(fire(Expose)).then(check(s.directory and not(s.exposed)))
 run uncertaintyCannotBeClearedByLaterGroupClosureTest=init.then(ready).then(fire(Terminal({helpers:true,renderer:true,uncertain:true}))).then(fire(Terminal({helpers:true,renderer:true,uncertain:false}))).then(fire(Observe({complete:true,stable:true,compatible:false}))).then(fire(Acknowledge)).then(check(s.uncertain and not(s.cancelled)))
 run failedDurableRetirementCannotAcknowledgeTest=init.then(fire(Acquire)).then(fire(Terminal({helpers:true,renderer:true,uncertain:false}))).then(fire(RetirePersistFail)).then(fire(Observe({complete:true,stable:true,compatible:false}))).then(fire(Acknowledge)).then(check(not(s.cancelled) and s.directory))
}
