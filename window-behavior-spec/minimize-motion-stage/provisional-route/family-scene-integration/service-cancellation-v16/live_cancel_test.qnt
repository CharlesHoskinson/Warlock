module live_cancel_test {
 import live_cancel.* from "./live_cancel"
 action check(p:bool):bool=all{assert(p),s'=s}
 action reserve=fire(Reserve({request:s.current,explicit:true,peer:true,durable:true}))
 action retire=fire(Retire({normal:true,callbacks:true,durable:true}))
 action proof=fire(Attest({binding:s.current,allJobs:true,authenticated:true})).then(fire(Observe({binding:s.current,complete:true,stable:true})))
 action lease=fire(LeaseProof({binding:s.current,held:true,authenticated:true}))
 action ready=reserve.then(retire).then(proof)
 run exactExplicitReservationAllowsDurableNonSettlementTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Dispose)).then(fire(Expose)).then(check(s.exposed and allProps))
 run ordinaryRendererCallbackCannotInventUserIntentTest=init.then(fire(Reserve({request:s.current,explicit:false,peer:true,durable:true}))).then(check(not(s.reserved)))
 run unauthenticatedPeerCannotReserveTest=init.then(fire(Reserve({request:s.current,explicit:true,peer:false,durable:true}))).then(check(not(s.reserved)))
 run failedReservationFsyncCannotClaimCancellationTest=init.then(fire(Reserve({request:s.current,explicit:true,peer:true,durable:false}))).then(check(not(s.reserved)))
 run explicitReservationRevokesLatePreparationTest=init.then(reserve).then(fire(Promote)).then(check(not(s.promoted)))
 run explicitReservationNeverWritesSurvivorTest=init.then(fire(Promote)).then(reserve).then(fire(NativeWrite)).then(check(not(s.write)))
 run otherActorContinuesDuringCancellationTest=init.then(reserve).then(fire(OtherActor)).then(check(s.otherSteps==1 and s.otherRunning))
 run abnormalRendererClosureCannotAcknowledgeTest=init.then(reserve).then(fire(Retire({normal:false,callbacks:true,durable:true}))).then(proof).then(fire(Acknowledge(true))).then(check(not(s.ack)))
 run undrainedCallbackCannotAcknowledgeTest=init.then(reserve).then(fire(Retire({normal:true,callbacks:false,durable:true}))).then(proof).then(fire(Acknowledge(true))).then(check(not(s.ack)))
 run failedRetirementFsyncCannotAcknowledgeTest=init.then(reserve).then(fire(Retire({normal:true,callbacks:true,durable:false}))).then(proof).then(fire(Acknowledge(true))).then(check(not(s.ack)))
 run incompleteJobAttestationCannotAcknowledgeTest=init.then(reserve).then(retire).then(fire(Attest({binding:s.current,allJobs:false,authenticated:true}))).then(fire(Observe({binding:s.current,complete:true,stable:true}))).then(fire(Acknowledge(true))).then(check(not(s.ack)))
 run selfReportedJobClosureCannotAcknowledgeTest=init.then(reserve).then(retire).then(fire(Attest({binding:s.current,allJobs:true,authenticated:false}))).then(fire(Observe({binding:s.current,complete:true,stable:true}))).then(fire(Acknowledge(true))).then(check(not(s.ack)))
 run unstableNativeContextCannotAcknowledgeTest=init.then(reserve).then(retire).then(fire(Attest({binding:s.current,allJobs:true,authenticated:true}))).then(fire(Observe({binding:s.current,complete:true,stable:false}))).then(fire(Acknowledge(true))).then(check(not(s.ack)))
 run failedOutcomeFsyncRetainsSourcesTest=init.then(ready).then(fire(Acknowledge(false))).then(fire(Dispose)).then(check(s.directory))
 run uncertainNativeCallNeverClearsViaNormalClosureTest=init.then(reserve).then(fire(NativeUncertain)).then(retire).then(proof).then(fire(Acknowledge(true))).then(check(s.uncertain and not(s.ack)))
 run changedReceiptCannotResumeOldCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Replace(5))).then(retire).then(proof).then(fire(Dispose)).then(check(s.directory))
 run changedScopeCannotResumeOldCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Replace(7))).then(retire).then(proof).then(fire(Dispose)).then(check(s.directory))
 run changedActorCannotResumeOldCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Replace(4))).then(retire).then(proof).then(fire(Dispose)).then(check(s.directory))
 run changedResourceCannotResumeOldCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Replace(9))).then(retire).then(proof).then(fire(Dispose)).then(check(s.directory))
 run staleKeeperAttestationRevokesPartialProofTest=init.then(ready).then(fire(Replace(8))).then(fire(Acknowledge(true))).then(check(not(s.ack)))
 run restartCannotExposeUsingPartialLiveProofTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Crash)).then(fire(Reload)).then(fire(Dispose)).then(check(s.directory))
 run freshRestartCanFinishOriginalCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Crash)).then(fire(Reload)).then(lease).then(retire).then(proof).then(fire(Dispose)).then(fire(Expose)).then(check(s.exposed and allProps))
 run cancelledReceiptCannotFallbackSettleOnReductionTest=init.then(fire(Promote)).then(reserve).then(fire(Reduce(true))).then(fire(ReturnedEndpoint)).then(check(not(s.endpointReturned)))
 run ordinaryValidatedReductionRetainsEndpointSemanticsTest=init.then(fire(Promote)).then(fire(Reduce(true))).then(fire(ReturnedEndpoint)).then(check(s.endpointReturned and not(s.reserved)))
 run unvalidatedReductionHasNoEndpointAuthorityTest=init.then(fire(Reduce(true))).then(fire(ReturnedEndpoint)).then(check(not(s.endpointReturned)))
 run changedRootCannotReauthenticateOldCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Replace(0))).then(lease).then(retire).then(proof).then(fire(Dispose)).then(check(s.directory))
 run changedLockCannotReauthenticateOldCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Replace(1))).then(lease).then(retire).then(proof).then(fire(Dispose)).then(check(s.directory))
 run changedSessionCannotReauthenticateOldCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Replace(2))).then(lease).then(retire).then(proof).then(fire(Dispose)).then(check(s.directory))
 run changedTokenCannotReauthenticateOldCancellationTest=init.then(ready).then(fire(Acknowledge(true))).then(fire(Replace(6))).then(lease).then(retire).then(proof).then(fire(Dispose)).then(check(s.directory))
 run lostKernelLeaseExclusionCannotAcknowledgeTest=init.then(ready).then(fire(LeaseProof({binding:s.current,held:false,authenticated:true}))).then(fire(Acknowledge(true))).then(check(not(s.ack)))
 run selfReportedLeaseIsNotCurrentAuthorityTest=init.then(ready).then(fire(LeaseProof({binding:s.current,held:true,authenticated:false}))).then(fire(Acknowledge(true))).then(check(not(s.ack)))
}
