module actor_ledger_test {
 import actor_ledger.* from "./actor_ledger"
 action check(p:bool):bool=all{assert(p),s'=s}
 action reg(j:Job):bool=fire(Register({job:j,observed:true,durable:true}))
 action done(id:int):bool=fire(Gone(id)).then(fire(Complete({id:id,durable:true})))
 action freeze=fire(Freeze({intent:intent,authenticated:true,current:true,durable:true}))
 action attest=fire(Observe).then(fire(Attest({intent:intent,authenticated:true,inventory:true})))
 action returned=fire(Returned({id:2,source:2,lifetime:2,result:1,durable:true}))
 action closedScenario=init.then(reg(renderer)).then(done(1)).then(freeze)
 run actualClosedFrozenActorMayAttestTest=closedScenario.then(attest).then(check(s.attested and allProps))
 run historicalNativeUnknownIsNotAnEmptyLedgerTest=init.then(reg(native)).then(done(2)).then(freeze).then(attest).then(check(not(s.attested)))
 run semanticDurableReturnAndPhysicalClosureBothRequiredTest=init.then(reg(native)).then(returned).then(freeze).then(attest).then(check(not(s.attested))).then(done(2)).then(attest).then(check(s.attested))
 run exactSourceReplacementCannotBorrowReturnTest=init.then(reg(native)).then(done(2)).then(fire(Returned({id:2,source:3,lifetime:2,result:1,durable:true}))).then(freeze).then(attest).then(check(not(s.attested)))
 run exactLifetimeReplacementCannotBorrowReturnTest=init.then(reg(native)).then(done(2)).then(fire(Returned({id:2,source:2,lifetime:3,result:1,durable:true}))).then(freeze).then(attest).then(check(not(s.attested)))
 run uncertaintyCannotBeClearedByLaterReturnedSuccessTest=init.then(reg(native)).then(fire(Uncertain(2))).then(done(2)).then(returned).then(freeze).then(attest).then(check(s.uncertain.contains(2) and not(s.attested)))
 run failedRegistrationPersistenceKeepsGateClosedTest=init.then(fire(Register({job:renderer,observed:true,durable:false}))).then(fire(Release({id:1,durable:true}))).then(check(s.fault and not(s.released.contains(1))))
 run failedReleasePersistenceKeepsGateClosedTest=init.then(reg(renderer)).then(fire(Release({id:1,durable:false}))).then(check(s.fault and not(s.released.contains(1))))
 run failedCompletionPersistenceRefusesAttestationTest=init.then(reg(renderer)).then(fire(Gone(1))).then(fire(Complete({id:1,durable:false}))).then(freeze).then(attest).then(check(s.fault and not(s.attested)))
 run failedSemanticPersistenceLatchesFaultTest=init.then(reg(native)).then(done(2)).then(fire(Returned({id:2,source:2,lifetime:2,result:1,durable:false}))).then(freeze).then(attest).then(check(s.fault and not(s.attested)))
 run failedFreezePersistenceRefusesAttestationTest=closedScenario.then(fire(FailPersistence)).then(attest).then(check(not(s.attested)))
 run unobservedSourceNeverRegistersTest=init.then(fire(Register({job:renderer,observed:false,durable:true}))).then(check(s.jobs.size()==0))
 run unauthenticatedFreezeCannotReserveActorTest=init.then(fire(Freeze({intent:intent,authenticated:false,current:true,durable:true}))).then(check(not(s.frozen)))
 run staleCurrentReceiptCannotFreezeTest=init.then(fire(Freeze({intent:intent,authenticated:true,current:false,durable:true}))).then(check(not(s.frozen)))
 run freezeBlocksNewActorJobBeforeGateTest=closedScenario.then(reg(native)).then(fire(Release({id:2,durable:true}))).then(check(not(s.jobs.contains(native)) and not(s.released.contains(2))))
 run freezeBlocksPreviouslyRegisteredUnreleasedActorJobTest=init.then(reg(renderer)).then(freeze).then(fire(Release({id:1,durable:true}))).then(check(not(s.released.contains(1))))
 run otherActorKeepsRunningWithoutWholeKeeperStopTest=closedScenario.then(reg(other)).then(fire(Release({id:3,durable:true}))).then(attest).then(check(s.attested and s.active.contains(3) and s.released.contains(3)))
 run completedHistoryNeverDisappearsTest=closedScenario.then(attest).then(check(s.jobs.contains(renderer) and s.complete.contains(1)))
 run droppedHistoryLatchesQuarantineTest=closedScenario.then(fire(DropHistory)).then(attest).then(check(s.fault and not(s.attested)))
 run crashedKeeperCannotAttestFromStaleProofTest=closedScenario.then(fire(Observe)).then(fire(Crash)).then(fire(Attest({intent:intent,authenticated:true,inventory:true}))).then(check(not(s.attested)))
 run everyIssuerIdentityReplacementInvalidatesTest=closedScenario.then(fire(Observe)).then(all{nondet n=0.to(5).oneOf();fire(ReplaceIssuer(n))}).then(fire(Attest({intent:intent,authenticated:true,inventory:true}))).then(check(not(s.attested)))
 run currentIntentReplacementInvalidatesTest=closedScenario.then(fire(Observe)).then(fire(ReplaceIntent)).then(fire(Attest({intent:intent,authenticated:true,inventory:true}))).then(check(not(s.attested)))
 run unauthenticatedReplyCannotAttestTest=closedScenario.then(fire(Observe)).then(fire(Attest({intent:intent,authenticated:false,inventory:true}))).then(check(not(s.attested)))
 run inventoryMismatchCannotAttestTest=closedScenario.then(fire(Observe)).then(fire(Attest({intent:intent,authenticated:true,inventory:false}))).then(check(not(s.attested)))
 run oldJobIdentityCannotBeReusedTest=closedScenario.then(reg({...renderer,source:2,lifetime:2})).then(check(s.jobs==Set(renderer)))
}
