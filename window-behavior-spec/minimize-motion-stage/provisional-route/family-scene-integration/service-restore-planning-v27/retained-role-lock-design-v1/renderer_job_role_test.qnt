module renderer_job_role_test {
 import renderer_job_role.* from "./renderer_job_role"
 action check(v:bool):bool=all{assert(v),s'=s}
 action native=fire(Bind(good)).then(fire(Jobs(Set(renderer))))
 action accept=fire(Check).then(check(s.permitted))
 action refuse=fire(Check).then(check(not(s.permitted)))
 run genuinePersistentRendererAcceptTest=init.then(native).then(accept)
 run originalIndependentEmptyHelperRouteAcceptTest=init.then(accept)
 run rendererBeforeBindRefusesTest=init.then(fire(Jobs(Set(renderer)))).then(refuse)
 run boundButMissingJobRefusesTest=init.then(fire(Bind(good))).then(refuse)
 run rebindingRefusesAndPreservesOriginalTest=init.then(native).then(fire(Bind(good))).then(check(s.bindRefused and s.bound and s.binding==good and not(s.permitted)))
 run foreignTransportCannotBindTest=init.then(fire(Bind({...good,transport:2}))).then(fire(Jobs(Set(renderer)))).then(refuse)
 run foreignLaunchCannotBindTest=init.then(fire(Bind({...good,launch:2}))).then(fire(Jobs(Set(renderer)))).then(refuse)
 run foreignRegisteredChildCannotBindTest=init.then(fire(Bind({...good,child:2}))).then(fire(Jobs(Set(renderer)))).then(refuse)
 run wrongSelectedProducerCannotBindTest=init.then(fire(Bind({...good,producer:22}))).then(fire(Jobs(Set(renderer)))).then(refuse)
 run rendererLabelImpostorRefusesTest=init.then(native).then(fire(Jobs(Set({...renderer,binding:{...good,job:2}})))).then(refuse)
 run rightWrapperWrongRegisteredOwnershipRefusesTest=init.then(native).then(fire(Observe({...healthy,ownership:false}))).then(refuse)
 run replacedPIDRefusesTest=init.then(native).then(fire(Jobs(Set({...renderer,binding:{...good,pid:102}})))).then(refuse)
 run reusedStartRefusesTest=init.then(native).then(fire(Jobs(Set({...renderer,binding:{...good,start:8}})))).then(refuse)
 run exitedRendererRefusesTest=init.then(native).then(fire(Observe({...healthy,alive:false}))).then(refuse)
 run unexecutedGatedRendererRefusesTest=init.then(native).then(fire(Observe({...healthy,executed:false}))).then(refuse)
 run duplicateSameActorRendererRefusesTest=init.then(native).then(fire(Jobs(Set(renderer,{...renderer,binding:{...good,job:2}})))).then(refuse)
 run outstandingThumbnailHelperRefusesTest=init.then(native).then(fire(Jobs(Set(renderer,{...renderer,role:Helper,binding:{...good,job:2}})))).then(refuse)
 run outstandingNativeExportRefusesTest=init.then(native).then(fire(Jobs(Set(renderer,{...renderer,role:NativeExport,binding:{...good,job:2}})))).then(refuse)
 run outstandingNativeEffectRefusesTest=init.then(native).then(fire(Jobs(Set(renderer,{...renderer,role:NativeEffect,binding:{...good,job:2}})))).then(refuse)
 run unknownActorJobRefusesTest=init.then(native).then(fire(Jobs(Set(renderer,{...renderer,role:Unknown,binding:{...good,job:2}})))).then(refuse)
 run genuineOtherActorWorkFollowsOriginalPolicyTest=init.then(native).then(fire(Jobs(Set(renderer,{...renderer,role:Helper,binding:{...good,actor:18,job:2}})))).then(accept)
 run actualExecutableMismatchRefusesTest=init.then(native).then(fire(Observe({...healthy,kernel:false}))).then(refuse)
 run exactArgvMismatchRefusesTest=init.then(native).then(fire(Observe({...healthy,argv:false}))).then(refuse)
 run keeperReplacementRefusesTest=init.then(native).then(fire(Observe({...healthy,keeper:false}))).then(refuse)
 run changedSnapshotDuringIORefusesTest=init.then(native).then(fire(Observe({...healthy,stable:false}))).then(refuse)
 run correctKindAndMaterialWrongObjectsRefuseTest=init.then(native).then(fire(Observe({...healthy,objects:false}))).then(refuse)
 run gatedRegistryPhaseRefusesTest=init.then(native).then(fire(Jobs(Set({...renderer,phase:Gated})))).then(refuse)
 run closedRegistryPhaseCannotClaimLiveTest=init.then(native).then(fire(Jobs(Set({...renderer,phase:Closed})))).then(refuse)
 run changedSessionCannotBindTest=init.then(fire(Bind({...good,environment:2}))).then(fire(Jobs(Set(renderer)))).then(refuse)
 run helperKindCannotBorrowRendererBindingTest=init.then(native).then(fire(Jobs(Set({...renderer,role:Helper})))).then(refuse)
}
