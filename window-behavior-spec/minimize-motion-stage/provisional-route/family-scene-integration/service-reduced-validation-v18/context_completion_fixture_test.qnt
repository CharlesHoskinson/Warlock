module context_completion_fixture_test {
 import context_completion_fixture.* from "./context_completion_fixture"
 action check(p:bool):bool=all{assert(p),s'=s}
 run emptyPendingCueCanPrecedeActiveCompletionTest=init.then(fire(Context(1))).then(fire(Context(2))).then(fire(Inspect)).then(check(cue(s) and s.active and not(s.accepted) and allProps))
 run genuineLatestCompleteOutcomePassesTest=init.then(fire(Context(2))).then(fire(Context(1))).then(fire(Validate(2))).then(fire(Finish(2))).then(fire(Inspect)).then(check(s.accepted and allProps))
 run oldWorkerCannotFinishLatestReceiptTest=init.then(fire(Context(1))).then(fire(Context(2))).then(fire(Validate(1))).then(fire(Finish(1))).then(fire(Inspect)).then(check(s.active and not(s.accepted) and allProps))
 run currentAbsentFailureCannotPassOriginalEffectsTest=init.then(fire(Context(1))).then(fire(Context(2))).then(fire(Fail(2))).then(fire(Inspect)).then(check(ready(s) and s.failed and not(s.accepted) and allProps))
 run queueFailureDoesNotCountAsNativeCompletionTest=init.then(fire(Context(1))).then(fire(Context(2))).then(fire(Finish(2))).then(fire(Inspect)).then(check(s.active and s.effects.size()==0 and not(s.accepted) and allProps))
 run wholeTwoSecondWaitExpiresWithoutResetTest=init.then(fire(Context(1))).then(fire(Context(2))).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Inspect)).then(check(s.timedOut and s.elapsed==20 and not(s.accepted) and allProps))
 run lateCompletionCannotBorrowNewDeadlineTest=init.then(fire(Context(1))).then(fire(Context(2))).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Validate(2))).then(fire(Finish(2))).then(fire(Inspect)).then(check(exactOutcome(s) and s.timedOut and not(s.accepted) and allProps))
 run originalThreeMemberEffectsRemainRequiredTest=init.then(fire(Context(1))).then(fire(Context(2))).then(fire(Validate(2))).then(fire(Finish(2))).then(fire(Inspect)).then(check(s.accepted and s.effects==original and s.finishedReceipt==2 and s.superseded and allProps))
}
