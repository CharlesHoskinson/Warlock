module presentation_test {
 import presentation.* from "./presentation"
 run arbitraryRectangleCannotCertifyAtlasTest=init.then(fire(Submit({identity:1,epoch:1,output:0,sequence:1,time:100,x:5,digest:107}))).then(fire(Present({identity:1,epoch:1,output:0,sequence:1,time:100,x:999,digest:107}))).then(all{assert(s.stale and s.ready==Set() and allProps),fire(Finish)})
 run olderPresentationAfterNewerFrameRejectedTest=init.then(fire(Submit({identity:1,epoch:1,output:0,sequence:1,time:100,x:5,digest:107}))).then(fire(Present({identity:1,epoch:1,output:0,sequence:1,time:200,x:5,digest:107}))).then(fire(Submit({identity:1,epoch:1,output:0,sequence:2,time:200,x:5,digest:107}))).then(fire(Present({identity:1,epoch:1,output:0,sequence:2,time:100,x:5,digest:107}))).then(all{assert(s.stale and s.presentedSeq.nth(0)==1 and s.presentedTime.nth(0)==200 and allProps),fire(Finish)})
 run cancelledRouteRejectsPresentationTest=init.then(fire(Cancel)).then(fire(Present({identity:1,epoch:1,output:0,sequence:1,time:100,x:5,digest:107}))).then(all{assert(s.stale and s.ready==Set() and allProps),fire(Finish)})
 run reusedAtlasDigestCannotCertifyNewIdentityTest=init.then(fire(Reuse)).then(fire(Reverse)).then(fire(Submit({identity:2,epoch:3,output:0,sequence:1,time:100,x:5,digest:107}))).then(all{assert(s.stale and s.submittedSeq==List(0,0) and allProps),fire(Finish)})
 run finalHandoverNeedsNewEpochFramesTest=init.then(fire(Submit({identity:1,epoch:1,output:0,sequence:1,time:100,x:5,digest:107}))).then(fire(Reverse)).then(fire(Present({identity:1,epoch:1,output:0,sequence:1,time:100,x:5,digest:107}))).then(all{assert(s.stale and s.ready==Set() and allProps),fire(Finish)})
 run completedRouteRejectsLateFrameTest=init.then(fire(Validate)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Tick)).then(fire(Submit({identity:1,epoch:1,output:0,sequence:1,time:100,x:10,digest:107}))).then(fire(Present({identity:1,epoch:1,output:0,sequence:1,time:100,x:10,digest:107}))).then(fire(Submit({identity:1,epoch:1,output:1,sequence:1,time:100,x:10,digest:107}))).then(fire(Present({identity:1,epoch:1,output:1,sequence:1,time:100,x:10,digest:107}))).then(fire(Finish)).then(fire(Present({identity:1,epoch:1,output:0,sequence:2,time:101,x:10,digest:107}))).then(all{assert(s.stale and s.phase=="idle" and s.nativeMin and allProps),fire(Finish)})
}
