const fs=require('fs'),vm=require('vm'),assert=require('assert');
const source=fs.readFileSync(__dirname+'/GlobalRoute.js','utf8').replace(/^\.pragma library\s*/,'');
const sandbox={module:{exports:{}},console};vm.runInNewContext(source,sandbox);const {GlobalRoute}=sandbox.module.exports;
const full={x:80,y:20,width:80,height:60},icon={x:180,y:0,width:10,height:10},identity=['0x10','abc',123],nativeRect={x:82,y:48,width:76,height:30};
function route(){return new GlobalRoute({identity,atlasIdentity:identity,completeAtlas:true,digest:'1'.repeat(64),full,icon,current:{x:130,y:10,width:45,height:35},nativeRect,outputs:['left','right'],destination:'right',topology:1,token:'abcdef123456-1',operation:'minimize'})}
function reserve(r,operation='restore',token='abcdef123456-2'){return r.reserve({identity,previousToken:r.token,token,operation})}
function proof(r){return {identity,token:r.token,nativeRect,digest:'1'.repeat(64),topology:1,familyValidated:true}}
function presented(r,o,time) {const previous=r.lastSubmitted[o];const f={identity,token:r.token,topology:1,output:o,digest:'1'.repeat(64),rect:JSON.parse(JSON.stringify(r.current)),sequence:previous?previous.sequence+1:1,time};assert(r.submit(f));assert(r.present(f));return f}
let count=0;function test(name,f){f();count++;console.log('PASS '+name)}
test('immediate reversal moves pixels while validation is blocked',()=>{const r=route(),before=JSON.stringify(r.current);assert(reserve(r));assert.equal(JSON.stringify(r.current),before);r.tick(16);assert.notEqual(JSON.stringify(r.current),before);assert.equal(r.events.length,0);assert.equal(r.digest,'1'.repeat(64))});
test('unvalidated endpoint has no native authority',()=>{const r=route();reserve(r);r.tick(400);for(const o of r.outputs)presented(r,o,400);assert.equal(r.events.length,0);assert.equal(r.phase,'provisional')});
test('promotion retains exact current rect texture and route progress',()=>{const r=route();reserve(r);r.tick(64);const at=JSON.stringify(r.current),p=r.progress;assert(r.promote(proof(r)));assert.equal(JSON.stringify(r.current),at);assert.equal(r.progress,p);assert.equal(r.digest,'1'.repeat(64))});
test('third request during blocked second keeps current visual origin',()=>{const r=route();reserve(r);r.tick(90);const at=JSON.stringify(r.current);assert(reserve(r,'minimize','abcdef123456-3'));assert.equal(JSON.stringify(r.from),at);r.tick(16);assert.notEqual(JSON.stringify(r.current),at);assert.equal(r.digest,'1'.repeat(64))});
test('stale validation and replacement identity cannot promote',()=>{const r=route();reserve(r);const old=proof(r);reserve(r,'minimize','abcdef123456-3');assert(!r.promote(old));assert(!r.promote({...proof(r),identity:['0x10','new',123]}));assert(!r.promote({...proof(r),familyValidated:false}));assert(!r.promote({...proof(r),nativeRect:{...nativeRect,width:77}}));assert.equal(r.events.length,0)});
test('all output presentation acknowledgements gate native ready',()=>{const r=route();reserve(r);r.promote(proof(r));presented(r,'left',16);assert.equal(r.events.length,0);presented(r,'right',17);assert.equal(r.events[0].kind,'ready')});
test('endpoint needs actual final frame from each output',()=>{const r=route();reserve(r);r.promote(proof(r));r.tick(16);for(const o of r.outputs)presented(r,o,16);r.tick(400);presented(r,'left',400);assert.equal(r.events.length,1);presented(r,'right',401);assert.equal(r.events[1].kind,'done');assert.equal(r.phase,'idle')});
test('rejection uses prior fresh authority and current visual rectangle',()=>{const r=route();reserve(r);r.tick(80);const at=JSON.stringify(r.current);assert(!r.reject({identity,token:r.token}));assert(r.reject({identity,token:r.token,priorIntentFreshlyValidated:true}));assert.equal(JSON.stringify(r.from),at);r.tick(400);for(const o of r.outputs)presented(r,o,400);assert.equal(r.events[1].kind,'rollbackDone');assert.equal(r.events[1].operation,'minimize')});
test('destination/output removal requires fresh service settlement',()=>{const r=route();reserve(r);r.removeOutput('right');r.tick(400);assert.equal(r.phase,'cancelled');assert.equal(r.events[0].kind,'needsFreshSettlement');assert(!r.promote(proof(r)))});
test('closed/reused route rejects old authority',()=>{const r=route();reserve(r);r.close();assert(!r.promote(proof(r)));assert.equal(r.digest,'');assert.equal(r.events.length,0)});
test('frame diagnostic retention is bounded',()=>{const r=route();reserve(r);for(let i=0;i<700;i++)presented(r,'left',i+1);assert.equal(r.frames.length,512);assert.equal(r.frames[0].time,189)});
test('older timestamp after newer presentation cannot certify readiness',()=>{const r=route();reserve(r);const old=presented(r,'left',200);const f={...old,sequence:2,time:201};assert(r.submit(f));assert(!r.present({...f,time:100}));assert.equal(r.presented.left.sequence,1)});
test('arbitrary rectangle even same token cannot certify pixels',()=>{const r=route();reserve(r);r.promote(proof(r));const old=presented(r,'left',200);const frame={...old,output:'right',rect:{x:900,y:500,width:1,height:1}};assert(!r.submit(frame));assert(!r.present(frame));assert.equal(r.events.length,0)});
test('close and idle reject subsequent presentation',()=>{const r=route();reserve(r);const f=presented(r,'left',200);r.close();assert(!r.present({...f,sequence:2,time:201}));assert(!reserve(r,'minimize','abcdef123456-3'))});
test('already presented sequence cannot repeat after newer submission',()=>{const r=route();reserve(r);const f=presented(r,'left',200);assert(r.submit({...f,sequence:2,time:201}));assert(!r.present({...f,time:202}));assert.equal(r.presented.left.sequence,1)});
test('wrong actual atlas digest and identity fail submission',()=>{const r=route();reserve(r);const f=presented(r,'left',200);assert(!r.submit({...f,sequence:2,time:201,digest:'2'.repeat(64)}));assert(!r.submit({...f,sequence:2,time:201,identity:['0x10','def',123]}))});
test('new request rejects same-atlas old epoch presentation',()=>{const r=route();reserve(r);const old=presented(r,'left',200);reserve(r,'minimize','abcdef123456-3');assert(!r.present({...old,time:201}));assert.equal(Object.keys(r.ready).length,0)});
test('invalid public seed boundary is rejected',()=>{const r=route();for(const change of [{token:'bad'},{nativeRect:{x:0,y:0,width:0,height:1}},{operation:'toggle'},{identity:['0x10','abc',0]}])assert.throws(()=>new GlobalRoute({...r,atlasIdentity:r.identity,completeAtlas:true,current:r.current,...change}))});
test('idle endpoint handover rejects late presentation',()=>{const r=route();reserve(r);r.promote(proof(r));r.tick(400);for(const o of r.outputs)presented(r,o,400);assert.equal(r.phase,'idle');const f={...r.presented.left,sequence:2,time:401};assert(!r.submit(f));assert(!r.present(f));assert.equal(r.events.length,2)});
test('delayed but ordered frames survive a newer render submission',()=>{const r=route();reserve(r);r.promote(proof(r));const f={identity,token:r.token,topology:1,output:'left',digest:r.digest,rect:{...r.current},sequence:1,time:100};assert(r.submit(f));r.tick(16);const next={...f,rect:{...r.current},sequence:2,time:101};assert(r.submit(next));assert(r.present({...f,time:102}));assert.equal(r.presented.left.sequence,1);assert(r.present({...next,time:103}));assert.equal(r.presented.left.sequence,2);assert(!r.present({...f,time:104}));assert.equal(r.submissions.left.length,0)});
test('reordered numeric geometry preserves native handover',()=>{const r=route();reserve(r);const reversed={height:nativeRect.height,width:nativeRect.width,y:nativeRect.y,x:nativeRect.x};assert(r.promote({...proof(r),nativeRect:reversed}));const c=r.current,f={identity:[...identity],token:r.token,topology:1,output:'left',digest:r.digest,rect:{height:c.height,width:c.width,y:c.y,x:c.x},sequence:1,time:10};assert(r.submit(f));assert(r.present({...f,rect:{x:c.x,y:c.y,width:c.width,height:c.height},time:11}));assert(!r.promote({...proof(r),nativeRect:{...reversed,width:reversed.width+1}}))});
test('bounded in-flight records fail safely on evicted frames',()=>{const r=route();reserve(r);const frame={identity,token:r.token,topology:1,output:'left',digest:r.digest,rect:{...r.current},sequence:1,time:1};for(let i=1;i<=150;i++)assert(r.submit({...frame,sequence:i,time:i}));assert.equal(r.submissions.left.length,128);assert(!r.present({...frame,time:151}));assert(r.present({...frame,sequence:23,time:152}));assert.equal(r.presented.left.sequence,23);assert(r.present({...frame,sequence:150,time:153}));assert.equal(r.submissions.left.length,0)});
console.log(count+' provisional route scenarios PASS');
