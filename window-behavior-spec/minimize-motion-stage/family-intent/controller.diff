+def native_family_plan(window, windows, native):
+    if not isinstance(native,list):raise ValueError('native family snapshot is not a list')
+    records={}
+    for record in native:
+        if not isinstance(record,dict) or not record.get('address') or record['address'] in records:
+            raise ValueError('invalid/duplicate native family identity')
+        records[record['address']]=record
+    mapped=[w for w in windows if w.get('mapped',True)]
+    if {key(w) for w in mapped}!={key(r) for r in records.values()}:
+        raise ValueError('native/client mapped identity coverage changed')
+    enriched=[dict(w,**{field:records[w['address']].get(field) for field in ('parent','parentStableId','modal')}) for w in mapped]
+    lookup={w['address']:w for w in enriched}
+    target=lookup.get(window['address'])
+    if target is None or key(target)!=key(window):raise ValueError('native family target identity changed')
+    owner=target;visited=set()
+    while owner.get('parent'):
+        if owner['address'] in visited:raise ValueError('native transient relation cycle')
+        visited.add(owner['address'])
+        parent=lookup.get(owner['parent'])
+        if not parent or owner.get('parentStableId')!=str(parent['stableId']):
+            raise ValueError('native family parent identity changed')
+        owner=parent
+    # Validate only the selected ancestors and their descendants. An unrelated
+    # app's malformed/dangling transient edge cannot invalidate this family.
+    members=[owner];selected={owner['address']}
+    for parent in members:
+        for child in enriched:
+            if child.get('parent')!=parent['address']:continue
+            if child.get('parentStableId')!=str(parent['stableId']):
+                raise ValueError('native family descendant parent identity changed')
+            if child['address'] in selected:raise ValueError('native transient relation cycle')
+            members.append(child);selected.add(child['address'])
+    members.sort(key=lambda w:(w['address']!=owner['address'],w.get('focusHistoryID',999)))
+    focus=owner;visited=set()
+    while focus['address'] not in visited:
+        visited.add(focus['address'])
+        children=[w for w in members if w.get('modal') and w.get('parent')==focus['address'] and w.get('parentStableId')==str(focus['stableId'])]
+        if not children:break
+        focus=min(children,key=lambda w:w.get('focusHistoryID',999))
+    return members,focus
