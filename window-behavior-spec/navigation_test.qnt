module navigation_test {
  import navigation.* from "./navigation"
  run batchRestoresNewModalWithOwnerTest = init.then(fire(MinimizeAll)).then(fire(ToggleModal))
    .then(all {assert(minimized==Set(1,2,4) and batch==Set(1,2)),fire(RestoreBatch)})
    .then(all {assert(minimized.size()==0 and allProps),fire(Focus(1))})
  run minimizeOwnerHidesFamilyTest = init.then(fire(ToggleModal)).then(fire(Minimize(1)))
    .then(all {assert(minimized == Set(1,4) and focused == 0 and allProps),fire(Restore(1))})
    .then(all {assert(minimized.size()==0 and focused==4 and allProps),fire(Focus(2))})
  run minimizeChildHidesFamilyTest = init.then(fire(ToggleModal)).then(fire(Minimize(4)))
    .then(all {assert(minimized==Set(1,4) and allProps),fire(Restore(4))})
    .then(all {assert(minimized.size()==0 and focused==4 and allProps),fire(Focus(2))})
  run modalDoesNotBlockUnrelatedTest = init.then(fire(ToggleModal)).then(fire(Focus(2)))
    .then(all {assert(focused==2 and allProps),fire(Focus(1))})
    .then(all {assert(focused==4 and allProps),fire(Focus(2))})
  run minimizedOwnerNewModalStaysHiddenTest = init.then(fire(Minimize(1))).then(fire(ToggleModal))
    .then(all {assert(minimized==Set(1,4) and allProps),fire(Restore(1))})
    .then(all {assert(focused==4 and minimized.size()==0 and allProps),fire(Focus(2))})
  run movingChildMovesFamilyTest = init.then(fire(ToggleModal)).then(fire(Move((4,2))))
    .then(all {assert(workspace.get(1)==2 and workspace.get(4)==2 and allProps),fire(Restore(1))})
    .then(all {assert(active==2 and focused==4 and allProps),fire(Focus(3))})
  run allDesktopTabCommitTest = init.then(fire(Scope(true))).then(fire(BeginTab))
    .then(fire(NextTab)).then(fire(NextTab))
    .then(all {assert(candidate==3 and active==1),fire(CommitTab)})
    .then(all {assert(active==2 and focused==3 and allProps),fire(Scope(false))})
  run currentDesktopTabExcludesForeignTest = init.then(fire(Minimize(3)))
    .then(fire(BeginTab)).then(fire(NextTab)).then(fire(NextTab))
    .then(all {assert(not(tabCandidates.contains(3)) and candidate==1 and minimized.contains(3)),fire(CancelTab)})

  run batchKeepsPreMinimizedTest = init.then(fire(Minimize(2))).then(fire(MinimizeAll))
    .then(all { assert(batch == Set(1) and minimized == Set(1, 2)), fire(RestoreBatch) })
    .then(all { assert(minimized == Set(2) and batchRestoration), fire(Restore(1)) })

  run shakeExcludesOwnerTest = init.then(fire(Shake(1)))
    .then(all { assert(minimized == Set(2) and focused == 1), fire(RestoreBatch) })
    .then(all { assert(minimized.size() == 0 and available(1) and available(2)), fire(Focus(2)) })

  run peekPreservesFocusAndMinimizeTest = init.then(fire(Minimize(2))).then(fire(Peek(true)))
    .then(all { assert(peeking and focused == 1 and minimized == Set(2)), fire(Peek(false)) })
    .then(all { assert(not(peeking) and focused == 1 and minimized == Set(2)), fire(Focus(1)) })

  run showDesktopRestoresModalChildTest = init.then(fire(ToggleDesktop))
    .then(all { assert(showDesktop and focused == 0 and savedFocus == 1), fire(ToggleModal) })
    .then(fire(ToggleDesktop))
    .then(all { assert(modal and focused == 4 and not(showDesktop) and coherent), fire(Focus(1)) })
    .then(all { assert(focused == 4), fire(ToggleModal) })
    .then(all { assert(focused == 1), fire(Focus(2)) })

  run altTabCommitsOnlyOnReleaseTest = init.then(fire(BeginTab)).then(fire(NextTab))
    .then(all { assert(tabbing and candidate == 2 and focused == 1), fire(CancelTab) })
    .then(all { assert(not(tabbing) and focused == 1), fire(Minimize(2)) })
    .then(fire(BeginTab)).then(fire(NextTab))
    .then(all { assert(focused == 1 and minimized.contains(2)), fire(CommitTab) })
    .then(all { assert(focused == 2 and not(minimized.contains(2)) and not(tabbing)), fire(Focus(1)) })

  run closingDesktopMovesModalFamilyTest = init.then(fire(ToggleModal)).then(fire(NewDesktop(3)))
    .then(fire(Move((1, 3))))
    .then(all { assert(workspace.get(1) == 3 and workspace.get(4) == 3), fire(CloseDesktop) })
    .then(all { assert(not(desktops.contains(3)) and active == 1 and workspace.get(1) == 1 and workspace.get(4) == 1), fire(Focus(1)) })
    .then(all { assert(focused == 4 and allProps), fire(SwitchDesktop(2)) })

  run showDesktopIndependentPerDesktopTest = init.then(fire(ToggleDesktop))
    .then(all { assert(showDesktop and shownDesktops == Set(1)), fire(SwitchDesktop(2)) })
    .then(all { assert(not(showDesktop)), fire(Focus(3)) })
    .then(fire(ToggleDesktop))
    .then(all { assert(showDesktop and shownDesktops == Set(1, 2)), fire(SwitchDesktop(1)) })
    .then(fire(ToggleDesktop))
    .then(all { assert(not(showDesktop) and focused == 1 and shownDesktops == Set(2)), fire(SwitchDesktop(2)) })
    .then(all { assert(showDesktop and focused == 0), fire(ToggleDesktop) })
    .then(all { assert(not(showDesktop) and focused == 3 and allProps), fire(Focus(3)) })

  run minimizeBatchIndependentPerDesktopTest = init.then(fire(MinimizeAll)).then(fire(SwitchDesktop(2)))
    .then(all { assert(batch.size() == 0 and minimized == Set(1, 2)), fire(MinimizeAll) })
    .then(all { assert(batch == Set(3) and minimized == Set(1, 2, 3)), fire(SwitchDesktop(1)) })
    .then(fire(RestoreBatch))
    .then(all { assert(minimized == Set(3) and batch.size() == 0 and batchByDesktop.get(2) == Set(3)), fire(SwitchDesktop(2)) })
    .then(fire(RestoreBatch))
    .then(all { assert(minimized.size() == 0 and allProps), fire(Focus(3)) })
}
