module minimize_commit_test {
  import minimize_commit.* from "./minimize_commit"
  run readyBeforeHideTest=init.then(fire(Minimize))
    .then(all{assert(not(s.minimized) and s.pending),fire(Ready(1))})
    .then(all{assert(s.minimized and s.ready),fire(Finish(1))})
  run restoreOnlyAtEndpointTest=init.then(fire(Minimize)).then(fire(Ready(1)))
    .then(fire(Finish(1))).then(fire(Restore)).then(fire(Ready(2)))
    .then(all{assert(s.minimized),fire(Finish(2))})
    .then(all{assert(not(s.minimized) and allProps),fire(Reload)})
  run staleReverseTest=init.then(fire(Minimize)).then(fire(Ready(1)))
    .then(fire(Restore)).then(fire(Finish(1)))
    .then(all{assert(s.stale and s.minimized and s.pending),fire(Finish(2))})
  run recoveryCommitsLatestTest=init.then(fire(Minimize)).then(fire(Restore))
    .then(fire(Reload)).then(all{assert(not(s.minimized) and not(s.pending)),fire(Finish(1))})
  run reduceSettlesLatestTest=init.then(fire(Minimize)).then(fire(Ready(1)))
    .then(fire(Restore)).then(fire(Reduce))
    .then(all{assert(not(s.minimized) and not(s.pending) and allProps),fire(Minimize)})
  run addressReuseRejectsTokenTest=init.then(fire(Minimize)).then(fire(Close))
    .then(fire(Reuse)).then(fire(Finish(1)))
    .then(all{assert(s.identity==2 and not(s.minimized) and s.stale and allProps),fire(Reload)})
  run reuseBeforeWatchdogTest=init.then(fire(Minimize)).then(fire(ReuseBeforeReady))
    .then(all{assert(s.identity==2 and s.pid==101 and not(s.pending) and allProps),fire(Finish(1))})
  run pidChangeBeforeWatchdogTest=init.then(fire(Minimize)).then(fire(PIDChangeBeforeReady))
    .then(all{assert(s.identity==1 and s.pid==102 and not(s.pending) and allProps),fire(Finish(1))})
}
