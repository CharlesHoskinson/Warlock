module max_pin_test {
 import max_pin.* from "./max_pin"
 run tiledMaxNoFloatTest=init.then(pin(1)).then(check(s.complete and not(s.windows.get(1).floating) and s.windows.get(1).mode==1 and s.windows.get(1).rect==maxRect(1) and s.windows.get(1).restore==original(1)))
 run floatingMaxPreservedTest=init.then(pin(2)).then(check(s.complete and s.windows.get(2).floating and s.windows.get(2).mode==1 and s.windows.get(2).restore==original(2)))
 run bothMaxOwnersIndependentTest=init.then(pin(1).then(pin(2))).then(check(s.complete and s.windows.get(1).mode==1 and s.windows.get(2).mode==1 and s.windows.get(1).pinned and s.windows.get(2).pinned))
 run maxUnpinNoFloatTest=init.then(pin(1).then(unpin(1))).then(check(s.complete and not(s.windows.get(1).pinned) and not(s.windows.get(1).floating) and s.windows.get(1).mode==1 and s.windows.get(2)==win(2)))
 run owner1NativeRestoreTest=init.then(pin(1).then(fire(ExitMax(1)))).then(check(s.windows.get(1).rect==rect(1) and s.windows.get(1).floating==original(1).floating and s.windows.get(1).pinned and s.windows.get(1).restore==original(1)))
 run owner1EntryExitRoundtripTest=init.then(pin(1).then(fire(ExitMax(1))).then(fire(EnterMax(1))).then(fire(ExitMax(1)))).then(check(s.windows.get(1).rect==rect(1) and s.windows.get(1).pinned and s.windows.get(1).restore==original(1)))
 run owner2NativeRestoreTest=init.then(pin(2).then(fire(ExitMax(2)))).then(check(s.windows.get(2).rect==rect(2) and s.windows.get(2).floating==original(2).floating and s.windows.get(2).pinned and s.windows.get(2).restore==original(2)))
 run owner2EntryExitRoundtripTest=init.then(pin(2).then(fire(ExitMax(2))).then(fire(EnterMax(2))).then(fire(ExitMax(2)))).then(check(s.windows.get(2).rect==rect(2) and s.windows.get(2).pinned and s.windows.get(2).restore==original(2)))
 run modalEffectiveBitIndependentTest=init.then(pin(1)).then(check(effective(3) and effective(4) and not(s.windows.get(3).pinned) and not(s.windows.get(4).pinned) and renderOrder==List(5,2,1,3,4)))
 run independentChildBitSurvivesParentUnpinTest=init.then(pin(1).then(fire(ChildOwnPin)).then(unpin(1))).then(check(s.windows.get(3).pinned and not(s.windows.get(1).pinned)))
 run raiseIndependentRootOrderTest=init.then(pin(1).then(pin(2))).then(check(renderOrder==List(5,1,3,4,2)))
 run modalInputDeepestTest=init.then(pin(1).then(fire(Focus(1)))).then(check(s.focus==4 and not(inputOrder.indices().map(i=>inputOrder.nth(i)).contains(1))))
 run crossWorkspaceChildNotProtectedTest=init.then(pin(1).then(fire(ParentMove))).then(check(not(effective(3)) and not(effective(4)) and not(s.windows.get(3).pinned)))
 run pinDoesNotFocusTest=init.then(pin(1)).then(check(s.focus==5))
 run reduceKeepsIntentTest=init.then(pin(1).then(fire(Reduce))).then(check(s.windows.get(1).pinned and s.windows.get(1).mode==1))
 run hideShowIntentTest=init.then(pin(1).then(fire(Hide(1))).then(fire(Show(1)))).then(check(s.windows.get(1).pinned and s.windows.get(1).restore==original(1)))
 run readOnlyAdoptionTest=init.then(pin(1).then(fire(Reload)).then(fire(Adopt))).then(check(s.windows.get(1).pinned and s.windows.get(1).mode==1 and s.windows.get(1).restore==original(1)))
 run transferPreservesPeerAndNativeModeTest=init.then(pin(1).then(fire(Transfer({owner:1,workspace:2,output:2})))).then(check(s.windows.get(1).pinned and s.windows.get(1).mode==1 and s.windows.get(1).rect==maxRect(2) and s.windows.get(1).restore==original(1) and s.windows.get(2)==win(2)))
 run exclusiveBeforeCallRefusedTest=init.then(fire(Exclusive(1)).then(fire(Begin(oldToken)))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run unknownModeBeforeCallRefusedTest=init.then(fire(UnknownMode(1)).then(fire(Begin(oldToken)))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run missingRestoreBeforeCallRefusedTest=init.then(fire(ForgetRestore(1)).then(fire(Begin(oldToken)))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run closedBeforeCallRefusedTest=init.then(fire(Close(1)).then(fire(Begin(oldToken)))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run hiddenBeforeCallRefusedTest=init.then(fire(Hide(1)).then(fire(Begin(oldToken)))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run capabilityBeforeCallRefusedTest=init.then(fire(CapabilityLoss).then(fire(Begin(oldToken)))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run addressStaleIdentityTest=init.then(fire(Begin({...oldToken,address:999}))).then(check(s.refused and s.calls==0))
 run stableStaleIdentityTest=init.then(fire(Begin({...oldToken,stable:999}))).then(check(s.refused and s.calls==0))
 run pidStaleIdentityTest=init.then(fire(Begin({...oldToken,pid:999}))).then(check(s.refused and s.calls==0))
 run sessionStaleIdentityTest=init.then(fire(Begin({...oldToken,session:999}))).then(check(s.refused and s.calls==0))
 run compositorStaleIdentityTest=init.then(fire(Begin({...oldToken,compositor:999}))).then(check(s.refused and s.calls==0))
 run startStaleIdentityTest=init.then(fire(Begin({...oldToken,start:999}))).then(check(s.refused and s.calls==0))
 run epochStaleIdentityTest=init.then(fire(Begin({...oldToken,epoch:999}))).then(check(s.refused and s.calls==0))
 run incarnationStaleIdentityTest=init.then(fire(Begin({...oldToken,incarnation:999}))).then(check(s.refused and s.calls==0))
 run generationStaleIdentityTest=init.then(fire(Begin({...oldToken,generation:999}))).then(check(s.refused and s.calls==0))
 run sourceStaleIdentityTest=init.then(fire(Begin({...oldToken,source:999}))).then(check(s.refused and s.calls==0))
 run modeCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(Exclusive(1))).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run geometryCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(GeometryChange(1))).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run restoreCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(RestoreChange(1))).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run focusCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(Focus(2))).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run peerGeometryCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(GeometryChange(2))).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run childIndependentPinCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(ChildOwnPin)).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run childMembershipCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(ParentMove)).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run reloadCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(Reload)).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run sourceCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(SourceReplace)).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run lifetimeCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(Reuse(1))).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run closedCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(Close(1))).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run hiddenCallbackBeforePinRefusedTest=init.then(fire(Begin(oldToken)).then(fire(Hide(1))).then(fire(Pin({ok:true,mutated:true})))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).pinned)))
 run failedMutatedPinPartialNoRetryTest=init.then(fire(Begin(oldToken)).then(fire(Pin({ok:false,mutated:true}))).then(fire(Pin({ok:true,mutated:true}))).then(fire(Finish))).then(check(s.refused and s.partial and s.calls==1 and s.windows.get(1).pinned and not(s.complete)))
 run failedUnmutatedPinNoRollbackTest=init.then(fire(Begin(oldToken)).then(fire(Pin({ok:false,mutated:false}))).then(fire(Finish))).then(check(s.refused and s.partial and s.calls==1 and not(s.windows.get(1).pinned)))
 run failedRaiseRetainsActualPinTest=init.then(fire(Begin(oldToken)).then(fire(Pin({ok:true,mutated:true}))).then(fire(Raise(false))).then(fire(Finish))).then(check(s.refused and s.partial and s.windows.get(1).pinned and s.windows.get(1).mode==1))
 run closedAfterPinNoSuccessTest=init.then(fire(Begin(oldToken)).then(fire(Pin({ok:true,mutated:true}))).then(fire(Close(1))).then(fire(Finish))).then(check(s.refused and not(s.complete)))
 run reloadOldTokenRefusedTest=init.then(fire(Reload).then(fire(Begin(oldToken)))).then(check(s.refused and s.calls==0))
 run reusedOldTokenRefusedTest=init.then(fire(Close(1)).then(fire(Reuse(1))).then(fire(Begin(oldToken)))).then(check(s.refused and s.calls==0))
 run restoredTiledUnpinNoForcedFloatTest=init.then(pin(1)).then(fire(ExitMax(1))).then(unpin(1)).then(check(s.complete and not(s.windows.get(1).pinned) and not(s.windows.get(1).floating) and s.windows.get(1).rect==rect(1) and s.windows.get(1).restore==original(1)))
 run reentryKeepsOuterIntentTest=init.then(fire(Begin(oldToken))).then(fire(Begin(oldToken))).then(fire(Pin({ok:true,mutated:true}))).then(fire(Raise(true))).then(fire(Finish)).then(check(s.complete and s.windows.get(1).pinned))
 run ordinaryTiledBranchUnchangedRefusalTest=init.then(fire(ExitMax(1))).then(fire(Begin(oldToken))).then(check(s.refused and s.calls==0 and not(s.windows.get(1).floating)))
}
