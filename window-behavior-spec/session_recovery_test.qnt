module session_recovery_test {
  import session_recovery.* from "./session_recovery"
  run legacyMigrationPreservesLiveGeometryTest = init.then(fire(Reload))
    .then(all {assert(tag==current and recalledGroup==Set(1,2)
      and normal.get(1)==640 and normal.get(2)==800),fire(Reload)})
  run sameSessionReloadPreservesGeometryTest = init.then(fire(Reload)).then(fire(Reload))
    .then(all {assert(recalledGroup==Set(1,2) and normal.get(2)==800),fire(Reload)})
  run exactIdentityCollisionInForeignSessionTest = init.then(fire(Reload))
    .then(fire(IdentityCollisionSession))
    .then(all {assert(not(sameSession) and recalledGroup.size()==0),fire(Reload)})
    .then(all {assert(saved.keys().size()==0 and normal.keys().size()==0 and tag==current),fire(Reload)})
  run restartWithoutClientSurvivalTest = init.then(fire(Reload)).then(fire(NewSession))
    .then(fire(Reload)).then(all {assert(saved.keys().size()==0),fire(Launch(1))})
    .then(all {assert(recalledGroup.size()==0),fire(Record(1))})
  run lostCloseEventCleanupTest = init.then(fire(Reload)).then(fire(Close(2)))
    .then(all {assert(recalledGroup.size()==0),fire(Reload)})
    .then(all {assert(saved.keys()==Set(1) and normal.get(1)==640),fire(Reload)})
  run legacyIdentityMismatchPrunedTest = init.then(fire(Reuse(2))).then(fire(Reload))
    .then(all {assert(saved.keys()==Set(1) and tag==current),fire(Reload)})
  run uniqueImplicitTargetMigratesSafelyTest = init.then(fire(UniqueTarget)).then(fire(Reload))
    .then(all {assert(tag==current and recalledGroup==Set(1,2)),fire(Reload)})
  run ambiguousTargetCannotRetagOrClearTest = init.then(fire(Reload)).then(fire(IdentityCollisionSession))
    .then(fire(AmbiguousTarget)).then(fire(Reload))
    .then(all {assert(tag==1 and saved.keys()==Set(1,2) and recalledGroup.size()==0),fire(Record(1))})
    .then(all {assert(tag==1 and saved.keys()==Set(1,2)),fire(ExplicitTarget)})
    .then(fire(Reload)).then(all {assert(tag==current and saved.keys().size()==0),fire(Reload)})
  run missingTargetCannotWriteTest = init.then(fire(MissingTarget)).then(fire(Reload))
    .then(all {assert(tag==0 and saved.keys()==Set(1,2) and normal.get(2)==800),fire(Reload)})
}
