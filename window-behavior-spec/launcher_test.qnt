module launcher_test {
  import launcher.* from "./launcher"
  run incrementalFieldsTest = init.then(fire(Count((1,1,2))))
    .then(fire(CountVisible((1,1,true)))).then(fire(Progress((1,1,1))))
    .then(fire(ProgressVisible((1,1,true))))
    .then(all {assert(badge(1)==2 and progress(1)==1),fire(Urgent((1,1,true)))})
    .then(all {assert(badge(1)==2 and progress(1)==1 and selected(1).urgent),fire(Disconnect(1))})
  run disconnectFallsBackTest = init.then(fire(Count((1,1,1))))
    .then(fire(CountVisible((1,1,true)))).then(fire(Count((2,1,2))))
    .then(fire(CountVisible((2,1,true))))
    .then(all {assert(badge(1)==2),fire(Disconnect(2))})
    .then(all {assert(badge(1)==1),fire(Disconnect(1))})
    .then(all {assert(badge(1)==0 and progress(1)==-1),fire(Connect(1))})
  run appIsolationTest = init.then(fire(Progress((1,1,2))))
    .then(fire(ProgressVisible((1,1,true)))).then(fire(Count((1,2,1))))
    .then(fire(CountVisible((1,2,true))))
    .then(all {assert(progress(1)==2 and badge(1)==0 and progress(2)==-1 and badge(2)==1),fire(Disconnect(1))})
  run hidePreservesValueTest = init.then(fire(Count((1,1,2))))
    .then(fire(CountVisible((1,1,true)))).then(fire(CountVisible((1,1,false))))
    .then(all {assert(badge(1)==0 and selected(1).count==2),fire(CountVisible((1,1,true)))})
    .then(all {assert(badge(1)==2),fire(Disconnect(1))})
  run quicklistPreservesBadgesTest = init.then(fire(Count((1,1,2))))
    .then(fire(CountVisible((1,1,true)))).then(fire(Quicklist((1,1,1))))
    .then(all {assert(badge(1)==2 and selected(1).quicklist==1),fire(Quicklist((1,1,0)))})
    .then(all {assert(badge(1)==2 and selected(1).quicklist==0),fire(Disconnect(1))})
}
