module modal_stack_test {
  import modal_stack.* from "./modal_stack"
  run pinnedDialogGetsOwnClickTest=init.then(fire(Pin(true))).then(fire(Raise(2))).then(fire(Click(3)))
    .then(all {assert(delivered==3 and focus==3 and rank(3)>rank(1) and allProps),fire(Click(1))})
    .then(all {assert(delivered==0 and focus==3 and allProps),fire(Pin(false))})
  run nestedPinnedDialogGetsOwnClickTest=init.then(fire(Depth(2))).then(fire(Pin(true))).then(fire(Click(4)))
    .then(all {assert(delivered==4 and focus==4 and allProps),fire(Click(3))})
    .then(all {assert(delivered==0 and focus==4 and allProps),fire(Pin(false))})
  run raisingOwnerRetainsNestedOrderTest=init.then(fire(Depth(2))).then(fire(Raise(2))).then(fire(Raise(1)))
    .then(all {assert(order==List(2,1,3,4) and allProps),fire(Click(4))})
  run dialogOpenedAfterPinStaysAboveTest=init.then(fire(Depth(0))).then(fire(Pin(true))).then(fire(Depth(2)))
    .then(all {assert(rank(3)>rank(1) and rank(4)>rank(3) and allProps),fire(Click(4))})
  run unrelatedFocusWithPinnedFamilyTest=init.then(fire(Pin(true))).then(fire(Click(2)))
    .then(all {assert(focus==2 and delivered==2 and rank(2)<rank(1) and allProps),fire(Click(3))})
  run closingNestedKeepsSurvivorInputTest=init.then(fire(Depth(2))).then(fire(Click(4))).then(fire(Depth(1)))
    .then(fire(Click(3)))
    .then(all {assert(focus==3 and delivered==3 and allProps),fire(Depth(0))})
  run pinnedFamilyFollowsTwoDesktopsTest=init.then(fire(Depth(2))).then(fire(Pin(true))).then(fire(DesktopSwitch(2))).then(fire(Click(4)))
    .then(all{assert(ownerDesktop==2 and dialogDesktop==2 and delivered==4 and allProps),fire(DesktopSwitch(3))})
    .then(fire(Click(1))).then(all{assert(ownerDesktop==3 and dialogDesktop==3 and focus==4 and delivered==0 and allProps),fire(Pin(false))})
  run unpinnedFamilyDoesNotLeakTest=init.then(fire(Pin(true))).then(fire(DesktopSwitch(2))).then(fire(Pin(false))).then(fire(DesktopSwitch(3)))
    .then(all{assert(ownerDesktop==2 and dialogDesktop==2 and not(visible(1)) and not(canFire(Click(3))) and allProps),fire(DesktopSwitch(2))})
  run newModalAfterPinnedSwitchTest=init.then(fire(Depth(0))).then(fire(Pin(true))).then(fire(DesktopSwitch(2))).then(fire(Depth(2))).then(fire(Click(4)))
    .then(all{assert(ownerDesktop==2 and dialogDesktop==2 and delivered==4 and allProps),fire(Depth(1))})
}
