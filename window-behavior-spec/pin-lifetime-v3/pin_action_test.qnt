module pin_action_test {
 import pin_action.* from "./pin_action"
 run fullPinTest=init.then(fullPin).then(check(s.complete and s.pinned==Set(1,2)))
 run floatFailureVisiblePartialTest=init.then(fire(Begin(identity))).then(fire(Float({ok:false,mutated:true}))).then(check(s.refused and s.partial and s.floating.contains(1) and s.pinned==Set(2)))
 run floatFailureBeforeMutationTest=init.then(fire(Begin(identity))).then(fire(Float({ok:false,mutated:false}))).then(check(s.refused and not(s.partial) and s.pinned==Set(2)))
 run pinFailureRetainsFloatTest=init.then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:true}))).then(fire(Pin({ok:false,mutated:false}))).then(check(s.refused and s.partial and s.floating.contains(1)))
 run pinFailureAfterMutationTest=init.then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:true}))).then(fire(Pin({ok:false,mutated:true}))).then(check(s.refused and s.partial and s.pinned.contains(1)))
 run raiseFailureRetainsActualPinTest=init.then(untilPin).then(fire(Raise(false))).then(check(s.refused and s.partial and s.pinned.contains(1) and s.feedback==Map()))
 run raiseClosureCallbackRefusesSuccessTest=init.then(untilPin).then(fire(Raise(true))).then(fire(Close(1))).then(fire(Finish)).then(check(not(s.complete) and s.refused and s.feedback==Map()))
 run raiseMinimizeCallbackKeepsPinIntentTest=init.then(untilPin).then(fire(Raise(true))).then(fire(Minimize(1))).then(fire(Finish)).then(check(not(s.complete) and s.refused and s.saved.contains(1))).then(fire(Restore(1))).then(check(s.pinned==Set(1,2)))
 run raiseReloadCallbackRefusesSuccessTest=init.then(untilPin).then(fire(Raise(true))).then(fire(Reload)).then(fire(Finish)).then(check(not(s.complete) and s.refused and s.pinned.contains(1) and s.feedback==Map()))
 run floatClosureCallbackRefusesPinTest=init.then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:true}))).then(fire(Close(1))).then(fire(Pin({ok:true,mutated:true}))).then(check(s.lastWrite==0 and s.refused))
 run floatMinimizeCallbackRefusesPinTest=init.then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:true}))).then(fire(Minimize(1))).then(fire(Pin({ok:true,mutated:true}))).then(check(s.lastWrite==0 and s.refused and s.pinned==Set(2)))
 run pinClosureCallbackRefusesRaiseTest=init.then(untilPin).then(fire(Close(1))).then(fire(Raise(true))).then(check(s.refused and not(s.complete)))
 run sameOwnerReentryRefusedTest=init.then(fire(Begin(identity))).then(fire(Begin(identity))).then(check(s.active and s.refused and s.pinned==Set(2)))
 run sameOwnerReentryDoesNotRedirectOuterIntentTest=init.then(fire(Begin(identity))).then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:true}))).then(fire(Pin({ok:true,mutated:true}))).then(fire(Raise(true))).then(fire(Finish)).then(check(s.complete and s.pinned==Set(1,2)))
 run focusCannotRedirectOwnerTest=init.then(fire(Begin(identity))).then(fire(Focus(2))).then(fire(Float({ok:true,mutated:true}))).then(fire(Pin({ok:true,mutated:true}))).then(fire(Raise(true))).then(fire(Finish)).then(check(s.pinned==Set(1,2) and s.focus==2))
 run independentlyPinnedPeerPreservedTest=init.then(fullPin).then(check(s.pinned.contains(2)))
 run fullscreenRefusedBeforeFloatTest=init.then(fire(Fullscreen(1))).then(fire(Begin(identity))).then(check(s.refused and not(s.floating.contains(1)) and s.pinned==Set(2)))
 run fullscreenCallbackAfterFloatRefusedTest=init.then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:true}))).then(fire(Fullscreen(1))).then(fire(Pin({ok:true,mutated:true}))).then(check(s.refused and s.pinned==Set(2)))
 run staleAddressRefusedTest=init.then(fire(Begin({...identity,address:102}))).then(check(s.refused and not(s.active)))
 run staleStableIdRefusedTest=init.then(fire(Begin({...identity,stable:2}))).then(check(s.refused and not(s.active)))
 run stalePidRefusedTest=init.then(fire(Begin({...identity,pid:12}))).then(check(s.refused and not(s.active)))
 run staleSessionRefusedTest=init.then(fire(Begin({...identity,session:2}))).then(check(s.refused and not(s.active)))
 run reloadChangesEpochNotCompositorSessionTest=init.then(fire(Reload)).then(check(s.session==1 and s.epoch==2)).then(fire(Begin(identity))).then(check(s.refused and not(s.active)))
 run closedReusedAddressOldIdentityRefusedTest=init.then(fire(Close(1))).then(fire(Reuse)).then(fire(Begin(identity))).then(check(s.refused and not(s.pinned.contains(3))))
 run partialActionNoSuccessfulFeedbackTest=init.then(untilPin).then(fire(Raise(false))).then(fire(Tick({owner:1,generation:1}))).then(check(s.feedback==Map() and s.lastWrite==0))
 run latestGenerationRejectsOldFeedbackTest=init.then(fullPin).then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:false}))).then(fire(Pin({ok:true,mutated:true}))).then(fire(Finish)).then(fire(Tick({owner:1,generation:1}))).then(check(s.lastWrite==0 and s.feedback.get(1)==2))
 run reducedMotionRetiresFeedbackTest=init.then(fullPin).then(fire(Reduce)).then(fire(Tick({owner:1,generation:1}))).then(check(s.lastWrite==0 and s.feedback==Map()))
 run minimizeRetiresFeedbackAndKeepsIntentTest=init.then(fullPin).then(fire(Minimize(1))).then(fire(Tick({owner:1,generation:1}))).then(check(s.lastWrite==0 and s.saved.contains(1))).then(fire(Restore(1))).then(check(s.pinned==Set(1,2)))
 run reloadRetiresFeedbackTest=init.then(fullPin).then(fire(Reload)).then(fire(Tick({owner:1,generation:1}))).then(check(s.lastWrite==0 and s.feedback==Map()))
 run closeRetiresFeedbackTest=init.then(fullPin).then(fire(Close(1))).then(fire(Reuse)).then(fire(Tick({owner:1,generation:1}))).then(check(s.lastWrite==0 and not(s.feedback.keys().contains(3))))
 run unpinBeforeMinimizeRemainsUnpinnedTest=init.then(fullPin).then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:false}))).then(fire(Pin({ok:true,mutated:true}))).then(fire(Finish)).then(fire(Minimize(1))).then(fire(Restore(1))).then(check(s.pinned==Set(2)))
 run sameAddressStablePidNewLifetimeOldTokenRefusedTest=init.then(fire(ReuseTuple)).then(fire(Begin(identity))).then(check(s.refused and not(s.active) and s.lifetime==2))
 run freshReusedLifetimeTokenAcceptedTest=init.then(fire(ReuseTuple)).then(fire(Begin({...identity,lifetime:2}))).then(fire(Float({ok:true,mutated:true}))).then(fire(Pin({ok:true,mutated:true}))).then(fire(Raise(true))).then(fire(Finish)).then(check(s.complete and s.pinned==Set(1,2)))
 run callbackPinIntentAfterFloatRefusesOverrideTest=init.then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:true}))).then(fire(CallbackPin({owner:1,pinned:true}))).then(fire(Pin({ok:true,mutated:true}))).then(check(s.refused and s.pinned==Set(1,2) and not(s.complete)))
 run callbackTileAfterPinRefusesSuccessTest=init.then(untilPin).then(fire(Tile(1))).then(fire(Raise(true))).then(fire(Finish)).then(check(not(s.complete)))
 run normalTransferPreservesCapturedLifetimeAndPeerTest=init.then(untilPin).then(fire(Transfer({owner:1,special:false,workspace:2,monitor:2}))).then(fire(Raise(true))).then(fire(Finish)).then(check(s.complete and s.pinned==Set(1,2) and s.workspace.get(1)==2 and s.monitor.get(1)==2))
 run specialTransferRefusesRemainingActionTest=init.then(fire(Begin(identity))).then(fire(Float({ok:true,mutated:true}))).then(fire(Transfer({owner:1,special:true,workspace:2,monitor:2}))).then(fire(Pin({ok:true,mutated:true}))).then(check(s.refused and s.pinned==Set(2)))
 run callbackCloseReuseBeforeFinishRejectsOldLeaseTest=init.then(untilPin).then(fire(Close(1))).then(fire(ReuseTuple)).then(fire(Finish)).then(check(not(s.complete) and s.feedback==Map()))
 run reducedNewOperationKeepsSuccessWithoutFeedbackTest=init.then(fire(Reduce)).then(fullPin).then(check(s.complete and s.feedback==Map()))
 run unloadedPluginOldTokenRefusesSameCompositorTest=init.then(fire(UnloadReload)).then(fire(Begin(identity))).then(check(s.refused and not(s.active) and s.session==1 and s.epoch==1))
 run unloadedPluginFreshTokenAcceptedTest=init.then(fire(UnloadReload)).then(fire(Begin({...identity,incarnation:2}))).then(fire(Float({ok:true,mutated:true}))).then(fire(Pin({ok:true,mutated:true}))).then(fire(Raise(true))).then(fire(Finish)).then(check(s.complete))
 run closeWhileCoreMappedCannotReacquireTest=init.then(fire(Close(1))).then(fire(MappedQuery)).then(fire(Begin(identity))).then(check(s.coreMapped.contains(1) and not(s.live.contains(1)) and not(s.active) and s.refused))
 run genuineOpenNewGenerationOldTokenRefusedTest=init.then(fire(Close(1))).then(fire(OpenSame)).then(fire(Begin(identity))).then(check(s.live.contains(1) and s.lifetime==2 and not(s.active)))
 run genuineOpenFreshTokenAllowedTest=init.then(fire(Close(1))).then(fire(OpenSame)).then(fire(Begin({...identity,lifetime:2}))).then(check(s.active))
 run closeQueriesNeverEraseRetirementTest=init.then(fire(Close(1))).then(fire(MappedQuery)).then(fire(MappedQuery)).then(check(not(s.live.contains(1)) and s.lifetime==1))
 run externalPinChangeRetiresFeedbackTest=init.then(fullPin).then(fire(CallbackPin({owner:1,pinned:false}))).then(fire(CallbackPin({owner:1,pinned:true}))).then(fire(Tick({owner:1,generation:1}))).then(check(not(s.feedback.keys().contains(1)) and s.lastWrite==0))
 run tileFloatReturnCannotReviveFeedbackTest=init.then(fullPin).then(fire(Tile(1))).then(fire(Tick({owner:1,generation:1}))).then(check(not(s.feedback.keys().contains(1)) and s.lastWrite==0))
 run fullscreenRetiresImmediatelyTest=init.then(fullPin).then(fire(Fullscreen(1))).then(check(not(s.feedback.keys().contains(1))))
 run rapidMinimizeRestoreRetirementTest=init.then(fullPin).then(fire(Minimize(1))).then(fire(Restore(1))).then(fire(Tick({owner:1,generation:1}))).then(check(not(s.feedback.keys().contains(1)) and s.pinned.contains(1) and s.lastWrite==0))
 run peerPinChangePreservesOwnerFeedbackTest=init.then(fullPin).then(fire(CallbackPin({owner:2,pinned:false}))).then(check(s.feedback.keys().contains(1) and s.pinned.contains(1)))
 run normalTransferRetainsFeedbackTest=init.then(fullPin).then(fire(Transfer({owner:1,special:false,workspace:2,monitor:2}))).then(fire(Tick({owner:1,generation:1}))).then(check(s.feedback.keys().contains(1) and s.lastWrite==1))
 run specialReturnCannotReviveFeedbackTest=init.then(fullPin).then(fire(Transfer({owner:1,special:true,workspace:2,monitor:2}))).then(fire(Transfer({owner:1,special:false,workspace:1,monitor:1}))).then(fire(Tick({owner:1,generation:1}))).then(check(not(s.feedback.keys().contains(1)) and s.lastWrite==0))
 run duplicateOpeningDoesNotChangeLifetimeTest=init.then(fire(OpenSame)).then(fire(Begin(identity))).then(check(s.active and s.lifetime==1))
}
