module concrete_host_lifecycle {
 import host_realm_lifecycle.* from "./host_realm_lifecycle"
 action check(ok:bool):bool=all{assert(ok and safety),s'=s}
 run firstCurrent=init.then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(check(s.epoch==1 and s.context==1 and s.lease==1 and s.current==true and s.retired==false and s.policy==1 and not(s.reveal)))
 run firstStrictClose=init.then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(fire(ClosePopup)).then(fire(Drain)).then(fire(Retire)).then(check(s.epoch==1 and s.context==1 and s.lease==1 and s.current==false and s.retired==true and s.policy==1 and not(s.reveal)))
 run firstFreshContext=init.then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(fire(ClosePopup)).then(fire(Drain)).then(fire(Retire)).then(fire(Replace)).then(check(s.epoch==1 and s.context==2 and s.lease==1 and s.current==false and s.retired==false and s.policy==1 and not(s.reveal)))
 run secondCurrent=init.then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(fire(ClosePopup)).then(fire(Drain)).then(fire(Retire)).then(fire(Replace)).then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(check(s.epoch==2 and s.context==2 and s.lease==2 and s.current==true and s.retired==false and s.policy==1 and not(s.reveal)))
 run secondStrictClose=init.then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(fire(ClosePopup)).then(fire(Drain)).then(fire(Retire)).then(fire(Replace)).then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(fire(ClosePopup)).then(fire(Drain)).then(fire(Retire)).then(check(s.epoch==2 and s.context==2 and s.lease==2 and s.current==false and s.retired==true and s.policy==1 and not(s.reveal)))
 run secondFreshContext=init.then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(fire(ClosePopup)).then(fire(Drain)).then(fire(Retire)).then(fire(Replace)).then(fire(OpenIntent)).then(fire(DOMReady)).then(fire(Admit)).then(fire(Initialize)).then(fire(Apply)).then(fire(ClosePopup)).then(fire(Drain)).then(fire(Retire)).then(fire(Replace)).then(check(s.epoch==2 and s.context==3 and s.lease==2 and s.current==false and s.retired==false and s.policy==1 and not(s.reveal)))
}
