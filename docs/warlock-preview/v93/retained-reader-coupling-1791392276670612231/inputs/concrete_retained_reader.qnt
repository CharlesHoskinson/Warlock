module concrete_retained_reader {
 import host_realm_lifecycle.* from "./host_realm_lifecycle"
 import controlled_reader_lifetime_v4.* from "./controlled_reader_lifetime_v4"
 action check(ok:bool):bool=all{assert(ok and readerSafety),s'=s,reader'=reader,probed'=probed,closes'=closes}
 run heldOriginal=initReader.then(event(OpenIntent)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(hold).then(check(reader==HeldCurrent and s.epoch==1 and s.context==1 and s.duty and closes==0))
 run closingReader=initReader.then(event(OpenIntent)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(hold).then(event(ClosePopup)).then(check(reader==HeldRevoked and s.closing and s.duty and s.native and not(s.current)))
 run revokedReads=initReader.then(event(OpenIntent)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(hold).then(event(ClosePopup)).then(probe).then(check(reader==HeldRevoked and probed and closes==0 and s.duty))
 run pendingPopup=initReader.then(event(OpenIntent)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(hold).then(event(ClosePopup)).then(probe).then(event(OpenIntent)).then(event(DOMReady)).then(check(s.popup and s.lease==2 and s.epoch==1 and s.context==1 and s.duty and s.closing))
 run oneOriginalClose=initReader.then(event(OpenIntent)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(hold).then(event(ClosePopup)).then(probe).then(event(OpenIntent)).then(event(DOMReady)).then(release).then(check(reader==Released and closes==1 and s.duty and s.native))
 run independentStrictClose=initReader.then(event(OpenIntent)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(hold).then(event(ClosePopup)).then(probe).then(event(OpenIntent)).then(event(DOMReady)).then(release).then(event(Drain)).then(event(Retire)).then(check(not(s.duty) and not(s.native) and s.retired and s.epoch==1))
 run samePopupReplacement=initReader.then(event(OpenIntent)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(hold).then(event(ClosePopup)).then(probe).then(event(OpenIntent)).then(event(DOMReady)).then(release).then(event(Drain)).then(event(Retire)).then(event(Replace)).then(check(s.popup and s.lease==2 and s.context==2 and not(s.dom) and s.policy==1))
 run freshLaterEpoch=initReader.then(event(OpenIntent)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(hold).then(event(ClosePopup)).then(probe).then(event(OpenIntent)).then(event(DOMReady)).then(release).then(event(Drain)).then(event(Retire)).then(event(Replace)).then(event(DOMReady)).then(event(Admit)).then(event(Initialize)).then(event(Apply)).then(check(s.current and s.epoch==2 and s.context==2 and s.lease==2 and closes==1 and s.policy==1))
}
