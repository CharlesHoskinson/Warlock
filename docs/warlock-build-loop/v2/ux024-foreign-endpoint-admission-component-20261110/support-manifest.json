  "patch": {
    "path": "/home/hoskinson/warlock-loop-review-20261109T142956Z/next-product-action/ux024-popup-focus-containment/real-window-producer/runtime-producer/support-preparation/candidate.patch",
    "sha256": "b598e0a8587806b6c6c4f7fc3d323856a3a1bc1b33a8f986e640774f5784ea83"
  },
  "fixedSuites": [
    [
      "ui-webkit-controls"
    ],
    [
      "ui-webkit-controls",
      "foreign-endpoint-refusal-controls"
    ]
  ],
  "endpointArgv": [
    "<fresh-ui-webkit-controls>",
    "--foreign-endpoint-refusal-only"
  ],
  "endpointSentinel": "foreign-endpoint-admission-cpu:17-refusals;32-seeds;expired-retained;no-connect\\n",
  "deadlineEnvironment": "WARLOCK_FOREIGN_ENDPOINT_DEADLINE_NS",
  "deadlineRule": "Single absolute monotonic min(parentD, now+5s, canonical authorization remaining); no caller-supplied value retained. Same inheritedD for all endpoint controls/expiry, outer900+2 unchanged.",
  "builderControls": 15,
  "admissionControls": 8,
  "newControls": 6,
  "oldControlBodiesPreserved": true,
  "executed": false,
  "limits": [
    "Explicit metadata/held-FD pre-connect CPU IO, no socket creation/connect, callbacks or provider readiness inferred.",
    "Same2targets, source closure, SDK/cache, current authorization, private /run, groupabsence, timeout and guards; no engine change.",
    "Root must observe source-only support tests-first before CAS and install Main successor with exact separatebranch contract."
  ]
