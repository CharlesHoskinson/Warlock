+def opener_refusal_fd_diagnostics(base, proc, clock, rows):
+    """Later metadata only; no content reads, creator proof, or mapping allowance."""
+    import fcntl
+    result = {'complete': False, 'origin': 'unknown', 'creatorAttested': False,
+              'phase': 'after-original-classifier-refusal', 'fdLimit': 256, 'entries': []}
+    keys = {(os.makedev(*(int(part, 16) for part in row['device'].split(':'))), row['inode'])
+            for row in rows if (row['pathname'] or '').startswith('/memfd:')}
+    root = Path('/proc', str(proc.pid), 'fd')
+    try:
+        base.left(clock)
+        names = []
+        with os.scandir(root) as entries:
+            for entry in entries:
+                base.left(clock)
+                if entry.name.isdigit():
+                    names.append(entry.name)
+                    if len(names) > 256:
+                        raise ValueError('diagnostic FD enumeration exceeds256')
+        for name in sorted(names, key=int):
+            base.left(clock)
+            path = root / name
+            item = {'fd': int(name), 'origin': 'unknown'}
+            try:
+                info = path.stat()
+                if (info.st_dev, info.st_ino) not in keys:
+                    continue
+                result['entries'].append(item)
+                link = os.readlink(path)
+                if len(link) > 512:
+                    raise ValueError('diagnostic descriptor link exceeds bound')
+                item['linkBefore'] = link
+                descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK)
+                try:
+                    held = os.fstat(descriptor)
+                    if (held.st_dev, held.st_ino) != (info.st_dev, info.st_ino):
+                        raise ValueError('diagnostic descriptor changed during acquisition')
+                    item['heldStat'] = {'device': held.st_dev, 'inode': held.st_ino,
+                                        'size': held.st_size, 'mode': held.st_mode,
+                                        'uid': held.st_uid, 'gid': held.st_gid, 'links': held.st_nlink}
+                    if not stat.S_ISREG(held.st_mode):
+                        raise ValueError('diagnostic backing is not regular')
+                    base.left(clock)
+                    with (Path('/proc', str(proc.pid), 'fdinfo') / name).open('r', encoding='ascii') as stream:
+                        text = stream.read(4097)
+                    if len(text) > 4096:
+                        raise ValueError('diagnostic fdinfo exceeds bound')
+                    fields = dict(line.split(':', 1) for line in text.splitlines() if ':' in line)
+                    item['originalFlags'] = int(fields['flags'].strip(), 8)
+                    item['originalPosition'] = int(fields['pos'].strip())
+                    item['originalMountId'] = int(fields['mnt_id'].strip())
+                    try:
+                        item['seals'] = fcntl.fcntl(descriptor, fcntl.F_GET_SEALS)
+                    except OSError as error:
+                        item['sealsUnknown'] = type(error).__name__ + ': ' + str(error)[:256]
+                    base.left(clock)
+                    after = path.stat()
+                    item['linkAfter'] = os.readlink(path)
+                    if ((after.st_dev, after.st_ino, after.st_size) != (held.st_dev, held.st_ino, held.st_size)
+                            or item['linkAfter'] != link):
+                        raise ValueError('diagnostic descriptor changed after observation')
+                    item['sameBackingAtObservation'] = True
+                finally:
+                    os.close(descriptor)
+            except (OSError, ValueError, KeyError) as error:
+                if item not in result['entries']:
+                    result['entries'].append(item)
+                item['unknown'] = type(error).__name__ + ': ' + str(error)[:256]
+        base.left(clock)
+        result['enumerationComplete'] = True
+        result['complete'] = all('unknown' not in item for item in result['entries'])
+    except Exception as error:
+        result['error'] = type(error).__name__ + ': ' + str(error)[:512]
+    return result
