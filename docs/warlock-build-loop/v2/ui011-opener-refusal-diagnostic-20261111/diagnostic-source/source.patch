+def capture_opener_classifier_refusal(collector, base, proc, born, image, clock,
+                                      output, receipt, before, raw, rows, links, error):
+    """Retain the classifier's original input, then separate later owned FD metadata."""
+    item = {'schema': 1, 'diagnosticOnly': True, 'qualification': False,
+            'creatorAttested': False, 'ownedAcrossCapture': False,
+            'pid': proc.pid, 'birth': born, 'image': image,
+            'originalDeadline': clock['deadline'], 'identityBeforeSnapshot': before,
+            'originalError': {'type': type(error).__name__, 'message': str(error)[:512]},
+            'originalSnapshot': {'rawSha256': digest(raw), 'rawByteCount': len(raw),
+                                 'rawUtf8': raw.decode('utf-8', errors='surrogateescape'),
+                                 'rows': copy.deepcopy(rows), 'links': copy.deepcopy(links)},
+            'laterFdDiagnostics': {'complete': False, 'origin': 'unknown', 'entries': []}}
+    receipt['openerClassifierRefusal'] = item
+    try:
+        base.left(clock)
+        after_snapshot = collector.failure_census_context(base, proc, born, image, clock)
+        item['identityAfterSnapshot'] = after_snapshot
+        require(after_snapshot == before, 'opener ownership changed across refused snapshot')
+        require(len(raw) <= collector.MAPS_CAP, 'original refused map input exceeds bound')
+        path = output / 'opener-classifier-refusal.maps'
+        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(descriptor, 'wb') as stream:
+            stream.write(raw)
+        item['originalSnapshot']['raw'] = {'path': str(path), 'sha256': digest(raw)}
+        item['laterFdDiagnostics'] = opener_refusal_fd_diagnostics(base, proc, clock, rows)
+        base.left(clock)
+        after = collector.failure_census_context(base, proc, born, image, clock)
+        item['identityAfterDiagnostics'] = after
+        require(after == before, 'opener ownership changed during refusal diagnostics')
+        item['ownedAcrossCapture'] = True
+    except Exception as problem:
+        item['captureError'] = type(problem).__name__ + ': ' + str(problem)[:512]
+    try:
+        write_json(output / 'opener-classifier-refusal.json', item)
+    except Exception as problem:
+        item['retentionError'] = type(problem).__name__ + ': ' + str(problem)[:512]
