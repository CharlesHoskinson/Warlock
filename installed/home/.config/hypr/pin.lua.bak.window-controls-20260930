-- Windows-style "always on top" pin, used by SUPER+P and the hyprbars 📌 button
-- (via ~/.local/bin/hypr-pin-toggle -> `hyprctl eval 'hypr_pin_toggle()'`).
-- Everything runs inside the compositor in one go, so float + pin + raise land in
-- the same frame, then the window "lifts" in with a short opacity fade.

local STEP_MS = 16
local LIFT_MS = 220
local LIFT_FROM = 0.72 -- opacity the window fades up from when pinned
local DROP_FROM = 0.88 -- gentler dip when unpinned

local function fade_in(target, from)
  if hypr_pin_fade_timer then hypr_pin_fade_timer:set_enabled(false) end
  local elapsed = 0
  local function set(alpha)
    hl.dispatch(hl.dsp.window.set_prop({ prop = "opacity", value = string.format("%.3f", alpha), window = target }))
  end
  set(from)
  hypr_pin_fade_timer = hl.timer(function()
    elapsed = elapsed + STEP_MS
    local t = math.min(elapsed / LIFT_MS, 1)
    local eased = 1 - (1 - t) ^ 3 -- ease-out cubic
    set(from + (1 - from) * eased)
    if t >= 1 then hypr_pin_fade_timer:set_enabled(false) end
  end, { timeout = STEP_MS, type = "repeat" })
end

function hypr_pin_toggle()
  local w = hl.get_active_window()
  if not w then return end
  local target = "address:" .. w.address

  -- Pinning only applies to floating windows.
  if not w.floating then hl.dispatch(hl.dsp.window.float({ action = "set", window = target })) end
  hl.dispatch(hl.dsp.window.pin({ window = target }))

  -- Confirm on screen: on an already-focused, already-on-top window the border change
  -- alone is too subtle to notice.
  if hl.get_active_window().pinned then
    hl.dispatch(hl.dsp.window.alter_zorder({ mode = "top", window = target }))
    fade_in(target, LIFT_FROM)
    hl.exec_cmd([[omarchy-osd -m "📌  Pinned — always on top" -d 1200]])
  else
    fade_in(target, DROP_FROM)
    hl.exec_cmd([[omarchy-osd -m "Unpinned" -d 1000]])
  end
end

o.bind("SUPER + P", "Pin window (always on top)", hypr_pin_toggle)
