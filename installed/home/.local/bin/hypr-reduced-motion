#!/usr/bin/env python3
import argparse
import json
from pathlib import Path
import subprocess

parser = argparse.ArgumentParser(description='Control desktop motion')
parser.add_argument('command', choices=['toggle', 'on', 'off', 'status'])
args = parser.parse_args()
path = Path.home() / '.config/hypr/reduced-motion'
enabled = path.exists() and path.read_text().strip() == '1'
if args.command != 'status':
    enabled = not enabled if args.command == 'toggle' else args.command == 'on'
    path.write_text('1\n' if enabled else '0\n')
    subprocess.run(['hyprctl', 'eval', 'hl.config({animations={enabled=' + str(not enabled).lower() + '}}); hypr_reduced_motion=' + str(enabled).lower() + '; if hypr_motion_changed then hypr_motion_changed(hypr_reduced_motion) end'], check=True, stdout=subprocess.DEVNULL)
    # The file survives config reloads. Shell widgets consume it via the backend.
print(json.dumps({'reducedMotion': enabled}))
