module viewport_geometry_test {
 import viewport_geometry.* from "./viewport_geometry"
 run exactPairTest=init.then(fire(Move(good))).then(fire(Move(second))).then(fire(Press)).then(all{assert(ready and pressed),fire(Invalidate)})
 run beforePairRefusedTest=init.then(fire(Move(good))).then(fire(Press)).then(all{assert(not(pressed)),fire(Invalidate)})
 run syntheticRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,trusted:false}))).then(all{assert(not(ready)),fire(Press)})
 run staleSequenceRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,sequence:1}))).then(all{assert(not(ready)),fire(Press)})
 run wrongTranslationRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,clientX:181}))).then(all{assert(not(ready)),fire(Press)})
 run buttonsRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,buttons:1}))).then(all{assert(not(ready)),fire(Press)})
 run wrongLifetimeRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,key:{...original,lifetime:2}}))).then(all{assert(not(ready)),fire(Press)})
 run sessionChangeRevokesTest=init.then(fire(Move(good))).then(fire(Move(second))).then(fire(Change({...original,session:2}))).then(fire(Press)).then(all{assert(not(pressed)),fire(Invalidate)})
 run layoutChangeRevokesTest=init.then(fire(Move(good))).then(fire(Move(second))).then(fire(Change({...original,layout:2}))).then(all{assert(not(ready)),fire(Press)})
 run surfaceChangeRevokesTest=init.then(fire(Move(good))).then(fire(Move(second))).then(fire(Change({...original,surface:2}))).then(all{assert(not(ready)),fire(Press)})
 run basisChangeRevokesTest=init.then(fire(Move(good))).then(fire(Move(second))).then(fire(Change({...original,basis:2}))).then(all{assert(not(ready)),fire(Press)})
 run focusOrDraftChangeRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,unchanged:false}))).then(all{assert(not(ready)),fire(Press)})
 run wrongHitRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,exactHit:false}))).then(all{assert(not(ready)),fire(Press)})
 run nonfiniteRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,finite:false}))).then(all{assert(not(ready)),fire(Press)})
 run outOfBoundsRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,inside:false}))).then(all{assert(not(ready)),fire(Press)})
 run duplicatePointRefusedTest=init.then(fire(Move(good))).then(fire(Move({...good,sequence:2}))).then(all{assert(not(ready)),fire(Press)})
 run touchRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,mouse:false}))).then(all{assert(not(ready)),fire(Press)})
 run nonprimaryRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,primary:false}))).then(all{assert(not(ready)),fire(Press)})
 run invalidationRevokesTest=init.then(fire(Move(good))).then(fire(Move(second))).then(fire(Invalidate)).then(fire(Press)).then(all{assert(not(pressed)),fire(Invalidate)})
 run modifierRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,modifiers:1}))).then(all{assert(not(ready)),fire(Press)})
 run captureRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,clear:false}))).then(all{assert(not(ready)),fire(Press)})
 run oldQueuedTimestampRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,timestamp:0}))).then(all{assert(not(ready)),fire(Press)})
 run unpreparedRefusedTest=init.then(fire(Move(good))).then(fire(Move({...second,prepared:0}))).then(all{assert(not(ready)),fire(Press)})
 run timeOriginReplacementRevokesTest=init.then(fire(Move(good))).then(fire(Move(second))).then(fire(Change({...original,clock:2}))).then(fire(Press)).then(all{assert(not(pressed)),fire(Invalidate)})
}
