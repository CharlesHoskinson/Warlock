module hidden_capture_test {
 import hidden_capture.* from "./hidden_capture"
 pure def trace(es)=es.foldl(initial,(a,e)=>advance(a,e))
 pure val one=List(ValidateCache,CaptureClient,Launch,Returned(true),ObserveCurrent,PublishSlot(0),PublishSlot(1),PublishIdentity,ReturnSource)
 pure val three=one.concat(one).concat(one)
 run three_sources_seed=assert(trace(three.concat(List(FreshFamily,Seed))).seeded)
 run missing_cache_no_launch=assert(not(trace(List(CaptureClient,Launch)).active))
 run missing_raw_no_launch=assert(not(trace(List(ValidateCache,Launch)).active))
 run normal_return_required=assert(not(trace(List(ValidateCache,CaptureClient,Launch,ObserveCurrent,PublishSlot(0))).published))
 run nonzero_no_publish=assert(not(trace(List(ValidateCache,CaptureClient,Launch,Returned(false),ObserveCurrent,PublishSlot(0),PublishSlot(1),PublishIdentity)).published))
 run native_change_refuses=assert(not(trace(List(ValidateCache,CaptureClient,Launch,Returned(true),NativeChange,ObserveCurrent,PublishSlot(0))).published))
 run material_change_refuses=assert(not(trace(List(ValidateCache,CaptureClient,MaterialChange,Launch)).active))
 run slot_order_exact=assert(trace(List(ValidateCache,CaptureClient,Launch,Returned(true),ObserveCurrent,PublishSlot(1))).slots==Set())
 run no_identity_before_slots=assert(not(trace(List(ValidateCache,CaptureClient,Launch,Returned(true),ObserveCurrent,PublishIdentity)).published))
 run no_source_before_publication=assert(trace(List(ValidateCache,CaptureClient,Launch,Returned(true),ObserveCurrent,ReturnSource)).sources==0)
 run active_timeout_retains=assert(trace(List(ValidateCache,CaptureClient,Launch,Timeout,Discard)).active)
 run gone_not_authority=assert(trace(List(ValidateCache,CaptureClient,Launch,Timeout,CloseUnknown,Discard)).quarantined)
 run failed_closed_cleanup=assert(trace(List(ValidateCache,CaptureClient,Launch,Returned(false),Discard)).discarded)
 run deadline_no_seed=assert(not(trace(three.concat(List(Tick(20),FreshFamily,Seed))).seeded))
 run cancel_no_seed=assert(not(trace(three.concat(List(Cancel,FreshFamily,Seed))).seeded))
 run helper_return_not_seed=assert(not(trace(three.append(Seed)).seeded))
 run late_helper_closes_no_seed=assert(not(trace(List(ValidateCache,CaptureClient,Launch,Tick(20),Returned(true),ObserveCurrent,PublishSlot(0),PublishSlot(1),PublishIdentity,ReturnSource,FreshFamily,Seed)).seeded))
 run partial_publication_not_source=assert(trace(List(ValidateCache,CaptureClient,Launch,Returned(true),ObserveCurrent,PublishSlot(0),Fail,ReturnSource)).sources==0)
}
