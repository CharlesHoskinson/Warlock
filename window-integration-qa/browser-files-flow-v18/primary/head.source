{"sha":"24f55f4b7461e81b6aa95a4a91f6f871c9ac675b","node_id":"C_kwDOByyPPdoAKDI0ZjU1ZjRiNzQ2MWU4MWI2YWE5NWE0YTkxZjZmODcxYzlhYzY3NWI","commit":{"author":{"name":"Jonathan Ross","email":"jonross@chromium.org","date":"2026-10-01T21:48:01Z"},"committer":{"name":"Chromium LUCI CQ","email":"chromium-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2026-10-01T21:48:01Z"},"message":"Restore non-volatile x64 registers in SuspendableThreadDelegateWin\n\nhttps://crrev.com/c/7708137 refactored GetRegistersToRewrite() into\nGetRegisters() and SetRegisters(). On Windows x64, 6 of the 9\nnon-volatile registers (R12, R13, R14, R15, Rdi, Rsi) were accidentally\ndropped, leaving only Rbx, Rbp, and Rsp.\n\nWhen a function uses one of the dropped non-volatile registers as its\nUNWIND_INFO FrameRegister (or stores a stack pointer in it), neither\nStackCopierSuspend::CopyStack nor StackCopier::CloneStack rewrote the\nregister to point into the copied/cloned StackBuffer. Consequently,\nRtlVirtualUnwind on the background sampling worker thread could\ndereference a stack address in the resumed target thread's live stack\n(after the frame had unwound or been unmapped) or in an uncloned buffer,\ncausing sporadic STATUS_ACCESS_VIOLATION (0xc0000005) crashes during\nStackSampler::WalkStack.\n\nRestore all 9 non-volatile registers on Windows x64 and add a unit test\nverifying GetRegisters() and SetRegisters() round-trip all expected\nnon-volatile registers.\n\nBug: 473587142, 402749159, 454752444\nChange-Id: I101a9941e2efb919b2324c7ae6580efcd2247dbe\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8482885\nCommit-Queue: Jonathan Ross <jonross@chromium.org>\nReviewed-by: Sean Maher <spvm@chromium.org>\nCr-Commit-Position: refs/heads/main@{#1709431}","tree":{"sha":"2cc5b1e759241811cfc8592e58f8d954d7c36f28","url":"https://api.github.com/repos/chromium/chromium/git/trees/2cc5b1e759241811cfc8592e58f8d954d7c36f28"},"url":"https://api.github.com/repos/chromium/chromium/git/commits/24f55f4b7461e81b6aa95a4a91f6f871c9ac675b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/chromium/chromium/commits/24f55f4b7461e81b6aa95a4a91f6f871c9ac675b","html_url":"https://github.com/chromium/chromium/commit/24f55f4b7461e81b6aa95a4a91f6f871c9ac675b","comments_url":"https://api.github.com/repos/chromium/chromium/commits/24f55f4b7461e81b6aa95a4a91f6f871c9ac675b/comments","author":null,"committer":null,"parents":[{"sha":"1d1838464f15630596dc92e6c989e1bd4f83ae92","url":"https://api.github.com/repos/chromium/chromium/commits/1d1838464f15630596dc92e6c989e1bd4f83ae92","html_url":"https://github.com/chromium/chromium/commit/1d1838464f15630596dc92e6c989e1bd4f83ae92"}],"stats":{"total":92,"additions":88,"deletions":4},"files":[{"sha":"d934fda98048168b51c731ad0245919bcbb7127e","filename":"base/profiler/suspendable_thread_delegate_win.cc","status":"modified","additions":17,"deletions":4,"changes":21,"blob_url":"https://github.com/chromium/chromium/blob/24f55f4b7461e81b6aa95a4a91f6f871c9ac675b/base%2Fprofiler%2Fsuspendable_thread_delegate_win.cc","raw_url":"https://github.com/chromium/chromium/raw/24f55f4b7461e81b6aa95a4a91f6f871c9ac675b/base%2Fprofiler%2Fsuspendable_thread_delegate_win.cc","contents_url":"https://api.github.com/repos/chromium/chromium/contents/base%2Fprofiler%2Fsuspendable_thread_delegate_win.cc?ref=24f55f4b7461e81b6aa95a4a91f6f871c9ac675b","patch":"@@ -9,6 +9,7 @@\n #include <vector>\n \n #include \"base/check.h\"\n+#include \"base/check_op.h\"\n #include \"base/profiler/native_unwinder_win.h\"\n #include \"build/build_config.h\"\n \n@@ -157,7 +158,11 @@ std::vector<uintptr_t> SuspendableThreadDelegateWin::GetRegisters(\n   // Return the set of non-volatile registers.\n   return {\n #if defined(ARCH_CPU_X86_64)\n-      thread_context->Rbx, thread_context->Rbp, thread_context->Rsp\n+      thread_context->R12, thread_context->R13,\n+      thread_context->R14, thread_context->R15,\n+      thread_context->Rdi, thread_context->Rsi,\n+      thread_context->Rbx, thread_context->Rbp,\n+      thread_context->Rsp\n #elif defined(ARCH_CPU_ARM64)\n       thread_context->X19, thread_context->X20, thread_context->X21,\n       thread_context->X22, thread_context->X23, thread_context->X24,\n@@ -172,10 +177,18 @@ void SuspendableThreadDelegateWin::SetRegisters(\n     RegisterContext* thread_context,\n     const std::vector<uintptr_t>& registers) {\n #if defined(ARCH_CPU_X86_64)\n-  thread_context->Rbx = registers[0];\n-  thread_context->Rbp = registers[1];\n-  thread_context->Rsp = registers[2];\n+  CHECK_EQ(registers.size(), 9u);\n+  thread_context->R12 = registers[0];\n+  thread_context->R13 = registers[1];\n+  thread_context->R14 = registers[2];\n+  thread_context->R15 = registers[3];\n+  thread_context->Rdi = registers[4];\n+  thread_context->Rsi = registers[5];\n+  thread_context->Rbx = registers[6];\n+  thread_context->Rbp = registers[7];\n+  thread_context->Rsp = registers[8];\n #elif defined(ARCH_CPU_ARM64)\n+  CHECK_EQ(registers.size(), 13u);\n   thread_context->X19 = registers[0];\n   thread_context->X20 = registers[1];\n   thread_context->X21 = registers[2];"},{"sha":"f90e99f8d836d78cb4074638d880b26d5e386050","filename":"base/profiler/win32_stack_frame_unwinder_unittest.cc","status":"modified","additions":71,"deletions":0,"changes":71,"blob_url":"https://github.com/chromium/chromium/blob/24f55f4b7461e81b6aa95a4a91f6f871c9ac675b/base%2Fprofiler%2Fwin32_stack_frame_unwinder_unittest.cc","raw_url":"https://github.com/chromium/chromium/raw/24f55f4b7461e81b6aa95a4a91f6f871c9ac675b/base%2Fprofiler%2Fwin32_stack_frame_unwinder_unittest.cc","contents_url":"https://api.github.com/repos/chromium/chromium/contents/base%2Fprofiler%2Fwin32_stack_frame_unwinder_unittest.cc?ref=24f55f4b7461e81b6aa95a4a91f6f871c9ac675b","patch":"@@ -12,6 +12,7 @@\n #include \"base/memory/ptr_util.h\"\n #include \"base/memory/raw_ptr.h\"\n #include \"base/profiler/stack_sampling_profiler_test_util.h\"\n+#include \"base/profiler/suspendable_thread_delegate_win.h\"\n #include \"build/build_config.h\"\n #include \"testing/gtest/include/gtest/gtest.h\"\n \n@@ -202,4 +203,74 @@ TEST_F(Win32StackFrameUnwinderTest, FrameBelowTopWithoutUnwindInfo) {\n   }\n }\n \n+// Checks that SuspendableThreadDelegateWin::GetRegisters() and SetRegisters()\n+// round-trip all platform non-volatile registers.\n+TEST_F(Win32StackFrameUnwinderTest,\n+       SuspendableThreadDelegateGetAndSetRegisters) {\n+  SuspendableThreadDelegateWin delegate(\n+      GetSamplingProfilerCurrentThreadToken());\n+  CONTEXT context = {0};\n+#if defined(ARCH_CPU_X86_64)\n+  context.R12 = 1;\n+  context.R13 = 2;\n+  context.R14 = 3;\n+  context.R15 = 4;\n+  context.Rdi = 5;\n+  context.Rsi = 6;\n+  context.Rbx = 7;\n+  context.Rbp = 8;\n+  context.Rsp = 9;\n+  std::vector<uintptr_t> registers = delegate.GetRegisters(&context);\n+  ASSERT_EQ(registers.size(), 9u);\n+  for (size_t i = 0; i < registers.size(); ++i) {\n+    EXPECT_EQ(registers[i], i + 1);\n+    registers[i] += 100;\n+  }\n+  delegate.SetRegisters(&context, registers);\n+  EXPECT_EQ(context.R12, 101u);\n+  EXPECT_EQ(context.R13, 102u);\n+  EXPECT_EQ(context.R14, 103u);\n+  EXPECT_EQ(context.R15, 104u);\n+  EXPECT_EQ(context.Rdi, 105u);\n+  EXPECT_EQ(context.Rsi, 106u);\n+  EXPECT_EQ(context.Rbx, 107u);\n+  EXPECT_EQ(context.Rbp, 108u);\n+  EXPECT_EQ(context.Rsp, 109u);\n+#elif defined(ARCH_CPU_ARM64)\n+  context.X19 = 1;\n+  context.X20 = 2;\n+  context.X21 = 3;\n+  context.X22 = 4;\n+  context.X23 = 5;\n+  context.X24 = 6;\n+  context.X25 = 7;\n+  context.X26 = 8;\n+  context.X27 = 9;\n+  context.X28 = 10;\n+  context.Fp = 11;\n+  context.Lr = 12;\n+  context.Sp = 13;\n+  std::vector<uintptr_t> registers = delegate.GetRegisters(&context);\n+  ASSERT_EQ(registers.size(), 13u);\n+  for (size_t i = 0; i < registers.size(); ++i) {\n+    EXPECT_EQ(registers[i], i + 1);\n+    registers[i] += 100;\n+  }\n+  delegate.SetRegisters(&context, registers);\n+  EXPECT_EQ(context.X19, 101u);\n+  EXPECT_EQ(context.X20, 102u);\n+  EXPECT_EQ(context.X21, 103u);\n+  EXPECT_EQ(context.X22, 104u);\n+  EXPECT_EQ(context.X23, 105u);\n+  EXPECT_EQ(context.X24, 106u);\n+  EXPECT_EQ(context.X25, 107u);\n+  EXPECT_EQ(context.X26, 108u);\n+  EXPECT_EQ(context.X27, 109u);\n+  EXPECT_EQ(context.X28, 110u);\n+  EXPECT_EQ(context.Fp, 111u);\n+  EXPECT_EQ(context.Lr, 112u);\n+  EXPECT_EQ(context.Sp, 113u);\n+#endif\n+}\n+\n }  // namespace base"}]}