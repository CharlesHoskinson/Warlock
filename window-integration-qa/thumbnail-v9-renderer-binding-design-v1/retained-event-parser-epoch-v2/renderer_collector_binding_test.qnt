module renderer_collector_binding_test {
 import renderer_collector_binding.* from "./renderer_collector_binding"
 run genuineNormalCloseAcceptTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,terminal))).then(fire(ConfirmTerminal(goodPackage,terminal))).then(fire(Gates(38,false))).then(fire(AcceptFeature)).then(assert(s.featureAccepted))
 run terminalIdentityDoesNotRequireLiveRegistryTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,terminal))).then(assert(s.terminalRaw and terminal.jobs.size()==0))
 run terminalAloneCannotAuthorizeFeatureTest=init.then(fire(RawTerminal(goodPackage,terminal))).then(fire(Gates(38,false))).then(fire(AcceptFeature)).then(assert(not(s.featureAccepted)))
 run originalElevenGateFailureRemainsFailTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,terminal))).then(fire(ConfirmTerminal(goodPackage,terminal))).then(fire(Gates(11,true))).then(fire(AcceptFeature)).then(assert(not(s.featureAccepted)))
 run laterPassCannotClearOriginalFailureTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,terminal))).then(fire(ConfirmTerminal(goodPackage,terminal))).then(fire(Gates(11,true))).then(fire(Gates(38,false))).then(fire(AcceptFeature)).then(assert(not(s.featureAccepted)))
 run cachedV23ModuleRefusesTest=init.then(fire(Link({...goodPackage,modules:goodPackage.modules.set(1,V23)},live))).then(assert(s.refused))
 run missingNineteenthModuleRefusesTest=init.then(fire(Link({...goodPackage,modules:goodPackage.modules.exclude(Set(19))},live))).then(assert(s.refused))
 run extraTwentiethModuleRefusesTest=init.then(fire(Link({...goodPackage,modules:goodPackage.modules.set(20,V24)},live))).then(assert(s.refused))
 run missingV24FrozenClosureRefusesTest=init.then(fire(Link({...goodPackage,closure:required.exclude(Set(FrozenV24))},live))).then(assert(s.refused))
 run missingV7FrozenClosureRefusesTest=init.then(fire(Link({...goodPackage,closure:required.exclude(Set(FrozenV7))},live))).then(assert(s.refused))
 run missingV7ActualFailureRefusesTest=init.then(fire(Link({...goodPackage,closure:required.exclude(Set(FailedV7))},live))).then(assert(s.refused))
 run missingV8ComponentRefusesTest=init.then(fire(Link({...goodPackage,closure:required.exclude(Set(ComponentV8))},live))).then(assert(s.refused))
 run foreignTransportRefusesTest=init.then(fire(Link(goodPackage,{...live,renderer:{...renderer,transport:29}}))).then(assert(s.refused))
 run foreignLaunchRefusesTest=init.then(fire(Link(goodPackage,{...live,renderer:{...renderer,launch:29}}))).then(assert(s.refused))
 run foreignKeeperRefusesTest=init.then(fire(Link(goodPackage,{...live,renderer:{...renderer,keeper:29}}))).then(assert(s.refused))
 run wrongRegisteredChildRefusesTest=init.then(fire(Link(goodPackage,{...live,child:29}))).then(assert(s.refused))
 run canonicalPopenWrongPIDRefusesTest=init.then(fire(Link(goodPackage,{...live,wrapperPID:Integer(999)}))).then(assert(s.refused))
 run processSubclassRefusesTest=init.then(fire(Link(goodPackage,{...live,processClass:PopenSubclass}))).then(assert(s.refused))
 run registryBooleanDeviceAliasRefusesTest=init.then(fire(Link(goodPackage,{...live,registryOwner:{...metadata,device:Boolean(true)}}))).then(assert(s.refused))
 run launchFloatDeviceAliasRefusesTest=init.then(fire(Link(goodPackage,{...live,launchOwner:{...metadata,device:Decimal(1)}}))).then(assert(s.refused))
 run actorBooleanAliasRefusesTest=init.then(fire(Link(goodPackage,{...live,renderer:{...renderer,actor:Boolean(true)}}))).then(assert(s.refused))
 run outstandingSecondSameActorJobRefusesTest=init.then(fire(Link(goodPackage,{...live,ownJobs:Set(19,29)}))).then(assert(s.refused))
 run changedBindingAfterRawDiskRefusesTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,{...live,renderer:{...renderer,binding:29}}))).then(assert(s.refused))
 run wrongNewCallbackRoleRefusesTest=init.then(fire(Link({...goodPackage,callbacks:goodCallbacks.set(1,{function:2,owner:7,source:V24})},live))).then(assert(s.refused))
 run genuineNewCallbackForeignOwnerRefusesTest=init.then(fire(Link({...goodPackage,callbacks:goodCallbacks.set(2,{function:2,owner:29,source:V24})},live))).then(assert(s.refused))
 run staticCallbackBoundOwnerRefusesTest=init.then(fire(Link({...goodPackage,callbacks:goodCallbacks.set(4,{function:4,owner:7,source:V24})},live))).then(assert(s.refused))
 run nonzeroRendererExitRefusesTerminalTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,{...terminal,returncode:Integer(1)}))).then(assert(s.refused))
 run floatZeroExitRefusesTerminalTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,{...terminal,returncode:Decimal(0)}))).then(assert(s.refused))
 run selectedJobStillRegisteredRefusesTerminalTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,{...terminal,jobs:Set(19)}))).then(assert(s.refused))
 run launchNotClosedRefusesTerminalTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,{...terminal,launchClosed:false}))).then(assert(s.refused))
 run changedTerminalBindingRefusesTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,{...terminal,renderer:{...renderer,owner:{...metadata,start:Integer(999)}}}))).then(assert(s.refused))
 run changedTerminalAfterDiskRefusesTest=init.then(fire(Link(goodPackage,live))).then(fire(ConfirmLive(goodPackage,live))).then(fire(RawTerminal(goodPackage,terminal))).then(fire(ConfirmTerminal(goodPackage,{...terminal,renderer:{...renderer,process:29}}))).then(assert(s.refused))
}
