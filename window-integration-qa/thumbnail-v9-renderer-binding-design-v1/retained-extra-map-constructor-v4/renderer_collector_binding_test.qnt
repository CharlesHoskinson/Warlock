module renderer_collector_binding_test {
 import renderer_collector_binding.* from "./renderer_collector_binding"
 action check(v:bool):bool=all{assert(v),s'=s}
 run genuineNormalCloseAcceptTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:terminal}))).then(fire(ConfirmTerminal({package:goodPackage,observation:terminal}))).then(fire(Gates({count:38,failed:false}))).then(acceptFeature).then(check(s.featureAccepted))
 run terminalIdentityDoesNotRequireLiveRegistryTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:terminal}))).then(check(s.terminalRaw and terminal.jobs.size()==0))
 run terminalAloneCannotAuthorizeFeatureTest=init.then(fire(RawTerminal({package:goodPackage,observation:terminal}))).then(fire(Gates({count:38,failed:false}))).then(acceptFeature).then(check(s.featureAccepted==false))
 run originalElevenGateFailureRemainsFailTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:terminal}))).then(fire(ConfirmTerminal({package:goodPackage,observation:terminal}))).then(fire(Gates({count:11,failed:true}))).then(acceptFeature).then(check(s.featureAccepted==false))
 run laterPassCannotClearOriginalFailureTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:terminal}))).then(fire(ConfirmTerminal({package:goodPackage,observation:terminal}))).then(fire(Gates({count:11,failed:true}))).then(fire(Gates({count:38,failed:false}))).then(acceptFeature).then(check(s.featureAccepted==false))
 run cachedV23ModuleRefusesTest=init.then(fire(Link({package:{...goodPackage,modules:goodPackage.modules.set(1,V23)},observation:live}))).then(check(s.refused))
 run missingNineteenthModuleRefusesTest=init.then(fire(Link({package:{...goodPackage,modules:moduleKeys.exclude(Set(19)).mapBy(_=>V24)},observation:live}))).then(check(s.refused))
 run extraTwentiethModuleRefusesTest=init.then(fire(Link({package:{...goodPackage,modules:goodPackage.modules.set(20,V24)},observation:live}))).then(check(s.refused))
 run missingV24FrozenClosureRefusesTest=init.then(fire(Link({package:{...goodPackage,closure:required.exclude(Set(FrozenV24))},observation:live}))).then(check(s.refused))
 run missingV7FrozenClosureRefusesTest=init.then(fire(Link({package:{...goodPackage,closure:required.exclude(Set(FrozenV7))},observation:live}))).then(check(s.refused))
 run missingV7ActualFailureRefusesTest=init.then(fire(Link({package:{...goodPackage,closure:required.exclude(Set(FailedV7))},observation:live}))).then(check(s.refused))
 run missingV8ComponentRefusesTest=init.then(fire(Link({package:{...goodPackage,closure:required.exclude(Set(ComponentV8))},observation:live}))).then(check(s.refused))
 run foreignTransportRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,renderer:{...renderer,transport:29}}}))).then(check(s.refused))
 run foreignLaunchRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,renderer:{...renderer,launch:29}}}))).then(check(s.refused))
 run foreignKeeperRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,renderer:{...renderer,keeper:29}}}))).then(check(s.refused))
 run wrongRegisteredChildRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,child:29}}))).then(check(s.refused))
 run canonicalPopenWrongPIDRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,wrapperPID:Integer(999)}}))).then(check(s.refused))
 run processSubclassRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,processClass:PopenSubclass}}))).then(check(s.refused))
 run registryBooleanDeviceAliasRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,registryOwner:{...metadata,device:Boolean(true)}}}))).then(check(s.refused))
 run launchFloatDeviceAliasRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,launchOwner:{...metadata,device:Decimal(1)}}}))).then(check(s.refused))
 run actorBooleanAliasRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,renderer:{...renderer,actor:Boolean(true)}}}))).then(check(s.refused))
 run outstandingSecondSameActorJobRefusesTest=init.then(fire(Link({package:goodPackage,observation:{...live,ownJobs:Set(19,29)}}))).then(check(s.refused))
 run changedBindingAfterRawDiskRefusesTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:{...live,renderer:{...renderer,binding:29}}}))).then(check(s.refused))
 run wrongNewCallbackRoleRefusesTest=init.then(fire(Link({package:{...goodPackage,callbacks:goodCallbacks.set(1,{function:2,owner:7,source:V24})},observation:live}))).then(check(s.refused))
 run genuineNewCallbackForeignOwnerRefusesTest=init.then(fire(Link({package:{...goodPackage,callbacks:goodCallbacks.set(2,{function:2,owner:29,source:V24})},observation:live}))).then(check(s.refused))
 run staticCallbackBoundOwnerRefusesTest=init.then(fire(Link({package:{...goodPackage,callbacks:goodCallbacks.set(4,{function:4,owner:7,source:V24})},observation:live}))).then(check(s.refused))
 run nonzeroRendererExitRefusesTerminalTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:{...terminal,returncode:Integer(1)}}))).then(check(s.refused))
 run floatZeroExitRefusesTerminalTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:{...terminal,returncode:Decimal(0)}}))).then(check(s.refused))
 run selectedJobStillRegisteredRefusesTerminalTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:{...terminal,jobs:Set(19)}}))).then(check(s.refused))
 run launchNotClosedRefusesTerminalTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:{...terminal,launchClosed:false}}))).then(check(s.refused))
 run changedTerminalBindingRefusesTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:{...terminal,renderer:{...renderer,owner:{...metadata,start:Integer(999)}}}}))).then(check(s.refused))
 run changedTerminalAfterDiskRefusesTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:terminal}))).then(fire(ConfirmTerminal({package:goodPackage,observation:{...terminal,renderer:{...renderer,process:29}}}))).then(check(s.refused))
 run unknownOtherJobPreventsTerminalTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:{...terminal,jobs:Set(29)}}))).then(check(s.refused))
 run keeperNotNormallyClosedPreventsTerminalTest=init.then(fire(Link({package:goodPackage,observation:live}))).then(fire(ConfirmLive({package:goodPackage,observation:live}))).then(fire(RawTerminal({package:goodPackage,observation:{...terminal,keeperClosed:false}}))).then(check(s.refused))
}
