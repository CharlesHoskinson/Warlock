module keyboard_focus_test {
  import keyboard_focus.* from "./keyboard_focus"
  run promptTabTrapAndBacktabTest=init.then(fire(Prompt)).then(fire(Tab(false))).then(all{assert(focus==6),fire(Tab(false))})
    .then(all{assert(focus==7),fire(Tab(false))}).then(all{assert(focus==5),fire(Tab(true))}).then(all{assert(focus==7),fire(Cancel)})
  run listAndGridRovingFocusTest=init.then(fire(Arrow(1))).then(all{assert(cur==1 and focus==8),fire(Layout("grid"))})
    .then(fire(Arrow(1))).then(all{assert(cur==3 and focus==10),fire(Arrow(-1))}).then(all{assert(cur==1),fire(Cancel)})
  run sidebarHomeCapturedPathActionTest=init.then(fire(Sidebar)).then(fire(Press({node:3,generation:0,path:3})))
    .then(all{assert(actions==[3]),fire(Home)}).then(fire(Press({node:4,generation:0,path:4}))).then(all{assert(actions==[3,4]),fire(Cancel)})
  run disabledAndHiddenNodeRefuseTest=init.then(fire(Disable(1))).then(fire(Press({node:1,generation:0,path:0})))
    .then(all{assert(actions==[]),fire(Hide(2))}).then(fire(Press({node:2,generation:0,path:0}))).then(all{assert(actions==[]),fire(Cancel)})
  run rebuiltRetainedNodeRefuseTest=init.then(fire(Rebuild)).then(fire(Press({node:2,generation:0,path:0})))
    .then(all{assert(actions==[]),fire(Press({node:2,generation:1,path:0}))}).then(all{assert(actions==[0]),fire(Cancel)})
  run textEditingPrecedesWindowArrowsTest=init.then(fire(Edit("path"))).then(fire(Arrow(1))).then(all{assert(cur==0 and focus==5),fire(Edit("filter"))})
    .then(fire(Arrow(1))).then(all{assert(cur==1 and focus==5),fire(Cancel)})
  run samePidReloadRetainsRovingFocusTest=init.then(fire(Arrow(1))).then(fire(Reload))
    .then(all{assert(pid==667402 and cur==1 and focus==8),fire(Prompt)}).then(fire(Tab(false))).then(fire(Reload))
    .then(all{assert(pid==667402 and focus==6 and prompt),fire(Cancel)})
  run promptRejectsBackgroundCommandsTest=init.then(fire(Prompt)).then(fire(Sidebar)).then(fire(Home)).then(fire(Arrow(1))).then(fire(Edit("path"))).then(fire(Layout("grid")))
    .then(fire(Press({node:4,generation:0,path:4}))).then(all{assert(focus==5 and prompt and not(sidebar) and cur==0 and layout=="list" and editing=="prompt" and actions==[]),fire(Cancel)})
  run promptAcceptsOnlyActualPromptNodesTest=init.then(fire(Prompt)).then(fire(Press({node:7,generation:0,path:0})))
    .then(fire(Press({node:8,generation:0,path:8}))).then(fire(Press({node:-1,generation:0,path:-1}))).then(all{assert(actions==[0]),fire(Cancel)})
  run unmappedWindowRefusesRetainedActionTest=init.then(fire(Unmap)).then(fire(Press({node:1,generation:0,path:1})))
    .then(all{assert(actions==[] and not(mapped)),fire(MapWindow)}).then(fire(Press({node:1,generation:0,path:1}))).then(all{assert(actions==[1]),fire(Cancel)})
  run selectedFileCannotRewriteCapturedHomePathTest=init.then(fire(Arrow(1))).then(fire(Home)).then(fire(Press({node:4,generation:0,path:1})))
    .then(all{assert(actions==[]),fire(Press({node:4,generation:0,path:4}))}).then(all{assert(actions==[4]),fire(Cancel)})
  run reboundHomePeerRetiresOldIdentityTest=init.then(fire(Arrow(1))).then(fire(Home)).then(fire(Rebind({node:4,path:7})))
    .then(fire(Press({node:4,generation:0,path:4}))).then(all{assert(actions==[]),fire(Press({node:4,generation:1,path:7}))}).then(all{assert(actions==[7]),fire(Cancel)})
  run promptPayloadKeepsCapturedFileIdentityTest=init.then(fire(Arrow(1))).then(fire(Prompt)).then(fire(Rebind({node:2,path:3})))
    .then(fire(Press({node:7,generation:0,path:3}))).then(all{assert(actions==[]),fire(Press({node:7,generation:0,path:1}))}).then(all{assert(actions==[1]),fire(Cancel)})
  run retainedVisibleFilePeerIndependentOfSelectionTest=init.then(fire(Arrow(1))).then(fire(Press({node:2,generation:0,path:0})))
    .then(all{assert(cur==1 and actions==[0]),fire(Press({node:8,generation:0,path:1}))}).then(all{assert(actions==[0,1]),fire(Cancel)})
  run currentEpochStillActionableAfterManyRebuildsTest=init.then(fire(Rebuild)).then(fire(Rebuild)).then(fire(Rebuild)).then(fire(Rebuild))
    .then(fire(Press({node:2,generation:4,path:0}))).then(fire(Press({node:2,generation:3,path:0}))).then(all{assert(actions==[0]),fire(Cancel)})
  run deferredReloadRestoresLogicalFocusAfterMaterializationTest=init.then(fire(Arrow(1))).then(fire(DeferReload))
    .then(all{assert(focus==0 and pendingFocus),fire(Materialize)}).then(all{assert(focus==8 and not(pendingFocus)),fire(Cancel)})
  run newerToolbarFocusCancelsDeferredReloadTest=init.then(fire(Arrow(1))).then(fire(DeferReload)).then(fire(Focus(1))).then(fire(Materialize))
    .then(all{assert(focus==1 and not(pendingFocus)),fire(Cancel)})
  run newerTabInputCancelsDeferredReloadTest=init.then(fire(Arrow(1))).then(fire(DeferReload)).then(fire(Tab(false))).then(fire(Materialize))
    .then(all{assert(focus==1 and not(pendingFocus)),fire(Cancel)})
  run hiddenWindowCannotRestoreDeferredFocusTest=init.then(fire(Arrow(1))).then(fire(DeferReload)).then(fire(Unmap)).then(fire(Materialize))
    .then(all{assert(focus==0 and not(pendingFocus)),fire(Cancel)})
  run supersedingReloadCancelsOldDeferredRequestTest=init.then(fire(Arrow(1))).then(fire(DeferReload)).then(fire(Reload)).then(fire(Materialize))
    .then(all{assert(focus==0 and not(pendingFocus)),fire(Cancel)})
  run newerModalPromptCancelsDeferredBackgroundFocusTest=init.then(fire(Arrow(1))).then(fire(DeferReload)).then(fire(Prompt)).then(fire(Materialize))
    .then(all{assert(prompt and focus==5 and not(pendingFocus)),fire(Cancel)})
  run focusedListArrowSelectsItsPathTest=init.then(fire(Arrow(1))).then(fire(Arrow(1))).then(all{assert(cur==2 and focus==9 and selected==Set(2)),fire(Prompt)}).then(all{assert(promptPath==2),fire(Cancel)})
  run focusedGridArrowSelectsItsPathTest=init.then(fire(Layout("grid"))).then(fire(Arrow(1))).then(all{assert(cur==2 and focus==9 and selected==Set(2)),fire(Prompt)}).then(all{assert(promptPath==2),fire(Cancel)})
  run focusingRetainedPeerDoesNotRewriteSelectionTest=init.then(fire(Arrow(1))).then(fire(Focus(2))).then(all{assert(cur==0 and selected==Set(1) and focus==2),fire(Press({node:2,generation:0,path:0}))}).then(all{assert(actions==[0] and selected==Set(1)),fire(Cancel)})
  run focusedShiftArrowKeepsRangeTest=init.then(fire(Arrow(1))).then(fire(Arrow(1))).then(fire(ShiftArrow(-1))).then(all{assert(cur==1 and selected==Set(1,2)),fire(Cancel)})
  run rawHiddenToggleRefusesSelectionTest=init.then(fire(Hide(2))).then(fire(Toggle({node:2,generation:0,path:0}))).then(all{assert(selected==Set()),fire(Cancel)})
  run rawModalToggleRefusesSelectionTest=init.then(fire(Prompt)).then(fire(Toggle({node:8,generation:0,path:1}))).then(all{assert(selected==Set() and prompt),fire(Cancel)})
  run visibleToggleKeepsCtrlClickSemanticsTest=init.then(fire(Toggle({node:8,generation:0,path:1}))).then(all{assert(selected==Set(1) and cur==1 and focus==0),fire(Toggle({node:8,generation:0,path:1}))}).then(all{assert(selected==Set()),fire(Cancel)})
  run deferredToggleFocusCancelsRestoreTest=init.then(fire(Arrow(1))).then(fire(DeferReload)).then(fire(Toggle({node:2,generation:0,path:0}))).then(fire(Materialize)).then(all{assert(focus==0 and not(restoreAllowed)),fire(Cancel)})
}
