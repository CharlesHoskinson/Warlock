+-- Minimize snapshots the current rectangle rather than rolling back to press.
+-- Native retirement emits only this event, after clearing the exact controller.
+function hypr_snap_drag_retire_current(address)
+  if drag_address ~= address then return end
+  drag_source, drag_address, drag_normal, release_normal, shake = nil, nil, nil, nil, nil
+  if snapbar_open then hl.exec_cmd(controls_bin .. "hypr-window-menu hide") end
+  snapbar_open = false
+  skip_address = address
+  last = {}
+end
