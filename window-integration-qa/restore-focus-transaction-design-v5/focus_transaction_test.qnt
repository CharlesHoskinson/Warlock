module focus_transaction_test {
 import focus_transaction.* from "./focus_transaction"
 pure val initial={phase:Idle,current:true,material:true,native:true,output:true,now:0,deadline:20,guarded:false,next:0,attempted:[],completed:[],active:false,exited:false,gone:false,uncertain:false,closed:false,seeded:false,justEffect:false,justSeed:false,admitted:false,refreshRunning:Set(),refreshDone:Set(),refreshStop:false,pairGuarded:false,pairMaterial:false,sent:0,acknowledged:0,requestOpen:false,originalReady:false}
 pure def trace(es)=es.foldl(initial,(a,e)=>advance(a,e))
 pure val opened=List(Prepare,Register,Gate,PairGuard,SendPair)
 pure val actions=List(Guard,Effect(true),Guard,Effect(true),Receipt({shape:true,nonce:true,count:2}),PairGuard,SendPair,Guard,Effect(true),Guard,Effect(true),Receipt({shape:true,nonce:true,count:4}),PairGuard,SendPair,Guard,Effect(true),Guard,Effect(true))
 pure val completeRefresh=List(StartRefresh(0),StartRefresh(1),StartRefresh(2),FinishRefresh({index:2,ok:true}),FinishRefresh({index:0,ok:true}),FinishRefresh({index:1,ok:true}))
 pure val completed=opened.concat(actions).concat(List(Receipt({shape:true,nonce:true,count:6}),Exit,Gone,Confirm))
 run positive_six=assert(trace(completed).closed)
 run seed_complete=assert(trace(completed.concat(completeRefresh).concat(List(OriginalPipelineReady,Seed))).seeded)
 run guard_required=assert(trace(opened.append(Effect(true))).next==0)
 run material_before_prepare=assert(trace(List(Material,Prepare)).phase==Idle)
 run material_before_gate=assert(trace(List(Prepare,Register,Material,Gate)).phase==Refused)
 run lifetime_before_gate=assert(trace(List(Prepare,Register,Native,Gate)).phase==Refused)
 run output_before_gate=assert(trace(List(Prepare,Register,Output,Gate)).phase==Refused)
 run expiry_before_gate=assert(trace(List(Prepare,Register,Tick(20),Gate)).phase==Refused)
 run cancel_before_prepare=assert(trace(List(Cancel,Prepare)).phase==Idle)
 run cancel_atomic_deferred=assert(trace(opened.append(Cancel)).current)
 run first_partial=assert(trace(opened.concat(List(Guard,Effect(false),Exit,Gone,Confirm))).uncertain)
 run middle_partial=assert(trace(opened.concat(List(Guard,Effect(true),Guard,Effect(false),Guard,Effect(true)))).next==2)
 run guard_material_change=assert(trace(opened.concat(List(Guard,Effect(true),Guard,Effect(true),Receipt({shape:true,nonce:true,count:2}),Material,PairGuard))).phase==Quarantined)
 run guard_lifetime_change=assert(trace(opened.concat(List(Guard,Effect(true),Native,Guard))).phase==Quarantined)
 run guard_output_change=assert(trace(opened.concat(List(Guard,Effect(true),Output,Guard))).phase==Quarantined)
 run zero_exit_no_receipt=assert(not(trace(opened.concat(actions).concat(List(Exit,Gone,Confirm))).closed))
 run missing_receipt=assert(trace(opened.concat(List(Receipt({shape:false,nonce:true,count:0}),Exit,Gone,Confirm))).uncertain)
 run wrong_nonce=assert(trace(opened.concat(actions).append(Receipt({shape:true,nonce:false,count:6}))).uncertain)
 run wrong_count=assert(trace(opened.concat(actions).append(Receipt({shape:true,nonce:true,count:5}))).uncertain)
 run malformed_receipt=assert(trace(opened.concat(actions).append(Receipt({shape:false,nonce:true,count:6}))).uncertain)
 run source_changed_post_receipt=assert(trace(opened.concat(actions).concat(List(Receipt({shape:true,nonce:true,count:6}),Material,Exit,Gone,Confirm))).uncertain)
 run unknown_gone_not_safe=assert(not(trace(opened.concat(List(Guard,Effect(false),Exit,Gone,Confirm,Seed))).seeded))
 run expiry_after_exact_receipt_normal_close=assert(trace(opened.concat(actions).concat(List(Receipt({shape:true,nonce:true,count:6}),Tick(20),Exit,Gone,Confirm))).closed)
 run expiry_inside_atomic_no_seed=assert(not(trace(opened.concat(List(Tick(20))).concat(actions).concat(List(Receipt({shape:true,nonce:true,count:6}),Exit,Gone,Confirm,Seed))).seeded))
 run expiry_after_normal_no_seed=assert(not(trace(completed.concat(List(Tick(20),Seed))).seeded))
 run no_effect_parallelism=assert(trace(opened.concat(List(Guard,Effect(true),Effect(true)))).attempted==List(0))
 run no_more_than_six=assert(trace(completed.concat(actions)).next==6)
 run deadline_not_reset=assert(trace(opened.concat(List(Tick(20),Prepare,Register,Gate))).deadline==20)
 run three_real_helpers=assert(trace(completed.concat(completeRefresh)).refreshDone==Set(0,1,2))
 run no_fourth_helper=assert(trace(completed.concat(List(StartRefresh(0),StartRefresh(1),StartRefresh(2),StartRefresh(3)))).refreshRunning.size()==3)
 run no_duplicate_helper=assert(trace(completed.concat(List(StartRefresh(0),StartRefresh(0)))).refreshRunning.size()==1)
 run no_helper_after_expiry=assert(trace(completed.concat(List(Tick(20),StartRefresh(0)))).refreshRunning.size()==0)
 run no_seed_before_drain=assert(not(trace(completed.concat(List(StartRefresh(0),Seed))).seeded))
 run helper_failure_latched=assert(trace(completed.concat(List(StartRefresh(0),StartRefresh(1),FinishRefresh({index:0,ok:false}),FinishRefresh({index:1,ok:true}),StartRefresh(2)))).refreshStop)
 run late_helper_drains=assert(trace(completed.concat(List(StartRefresh(0),Tick(20),FinishRefresh({index:0,ok:true})))).refreshRunning.size()==0)
 run cancellation_drains_no_seed=assert(not(trace(completed.concat(List(StartRefresh(0),Cancel,FinishRefresh({index:0,ok:true}),Seed))).seeded))
 run no_send_without_pair_guard=assert(trace(List(Prepare,Register,Gate,SendPair)).sent==0)
 run no_second_send_before_receipt=assert(trace(opened.append(SendPair)).sent==1)
 run wrong_first_prefix=assert(trace(opened.concat(List(Guard,Effect(true),Guard,Effect(true),Receipt({shape:true,nonce:true,count:4})))).uncertain)
 run duplicate_prefix_refused=assert(trace(opened.concat(List(Guard,Effect(true),Guard,Effect(true),Receipt({shape:true,nonce:true,count:2}),Receipt({shape:true,nonce:true,count:2})))).uncertain)
 run receipt_before_effects=assert(trace(opened.append(Receipt({shape:true,nonce:true,count:2}))).uncertain)
 run exact_prefix_gate=assert(trace(opened.concat(List(Guard,Effect(true),Guard,Effect(true),Receipt({shape:true,nonce:true,count:2}),PairGuard,SendPair))).sent==2)
 run stale_source_before_next_pair=assert(trace(opened.concat(List(Guard,Effect(true),Guard,Effect(true),Receipt({shape:true,nonce:true,count:2}),Material,PairGuard,SendPair))).sent==1)
 run late_receipt_refused=assert(trace(opened.concat(actions).concat(List(Tick(20),Receipt({shape:true,nonce:true,count:6})))).uncertain)
 run refresh_alone_no_seed=assert(not(trace(completed.concat(completeRefresh).append(Seed)).seeded))
}


