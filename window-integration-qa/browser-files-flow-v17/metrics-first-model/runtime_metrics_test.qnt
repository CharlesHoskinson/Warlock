module runtime_metrics_test {
 import runtime_metrics.* from "./runtime_metrics"
 run exactRuntimeDataTest=init.then(capture(good)).then(verify(good)).then(confirm(good)).then(all {assert(inputUsable and allProps),idle})
 run beforeOnlyRefusedTest=init.then(capture(good)).then(all {assert(not(inputUsable) and allProps),idle})
 run missingDiskConfirmationTest=init.then(capture(good)).then(verify(good)).then(all {assert(accepted and not(inputUsable) and allProps),idle})
 run directConfirmationRefusedTest=init.then(confirm(good)).then(all {assert(not(inputUsable) and allProps),idle})
 run lifetimeReplacementRefusedTest=init.then(capture(good)).then(verify(good.with("lifetime",2))).then(all {assert(not(accepted) and allProps),idle})
 run laterReplacementInvalidatesTest=init.then(capture(good)).then(verify(good)).then(confirm(good.with("lifetime",2))).then(all {assert(not(inputUsable) and not(accepted) and allProps),idle})
 run duplicateFdRefusedTest=init.then(capture(good.with("fdCount",2))).then(verify(good)).then(all {assert(not(accepted) and allProps),idle})
 run readOnlyFdRefusedTest=init.then(capture(good.with("fdAccess",0))).then(all {assert(not(accepted) and allProps),idle})
 run wrongModeRefusedTest=init.then(capture(good.with("mode",256))).then(all {assert(not(accepted) and allProps),idle})
 run specialModeRefusedTest=init.then(capture(good.with("mode",4480))).then(all {assert(not(accepted) and allProps),idle})
 run linkedDiskRefusedTest=init.then(capture(good.with("nlink",1))).then(all {assert(not(accepted) and allProps),idle})
 run executableAliasRefusedTest=init.then(capture(good.with("noExecAlias",false))).then(all {assert(not(accepted) and allProps),idle})
 run executableMappingRefusedTest=init.then(capture(good.with("permissions","rwxp"))).then(all {assert(not(accepted) and allProps),idle})
 run wrongProfileRefusedTest=init.then(capture(good.with("profile",false))).then(all {assert(not(accepted) and allProps),idle})
 run wrongFilenameRefusedTest=init.then(capture(good.with("filename",false))).then(all {assert(not(accepted) and allProps),idle})
 run unownedBrowserRefusedTest=init.then(capture(good.with("owner",false))).then(all {assert(not(accepted) and allProps),idle})
 run unpinnedSourceRefusedTest=init.then(capture(good.with("source",false))).then(all {assert(not(accepted) and allProps),idle})
 run wrongSizeRefusedTest=init.then(capture(good.with("size",4194305))).then(all {assert(not(accepted) and allProps),idle})
 run wrongRangeRefusedTest=init.then(capture(good.with("offset",4096))).then(all {assert(not(accepted) and allProps),idle})
 run staleSnapshotRefusedTest=init.then(capture(good.with("currentSnapshot",false))).then(all {assert(not(accepted) and allProps),idle})
 run invalidationRemovesAuthorityTest=init.then(capture(good)).then(verify(good)).then(confirm(good)).then(invalidate).then(all {assert(not(inputUsable) and not(accepted) and allProps),idle})
}
