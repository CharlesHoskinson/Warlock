module helper_failure_drain_test {
 import helper_failure_drain.* from "./helper_failure_drain"
 action check(v:bool):bool=all{assert(v),s'=s}
 action start=fire(Start({id:1,authorized:true}))
 action terminal=fire(Terminal({id:1,normal:true,identity:true}))
 action closed=terminal.then(fire(Gone(1)))
 action failed=init.then(fire(Begin)).then(start).then(fire(Check))
 run originalLiveJobCounterexampleTest=failed.then(check(s.firstError and s.starts==Set(1) and s.terminals==Set() and not(s.cleanupNormal)))
 run normalDrainStillRaisesOriginalTest=failed.then(closed).then(fire(Archive)).then(fire(Finish)).then(check(s.cleanupNormal and s.originalRaised and not(s.campaignAccepted)and allProps))
 run laterCountCannotEraseFirstErrorTest=failed.then(fire(Counts(true))).then(closed).then(fire(Archive)).then(fire(Finish)).then(check(s.originalRaised and s.errorOrdinal==1 and not(s.campaignAccepted)))
 run pendingTerminalCannotAcceptCleanupTest=failed.then(fire(Archive)).then(check(not(s.cleanupNormal)))
 run liveWrapperCannotAcceptCleanupTest=failed.then(terminal).then(fire(Archive)).then(check(not(s.cleanupNormal)))
 run wrongLifetimeCannotCloseTest=failed.then(fire(Gone(2))).then(terminal).then(fire(Archive)).then(check(not(s.cleanupNormal)))
 run nonzeroTerminalRefusesTest=failed.then(fire(Terminal({id:1,normal:false,identity:true}))).then(fire(Gone(1))).then(fire(Archive)).then(check(s.unsafe and not(s.cleanupNormal)))
 run mismatchedTerminalRefusesTest=failed.then(fire(Terminal({id:1,normal:true,identity:false}))).then(fire(Gone(1))).then(fire(Archive)).then(check(s.unsafe and not(s.cleanupNormal)))
 run unknownAuthorityRefusesTest=failed.then(fire(Unknown)).then(closed).then(fire(Archive)).then(check(not(s.cleanupNormal)and s.unsafe))
 run duplicateRegistrationRefusesTest=failed.then(start).then(closed).then(fire(Archive)).then(check(s.unsafe and not(s.cleanupNormal)))
 run foreignRegistrationRefusesTest=failed.then(fire(Start({id:2,authorized:false}))).then(closed).then(fire(Archive)).then(check(s.unsafe and not(s.cleanupNormal)))
 run extraTerminalRefusesTest=failed.then(closed).then(terminal).then(fire(Archive)).then(check(s.unsafe and not(s.cleanupNormal)))
 run terminalWithoutStartRefusesTest=failed.then(fire(Terminal({id:2,normal:true,identity:true}))).then(closed).then(fire(Archive)).then(check(s.unsafe and not(s.cleanupNormal)))
 run deadlineNeverResetsAfterFailureTest=failed.then(fire(Tick(9))).then(fire(Begin)).then(check(s.now==9 and s.deadline==10))
 run exactDeadlineNoNormalDrainTest=failed.then(closed).then(fire(Tick(10))).then(fire(Archive)).then(fire(Finish)).then(check(s.originalRaised and not(s.cleanupNormal)))
 run clockAdvancesUnderSnapshotLockTest=failed.then(fire(SnapshotLock)).then(fire(Tick(10))).then(closed).then(fire(SnapshotUnlock)).then(fire(Archive)).then(check(s.now==10 and not(s.cleanupNormal)))
 run expiredLockAcquisitionCannotEnterTest=failed.then(fire(Tick(10))).then(fire(SnapshotLock)).then(check(not(s.locked)))
 run archiveRequiredBeforeRaiseTest=failed.then(closed).then(fire(Finish)).then(check(s.phase==Draining and not(s.originalRaised)))
 run snapshotLockCannotCoverWaitFinishTest=failed.then(fire(SnapshotLock)).then(closed).then(fire(Archive)).then(fire(Finish)).then(check(s.phase==Draining and not(s.archived)))
 run completeOriginalWorkloadStillPassesTest=init.then(fire(Begin)).then(start).then(fire(Counts(true))).then(fire(Check)).then(closed).then(fire(Archive)).then(fire(Finish)).then(check(s.campaignAccepted and not(s.firstError)and allProps))
 run incompleteOriginalWorkloadNeverPassesTest=init.then(fire(Begin)).then(fire(Check)).then(fire(Archive)).then(fire(Finish)).then(check(s.originalRaised and not(s.campaignAccepted)))
 run unsafeCannotBeClearedByLaterClosureTest=failed.then(fire(Unknown)).then(closed).then(fire(Counts(true))).then(fire(Archive)).then(fire(Finish)).then(check(s.unsafe and s.originalRaised and not(s.campaignAccepted)))
 run lateInitialEntryUsesOneOriginalBudgetTest=init.then(fire(Tick(3))).then(fire(Begin)).then(fire(Tick(4))).then(fire(Begin)).then(check(s.begunAt==3 and s.deadline==13 and s.now==7 and allProps))
}
