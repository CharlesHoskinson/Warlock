module focus_transaction_test {
 import focus_transaction.* from "./focus_transaction"
 pure val initial={phase:Idle,current:true,material:true,native:true,output:true,now:0,deadline:20,guarded:false,next:0,attempted:[],completed:[],active:false,exited:false,gone:false,uncertain:false,closed:false,seeded:false,justEffect:false,justSeed:false,admitted:false}
 pure def run(es)=es.foldl(initial,(a,e)=>advance(a,e))
 pure val opened=List(Prepare,Register,Gate)
 pure val actions=List(Guard,Effect(true),Guard,Effect(true),Guard,Effect(true),Guard,Effect(true),Guard,Effect(true),Guard,Effect(true))
 pure val completed=opened.concat(actions).concat(List(Receipt({shape:true,nonce:true,count:6}),Exit,Gone,Confirm))
 run positive_six=assert(run(completed).closed)
 run seed_complete=assert(run(completed.append(Seed)).seeded)
 run guard_required=assert(run(opened.append(Effect(true))).next==0)
 run material_before_prepare=assert(run(List(Material,Prepare)).phase==Idle)
 run material_before_gate=assert(run(List(Prepare,Register,Material,Gate)).phase==Refused)
 run lifetime_before_gate=assert(run(List(Prepare,Register,Native,Gate)).phase==Refused)
 run output_before_gate=assert(run(List(Prepare,Register,Output,Gate)).phase==Refused)
 run expiry_before_gate=assert(run(List(Prepare,Register,Tick(20),Gate)).phase==Refused)
 run cancel_before_prepare=assert(run(List(Cancel,Prepare)).phase==Idle)
 run cancel_atomic_deferred=assert(run(opened.append(Cancel)).current)
 run first_partial=assert(run(opened.concat(List(Guard,Effect(false),Exit,Gone,Confirm))).uncertain)
 run middle_partial=assert(run(opened.concat(List(Guard,Effect(true),Guard,Effect(false),Guard,Effect(true)))).next==2)
 run guard_material_change=assert(run(opened.concat(List(Guard,Effect(true),Material,Guard))).phase==Quarantined)
 run guard_lifetime_change=assert(run(opened.concat(List(Guard,Effect(true),Native,Guard))).phase==Quarantined)
 run guard_output_change=assert(run(opened.concat(List(Guard,Effect(true),Output,Guard))).phase==Quarantined)
 run zero_exit_no_receipt=assert(not(run(opened.concat(actions).concat(List(Exit,Gone,Confirm))).closed))
 run missing_receipt=assert(run(opened.concat(List(Receipt({shape:false,nonce:true,count:0}),Exit,Gone,Confirm))).uncertain)
 run wrong_nonce=assert(run(opened.concat(actions).append(Receipt({shape:true,nonce:false,count:6}))).uncertain)
 run wrong_count=assert(run(opened.concat(actions).append(Receipt({shape:true,nonce:true,count:5}))).uncertain)
 run malformed_receipt=assert(run(opened.concat(actions).append(Receipt({shape:false,nonce:true,count:6}))).uncertain)
 run source_changed_post_receipt=assert(run(opened.concat(actions).concat(List(Receipt({shape:true,nonce:true,count:6}),Material,Exit,Gone,Confirm))).uncertain)
 run unknown_gone_not_safe=assert(not(run(opened.concat(List(Guard,Effect(false),Exit,Gone,Confirm,Seed))).seeded))
 run expiry_inside_atomic_normal_close=assert(run(opened.concat(List(Tick(20))).concat(actions).concat(List(Receipt({shape:true,nonce:true,count:6}),Exit,Gone,Confirm))).closed)
 run expiry_inside_atomic_no_seed=assert(not(run(opened.concat(List(Tick(20))).concat(actions).concat(List(Receipt({shape:true,nonce:true,count:6}),Exit,Gone,Confirm,Seed))).seeded))
 run expiry_after_normal_no_seed=assert(not(run(completed.concat(List(Tick(20),Seed))).seeded))
 run no_effect_parallelism=assert(run(opened.concat(List(Guard,Effect(true),Effect(true)))).attempted==List(0))
 run no_more_than_six=assert(run(completed.concat(actions)).next==6)
 run deadline_not_reset=assert(run(opened.concat(List(Tick(20),Prepare,Register,Gate))).deadline==20)
}
