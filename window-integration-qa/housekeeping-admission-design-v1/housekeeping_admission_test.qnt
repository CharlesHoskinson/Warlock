module housekeeping_admission_test {
 import housekeeping_admission.* from "./housekeeping_admission"
 action check(v:bool):bool=all{assert(v),s'=s}
 action begin=fire(Begin).then(fire(Admit)).then(fire(StartQuery))
 action healthy=begin.then(fire(Register)).then(fire(Reply({eof:true,shape:true}))).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(fire(Release))
 run healthyThreeQueriesTest=init.then(healthy).then(healthy).then(healthy).then(fire(Prune)).then(check(s.phase==Done and s.round==3 and allProps))
 run realAdmissionWaitExcludedTest=init.then(fire(NativeTake)).then(fire(Begin)).then(fire(Tick(20))).then(check(s.phase==Waiting and s.start== -1 and s.networkStarts==0)).then(fire(NativeRelease)).then(fire(Admit)).then(fire(StartQuery)).then(check(s.start==20 and s.deadline==26))
 run clockMovesDuringNativeWaitTest=init.then(fire(NativeTake)).then(fire(Begin)).then(fire(Tick(100))).then(fire(Admit)).then(check(s.now==100 and s.owner==Native and s.phase==Waiting))
 run lockHeldBeforeDeadlineStartsTest=init.then(fire(Begin)).then(fire(Admit)).then(check(s.owner==Housekeeping and s.start== -1)).then(fire(StartQuery)).then(check(s.deadline==6))
 run preRegistrationAuthorityCostCountsTest=init.then(begin).then(fire(Tick(6))).then(fire(Register)).then(check(s.phase==Refused and not(s.registered)and s.start==0 and s.deadline==6))
 run nativeCannotEnterRegisteredTransactionTest=init.then(begin).then(fire(Register)).then(fire(NativeTake)).then(check(s.owner==Housekeeping and s.nativeWaits and allProps))
 run nativeCannotBlockPostEOFConfirmationTest=init.then(begin).then(fire(Register)).then(fire(Reply({eof:true,shape:true}))).then(fire(NativeTake)).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(check(s.accepted and s.nativeWaits and s.owner==Housekeeping))
 run perQueryReleaseAllowsNativeIngressTest=init.then(healthy).then(fire(NativeTake)).then(check(s.owner==Native and s.releaseCount==1)).then(fire(Begin)).then(fire(Tick(20))).then(check(s.phase==Waiting and s.start== -1))
 run independentNextDeadlineAfterAdmissionTest=init.then(healthy).then(fire(Tick(50))).then(healthy).then(check(s.start==50 and s.deadline==56 and s.round==2))
 run noQueryReentryDeadlineResetTest=init.then(begin).then(fire(Register)).then(fire(Tick(5))).then(fire(Begin)).then(fire(StartQuery)).then(check(s.start==0 and s.deadline==6 and s.phase==Registered))
 run noReregisterDeadlineResetTest=init.then(begin).then(fire(Register)).then(fire(Tick(5))).then(fire(Register)).then(check(s.networkStarts==1 and s.start==0 and s.deadline==6))
 run sameOriginalBudgetBeforeConnectTest=init.then(begin).then(fire(Tick(6))).then(fire(Register)).then(check(s.phase==Refused and s.closed and s.everFailed))
 run expiredReplyStillRequiresActualCloseTest=init.then(begin).then(fire(Register)).then(fire(Tick(7))).then(fire(Reply({eof:true,shape:true}))).then(check(not(s.closed))).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(check(s.phase==Refused and s.closed and s.published and not(s.accepted)))
 run postEOFLateReplyRefusesTest=init.then(begin).then(fire(Register)).then(fire(Reply({eof:true,shape:true}))).then(fire(Tick(6))).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(check(s.phase==Refused and s.eof and s.everFailed))
 run postPublicationDeadlineStillRefusesTest=init.then(begin).then(fire(Register)).then(fire(Reply({eof:true,shape:true}))).then(fire(Close)).then(fire(Confirm)).then(fire(Tick(6))).then(fire(Return)).then(check(s.phase==Refused and s.published and not(s.accepted)))
 run incompleteEOFRefusesTest=init.then(begin).then(fire(Register)).then(fire(Reply({eof:false,shape:true}))).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(check(s.phase==Refused and s.closed))
 run wrongShapeRefusesTest=init.then(begin).then(fire(Register)).then(fire(Reply({eof:true,shape:false}))).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(check(s.phase==Refused))
 run ownerChangedBeforeRegistrationRefusesTest=init.then(begin).then(fire(AuthorityChange)).then(fire(Register)).then(check(s.phase==Refused and not(s.registered)))
 run ownerChangedBeforeConfirmationRefusesTest=init.then(begin).then(fire(Register)).then(fire(Reply({eof:true,shape:true}))).then(fire(Close)).then(fire(AuthorityChange)).then(fire(Confirm)).then(fire(Return)).then(check(s.phase==Refused))
 run errorDoesNotBecomeCompleteTest=init.then(begin).then(fire(Register)).then(fire(Error)).then(fire(Reply({eof:true,shape:true}))).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(check(s.phase==Refused and s.everFailed))
 run refusalReleasesOwnedAdmissionTest=init.then(begin).then(fire(Register)).then(fire(Error)).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(fire(Release)).then(check(s.owner==Free and s.phase==Between and s.everFailed))
 run laterSuccessCannotEraseDurableFailureTest=init.then(begin).then(fire(Register)).then(fire(Error)).then(fire(Close)).then(fire(Confirm)).then(fire(Return)).then(fire(Release)).then(healthy).then(healthy).then(fire(Prune)).then(check(s.phase==Between and s.everFailed))
 run changedCoverageCannotPruneTest=init.then(healthy).then(fire(CoverageChange)).then(healthy).then(healthy).then(fire(Prune)).then(check(s.phase==Between and not(s.coverage)))
 run noEarlyAdmissionPruneAuthorityTest=init.then(begin).then(fire(Prune)).then(check(s.phase==Running and s.round==0))
 run wholeThreeLockNotRetainedTest=init.then(healthy).then(check(s.owner==Free and s.round==1)).then(fire(NativeTake)).then(check(s.owner==Native))
 run predeadlineHistoricalAcceptanceRemainsExactTest=init.then(healthy).then(fire(Tick(20))).then(check(s.accepted and s.returnedAt<s.deadline and allProps))
}
