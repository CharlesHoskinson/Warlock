module interruption_test {
 import interruption.* from "./interruption"
 run heldMoveCrossesIndependentPeerTest=init
  .then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(Focus(3)))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:700,dy:30})))
  .then(all{assert(s.capture==2 and s.focus==3 and s.boxes.get(2).x==1030 and s.boxes.get(3)==BASE.get(3) and allProps),fire(Release)})
 run heldResizeCrossesIndependentPeerTest=init
  .then(fire(Press({role:2,epoch:1,kind:2}))).then(fire(Focus(3)))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:700,dy:30})))
  .then(all{assert(s.capture==2 and s.boxes.get(2).w==940 and s.boxes.get(2).x==330 and s.boxes.get(3)==BASE.get(3) and allProps),fire(Release)})
 run blockedAncestorHasNoCaptureTest=init.then(fire(Press({role:0,epoch:1,kind:1})))
  .then(fire(Motion({role:0,epoch:1,generation:1,dx:50,dy:30})))
  .then(all{assert(s.focus==2 and s.capture == -1 and s.boxes==BASE and s.held and allProps),fire(Release)})
 run escapeBeforeFirstMotionTest=init.then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(Escape))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:50,dy:30})))
  .then(all{assert(s.boxes==BASE and s.capture == -1 and s.held and allProps),fire(Release)})
 run escapeMovedCaptionRestoresPressRectTest=init.then(fire(Press({role:2,epoch:1,kind:1})))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:50,dy:30}))).then(fire(Escape))
  .then(all{assert(s.boxes==BASE and s.pins==PINS and s.held and allProps),fire(Release)})
 run escapeResizeRestoresPressRectRequiredTest=init.then(fire(Press({role:2,epoch:1,kind:2})))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:50,dy:30}))).then(fire(Escape))
  .then(all{assert(s.boxes==BASE and s.held and allProps),fire(Release)})
 run cancelledHeldPressCannotRecaptureTest=init.then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(Escape))
  .then(fire(Press({role:3,epoch:1,kind:1})))
  .then(all{assert(s.stale and s.capture == -1 and s.held and allProps),fire(Release)})
  .then(fire(Press({role:3,epoch:1,kind:1}))).then(fire(Motion({role:3,epoch:1,generation:1,dx:30,dy:10})))
  .then(all{assert(s.capture==3 and s.boxes.get(3).x==1030 and allProps),fire(Release)})
 run reloadMoveRetiresOldGenerationTest=init.then(fire(Press({role:2,epoch:1,kind:1})))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:50,dy:30}))).then(fire(Reload))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:100,dy:90})))
  .then(all{assert(s.generation==2 and s.boxes==BASE and s.held and s.stale and allProps),fire(Release)})
 run reloadResizeRetiresCaptureRequiredTest=init.then(fire(Press({role:2,epoch:1,kind:2})))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:50,dy:30}))).then(fire(Reload))
  .then(all{assert(s.boxes==BASE and s.capture == -1 and s.pins==PINS and allProps),fire(Release)})
 run latestGeometryMixedPinsPreviewRestoreTest=init.then(fire(Press({role:2,epoch:1,kind:1})))
  .then(fire(Motion({role:2,epoch:1,generation:1,dx:50,dy:30}))).then(fire(Minimize)).then(fire(Release))
  .then(fire(Preview({role:2,epoch:1})))
  .then(all{assert(not(s.minimized) and s.boxes.get(2)=={x:380,y:380,w:240,h:140} and s.pins==PINS and s.focus==2 and s.boxes.get(3)==BASE.get(3) and allProps),fire(Release)})
 run newerPinIntentSurvivesCancellationTest=init.then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(Pin(false))).then(fire(Escape))
  .then(all{assert(FAMILY.forall(role=>not(s.pins.get(role))) and s.boxes==BASE and allProps),fire(Release)})
 run newerPinIntentSurvivesRestoreTest=init.then(fire(Minimize)).then(fire(Pin(false))).then(fire(Restore))
  .then(all{assert(FAMILY.forall(role=>not(s.pins.get(role))) and s.focus==2 and allProps),fire(Release)})
 run closedCapturedDialogNewLifetimeRejectsMotionTest=init.then(fire(Press({role:2,epoch:1,kind:1})))
  .then(fire(Close(2))).then(fire(Open(2))).then(fire(Motion({role:2,epoch:1,generation:1,dx:700,dy:30})))
  .then(all{assert(s.epochs.get(2)==3 and s.boxes==BASE and s.capture == -1 and s.stale and allProps),fire(Release)})
 run staleMinimizedPreviewCannotRestoreNewLifetimeTest=init.then(fire(Minimize)).then(fire(Close(2))).then(fire(Open(2)))
  .then(fire(Preview({role:2,epoch:1})))
  .then(all{assert(s.minimized and s.stale and s.boxes==BASE and allProps),fire(Release)})
 run currentGenerationStillActionableAfterReloadsTest=init.then(fire(Reload)).then(fire(Reload)).then(fire(Reload))
  .then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(Motion({role:2,epoch:1,generation:4,dx:50,dy:30})))
  .then(all{assert(s.captureGeneration==4 and s.boxes.get(2).x==380 and allProps),fire(Release)})
 run escapeCannotDropIntoPeerGroupTest=init.then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(HoverDrop(3))).then(fire(Focus(3))).then(fire(Escape))
  .then(all{assert(s.groups.get(2)==2 and s.focus==3 and allProps),fire(Release)})
 run reloadCannotDropIntoPeerGroupTest=init.then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(HoverDrop(3))).then(fire(Focus(3))).then(fire(Reload))
  .then(all{assert(s.groups.get(2)==2 and s.focus==3 and allProps),fire(Release)})
 run minimizeRetirementCannotDropIntoPeerGroupTest=init.then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(HoverDrop(3))).then(fire(Minimize))
  .then(all{assert(s.groups.get(2)==2 and allProps),fire(Release)})
 run genuineReleaseKeepsGroupDropTest=init.then(fire(Press({role:2,epoch:1,kind:1}))).then(fire(HoverDrop(3))).then(fire(Release))
  .then(all{assert(s.groups.get(2)==3 and allProps),fire(Focus(3))})
}
