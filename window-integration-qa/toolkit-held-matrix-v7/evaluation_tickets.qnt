module evaluation_tickets {
 type Event=Arm({ticket:int,count:int,relay:int,prior:bool})|Evaluate(int)|Callback({ticket:int,ordinal:int,relay:bool,root:bool,source:bool,eof:bool})|Terminal({ordinal:int,relay:bool,normal:bool})|Refuse|InputsGone|ClientsGone|HelpersGone|Cleanup({ticket:int})|Unload|Archive|Idle
 type S={ticket:int,count:int,relay:int,ordinal:int,seen:Set[int],hydrated:Set[int],relayed:Set[int],hydrateDone:Set[int],relayDone:Set[int],refused:bool,inputGone:bool,clientsGone:bool,helpersGone:bool,cleanup:bool,unloaded:bool,archived:bool,delegated:bool,acceptedTicket:int,acceptedOrdinal:int,acceptedRoot:bool,acceptedSource:bool,acceptedEOF:bool}
 var s:S
 action init=s'={ticket:0,count:0,relay:0,ordinal:0,seen:Set(),hydrated:Set(),relayed:Set(),hydrateDone:Set(),relayDone:Set(),refused:false,inputGone:false,clientsGone:false,helpersGone:true,cleanup:false,unloaded:false,archived:false,delegated:false,acceptedTicket:0,acceptedOrdinal:0,acceptedRoot:false,acceptedSource:false,acceptedEOF:false}
 val complete=s.ordinal==s.count and 1.to(s.count).forall(i=>s.hydrateDone.contains(i)) and (s.relay==0 or s.relayDone.contains(s.relay))
 action fire(e:Event):bool={val b={...s,delegated:false};s'=match e {
 | Arm(p)=>if(not(s.refused) and p.prior and complete and s.helpersGone and p.ticket>s.ticket and p.count>=1 and p.count<=2 and (p.relay==0 or p.relay==p.count)){...b,ticket:p.ticket,count:p.count,relay:p.relay,ordinal:0,seen:Set(),hydrated:Set(),relayed:Set(),hydrateDone:Set(),relayDone:Set(),cleanup:false,unloaded:false,archived:false} else b
 | Evaluate(i)=>if(s.ticket>0 and i==s.ordinal+1 and i<=s.count){...b,ordinal:i,seen:s.seen.union(Set(i))} else {...b,refused:true}
 | Callback(p)=>if(p.ticket==s.ticket and s.seen.contains(p.ordinal) and p.root and p.source and p.eof and (if(p.relay)p.ordinal==s.relay and not(s.relayed.contains(p.ordinal)) else not(s.hydrated.contains(p.ordinal)))){...b,delegated:true,acceptedTicket:p.ticket,acceptedOrdinal:p.ordinal,acceptedRoot:p.root,acceptedSource:p.source,acceptedEOF:p.eof,helpersGone:false,hydrated:if(p.relay)s.hydrated else s.hydrated.union(Set(p.ordinal)),relayed:if(p.relay)s.relayed.union(Set(p.ordinal)) else s.relayed} else {...b,refused:true}
 | Terminal(p)=>if(p.normal and (if(p.relay)s.relayed.contains(p.ordinal) and not(s.relayDone.contains(p.ordinal)) else s.hydrated.contains(p.ordinal) and not(s.hydrateDone.contains(p.ordinal)))){...b,hydrateDone:if(p.relay)s.hydrateDone else s.hydrateDone.union(Set(p.ordinal)),relayDone:if(p.relay)s.relayDone.union(Set(p.ordinal)) else s.relayDone} else {...b,refused:true}
 | Refuse=>{...b,refused:true}
 | InputsGone=>{...b,inputGone:true}
 | ClientsGone=>{...b,clientsGone:true}
 | HelpersGone=>{...b,helpersGone:true}
 | Cleanup(p)=>if(s.inputGone and s.clientsGone and s.helpersGone and s.ordinal==s.count and p.ticket>s.ticket){...b,ticket:p.ticket,count:1,relay:0,ordinal:0,seen:Set(),hydrated:Set(),relayed:Set(),hydrateDone:Set(),relayDone:Set(),cleanup:true,unloaded:false,archived:false} else b
 | Unload=>if(s.cleanup){...b,unloaded:true} else b
 | Archive=>if(s.cleanup and s.unloaded and complete and s.helpersGone){...b,archived:true} else b
 | Idle=>b
 }}
 val invariant=all {s.ordinal<=s.count,s.hydrateDone.subseteq(s.hydrated),s.relayDone.subseteq(s.relayed),s.relayed.forall(i=>i==s.relay),s.delegated implies all {s.acceptedTicket==s.ticket,s.seen.contains(s.acceptedOrdinal),s.acceptedRoot,s.acceptedSource,s.acceptedEOF},s.archived implies all {s.cleanup,s.unloaded,s.inputGone,s.clientsGone,complete,s.helpersGone}}
 action step={nondet e=Set(Arm({ticket:1,count:1,relay:1,prior:true}),Arm({ticket:2,count:2,relay:2,prior:true}),Arm({ticket:2,count:1,relay:0,prior:false}),Evaluate(1),Evaluate(2),Evaluate(3),Callback({ticket:1,ordinal:1,relay:false,root:true,source:true,eof:true}),Callback({ticket:2,ordinal:1,relay:false,root:true,source:true,eof:true}),Callback({ticket:2,ordinal:2,relay:false,root:true,source:true,eof:true}),Callback({ticket:2,ordinal:1,relay:true,root:true,source:true,eof:true}),Callback({ticket:2,ordinal:2,relay:true,root:true,source:true,eof:true}),Callback({ticket:1,ordinal:1,relay:false,root:false,source:true,eof:true}),Callback({ticket:1,ordinal:1,relay:false,root:true,source:false,eof:true}),Callback({ticket:1,ordinal:1,relay:false,root:true,source:true,eof:false}),Terminal({ordinal:1,relay:false,normal:true}),Terminal({ordinal:2,relay:false,normal:true}),Terminal({ordinal:2,relay:true,normal:true}),Terminal({ordinal:1,relay:false,normal:false}),Refuse,InputsGone,ClientsGone,HelpersGone,Cleanup({ticket:3}),Unload,Archive,Idle).oneOf();fire(e)}
 action check(p:bool):bool=all {assert(p),s'=s}
 action load=fire(Arm({ticket:2,count:2,relay:2,prior:true}))
 run loadHasTwoDistinctEvaluationSlotsTest=init.then(load).then(fire(Evaluate(1))).then(fire(Evaluate(2))).then(check(s.seen==Set(1,2) and invariant))
 run extraEvaluationRefusesTest=init.then(load).then(fire(Evaluate(1))).then(fire(Evaluate(2))).then(fire(Evaluate(3))).then(check(s.refused and invariant))
 run staleTicketCannotDelegateTest=init.then(load).then(fire(Evaluate(1))).then(fire(Callback({ticket:1,ordinal:1,relay:false,root:true,source:true,eof:true}))).then(check(not(s.delegated) and s.refused))
 run duplicateHydrateCannotDelegateTwiceTest=init.then(load).then(fire(Evaluate(1))).then(fire(Callback({ticket:2,ordinal:1,relay:false,root:true,source:true,eof:true}))).then(fire(Callback({ticket:2,ordinal:1,relay:false,root:true,source:true,eof:true}))).then(check(not(s.delegated) and s.refused))
 run supersededTimerCannotConsumeCurrentRelayTest=init.then(load).then(fire(Evaluate(1))).then(fire(Evaluate(2))).then(fire(Callback({ticket:2,ordinal:1,relay:true,root:true,source:true,eof:true}))).then(check(not(s.delegated) and s.refused))
 run currentContextRelayHasExactSlotTest=init.then(load).then(fire(Evaluate(1))).then(fire(Evaluate(2))).then(fire(Callback({ticket:2,ordinal:2,relay:true,root:true,source:true,eof:true}))).then(check(s.delegated and invariant))
 run incompletePriorCallbacksBlockFeatureArmTest=init.then(load).then(fire(Evaluate(1))).then(fire(Arm({ticket:3,count:1,relay:1,prior:true}))).then(check(s.ticket==2))
 run refusedFeatureCannotAuthorizeNewFeatureTest=init.then(fire(Refuse)).then(fire(Arm({ticket:1,count:1,relay:1,prior:true}))).then(check(s.ticket==0))
 run failedFeatureStillAllowsBoundTerminalCleanupTest=init.then(fire(Refuse)).then(fire(InputsGone)).then(fire(ClientsGone)).then(fire(HelpersGone)).then(fire(Cleanup({ticket:3}))).then(check(s.cleanup and s.refused))
 run finalQueueMustFinishBeforeArchiveTest=init.then(fire(InputsGone)).then(fire(ClientsGone)).then(fire(Cleanup({ticket:3}))).then(fire(Unload)).then(fire(Archive)).then(check(not(s.archived)))
 run wrongRootCannotDelegateTest=init.then(load).then(fire(Evaluate(1))).then(fire(Callback({ticket:2,ordinal:1,relay:false,root:false,source:true,eof:true}))).then(check(not(s.delegated) and s.refused))
 run changedSourceCannotDelegateTest=init.then(load).then(fire(Evaluate(1))).then(fire(Callback({ticket:2,ordinal:1,relay:false,root:true,source:false,eof:true}))).then(check(not(s.delegated) and s.refused))
 run incompleteEOFNeverDelegatesTest=init.then(load).then(fire(Evaluate(1))).then(fire(Callback({ticket:2,ordinal:1,relay:false,root:true,source:true,eof:false}))).then(check(not(s.delegated) and s.refused))
 run duplicateTerminalRemainsFailureTest=init.then(load).then(fire(Evaluate(1))).then(fire(Callback({ticket:2,ordinal:1,relay:false,root:true,source:true,eof:true}))).then(fire(Terminal({ordinal:1,relay:false,normal:true}))).then(fire(Terminal({ordinal:1,relay:false,normal:true}))).then(check(s.refused))
 run failedFeatureNormalFinalQueueDoesNotEraseFailureTest=init.then(fire(Refuse)).then(fire(InputsGone)).then(fire(ClientsGone)).then(fire(Cleanup({ticket:3}))).then(fire(Unload)).then(fire(Evaluate(1))).then(fire(Callback({ticket:3,ordinal:1,relay:false,root:true,source:true,eof:true}))).then(fire(Terminal({ordinal:1,relay:false,normal:true}))).then(fire(HelpersGone)).then(fire(Archive)).then(check(s.archived and s.refused and invariant))
}
