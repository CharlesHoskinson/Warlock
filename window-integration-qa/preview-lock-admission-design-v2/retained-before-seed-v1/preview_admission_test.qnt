module preview_admission_test {
 import preview_admission.* from "./preview_admission"
 action check(v:bool):bool=all{assert(v),s'=s}
 action begin=fire(Begin({count:3,receipt:1,deadline:8,exact:true}))
 action free(a:int):bool=fire(Acquire({address:a,reply:Free}))
 action busy(a:int):bool=fire(Acquire({address:a,reply:Busy}))
 run positiveTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Launch)).then(check(s.launch and allProps))
 run normalWriterBusyThenReleaseTest=init.then(begin).then(free(1)).then(busy(2)).then(check(s.held==Set())).then(fire(Sleep)).then(fire(Tick(1))).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(check(s.phase==Admitted))
 run partialLocksCannotSleepTest=init.then(begin).then(free(1)).then(fire(Sleep)).then(check(s.phase==Refused and s.held==Set()))
 run receiptLockCannotSleepTest=init.then(begin).then(fire(ReceiptEnter)).then(fire(Sleep)).then(check(s.phase==Refused))
 run receiptHeldCannotFlockTest=init.then(begin).then(fire(ReceiptEnter)).then(free(1)).then(check(s.phase==Refused))
 run keeperHeldCannotSleepTest=init.then(begin).then(fire(KeeperEnter)).then(fire(Sleep)).then(check(s.phase==Refused))
 run lifecycleHeldCannotSleepTest=init.then(begin).then(fire(LifecycleEnter)).then(fire(Sleep)).then(check(s.phase==Refused))
 run keeperHeldCannotFlockTest=init.then(begin).then(fire(KeeperEnter)).then(free(1)).then(check(s.phase==Refused))
 run lifecycleHeldCannotFlockTest=init.then(begin).then(fire(LifecycleEnter)).then(free(1)).then(check(s.phase==Refused))
 run clockReversalRefusesTest=init.then(begin).then(fire(Tick(-1))).then(check(s.phase==Refused and s.now==0))
 run clockAdvancesWithReceiptHeldTest=init.then(begin).then(fire(ReceiptEnter)).then(fire(Tick(8))).then(check(s.now==8 and s.phase==Refused and not(s.receiptHeld)))
 run clockAdvancesWithPartialAddressHeldTest=init.then(begin).then(free(1)).then(fire(Tick(8))).then(check(s.now==8 and s.phase==Refused and s.held==Set()))
 run noDeadlineResetOnBusyTest=init.then(begin).then(fire(Tick(7))).then(busy(1)).then(fire(Tick(1))).then(free(1)).then(check(s.phase==Refused and s.deadline==8))
 run noDeadlineResetOnReentryTest=init.then(begin).then(fire(Tick(7))).then(begin).then(check(s.phase==Refused and s.deadline==8))
 run expiredBeforeBeginTest=init.then(fire(Tick(8))).then(begin).then(check(s.phase==Refused))
 run allLocksExpireBeforeCommitTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Tick(8))).then(fire(Commit)).then(check(s.phase==Refused and not(s.launch)))
 run expireAfterAdmissionBeforeLaunchTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Tick(8))).then(fire(Launch)).then(check(s.phase==Refused))
 run unknownErrorRefusesTest=init.then(begin).then(fire(Acquire({address:1,reply:Unknown}))).then(check(s.phase==Refused))
 run replacedLockRefusesTest=init.then(begin).then(fire(Acquire({address:1,reply:Replaced}))).then(check(s.phase==Refused))
 run unrelatedAddressRefusesTest=init.then(begin).then(free(4)).then(check(s.phase==Refused))
 run duplicateAcquireRefusesTest=init.then(begin).then(free(1)).then(free(1)).then(check(s.phase==Refused))
 run missingAddressRefusesCommitTest=init.then(begin).then(free(1)).then(fire(Commit)).then(check(s.phase==Refused))
 run supersededWhileWaitingTest=init.then(begin).then(busy(1)).then(fire(Supersede(2))).then(free(1)).then(check(s.phase==Refused))
 run authorityChangedWhileWaitingTest=init.then(begin).then(busy(1)).then(fire(GuardFailure)).then(fire(Commit)).then(check(s.phase==Refused))
 run original64BoundTest=init.then(fire(Begin({count:64,receipt:1,deadline:8,exact:true}))).then(check(s.required.size()==64 and s.phase==Acquiring))
 run above64RefusesTest=init.then(fire(Begin({count:65,receipt:1,deadline:8,exact:true}))).then(check(s.phase==Refused))
 run malformedDeadlineRefusesTest=init.then(fire(Begin({count:3,receipt:1,deadline:9,exact:true}))).then(check(s.phase==Refused))
 run foreignReceiptRefusesTest=init.then(fire(Begin({count:3,receipt:2,deadline:8,exact:true}))).then(check(s.phase==Refused))
 run unknownFamilyRefusesTest=init.then(fire(Begin({count:3,receipt:1,deadline:8,exact:false}))).then(check(s.phase==Refused))
 run reverseAddressOrderRefusesTest=init.then(begin).then(free(2)).then(check(s.phase==Refused))
 run skipAddressRefusesTest=init.then(begin).then(free(1)).then(free(3)).then(check(s.phase==Refused))
 run originalDeadlineAtDispatchTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Tick(8))).then(fire(Launch)).then(check(s.phase==Refused and not(s.helperOwned)))
 run admissionIsNotPublicationTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(check(s.admittedAt==0 and s.publishedAt== -1))
 run normalPublicationTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Launch)).then(fire(NormalClosure)).then(fire(BeginPublication)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(FinishPublication)).then(check(s.phase==Published and allProps))
 run expireAfterDispatchRetainsOwnershipTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Launch)).then(fire(Tick(8))).then(fire(BeginPublication)).then(check(s.phase==Refused and s.helperOwned and not(s.helperClosed)))
 run exactClosureAfterExpiredDispatchNoPublicationTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Launch)).then(fire(Tick(8))).then(fire(BeginPublication)).then(fire(NormalClosure)).then(fire(BeginPublication)).then(check(s.phase==Refused and s.helperClosed and not(s.helperOwned) and s.publishedAt== -1))
 run uncertainClosureQuarantineTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Launch)).then(fire(UnknownClosure)).then(fire(NormalClosure)).then(check(s.phase==Refused and s.quarantined and s.helperClosed))
 run noPublicationBeforeClosureTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Launch)).then(fire(BeginPublication)).then(check(s.phase==Refused and s.helperOwned))
 run expireDuringReplacementRefusesCompletePublicationTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Launch)).then(fire(NormalClosure)).then(fire(BeginPublication)).then(fire(ReplaceOne)).then(fire(Tick(8))).then(fire(ReplaceOne)).then(check(s.phase==Refused and s.replaced==1 and s.publishedAt== -1))
 run finalPendingCommitDeadlineTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(Commit)).then(fire(Launch)).then(fire(NormalClosure)).then(fire(BeginPublication)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(ReplaceOne)).then(fire(Tick(8))).then(fire(FinishPublication)).then(check(s.phase==Refused and s.replaced==9 and s.publishedAt== -1))
 run partialAddressSetCannotWaitForReceiptTest=init.then(begin).then(free(1)).then(fire(ReceiptWait)).then(check(s.phase==Refused and s.held==Set()))
 run fullAddressSetMayBoundedlyWaitForReceiptTest=init.then(begin).then(free(1)).then(free(2)).then(free(3)).then(fire(ReceiptWait)).then(fire(Tick(8))).then(check(s.phase==Refused and s.held==Set()))
}
