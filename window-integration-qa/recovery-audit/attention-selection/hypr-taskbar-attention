#!/usr/bin/env python3
"""Track compositor urgency for the taskbar, clearing it on focus or close."""

import fcntl
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import tempfile
import time


RUNTIME = Path(os.getenv("XDG_RUNTIME_DIR", str(Path.home() / ".cache")))
STATE = RUNTIME / "hypr-taskbar-attention.json"
ADDRESS = re.compile(r"^0x[0-9a-fA-F]+$")


def normalize(value):
    value = value.strip()
    if not value.startswith("0x"):
        value = "0x" + value
    return value.lower() if ADDRESS.fullmatch(value) else ""


def current_clients():
    return json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True, timeout=3))


def active_address():
    data = json.loads(subprocess.check_output(["hyprctl", "activewindow", "-j"], text=True, timeout=3))
    return normalize(str(data.get("address", "")))


def apply_event(state, event, payload, windows, active):
    address = normalize(payload)
    if not address:
        return False
    if event == "urgent":
        window = next((w for w in windows if normalize(str(w.get("address", ""))) == address), None)
        if window is None or address == active:
            return False
        identity = {"pid": window.get("pid"), "stableId": window.get("stableId", "")}
        if state.get(address) != identity:
            state[address] = identity
            return True
    elif event in {"activewindowv2", "closewindow"}:
        return state.pop(address, None) is not None
    return False


def save(state):
    fd, temporary = tempfile.mkstemp(prefix=".hypr-taskbar-attention.", dir=RUNTIME)
    try:
        with os.fdopen(fd, "w") as out:
            json.dump(state, out)
        os.replace(temporary, STATE)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def event_socket_path(runtime, signature):
    """Event and hyprctl queries must observe the same compositor instance."""
    if not signature:
        raise ValueError("Compositor instance must be resolved before opening an event stream")
    return runtime / "hypr" / signature / ".socket2.sock"


def compositor_instance():
    """Prefer the session target; outside a session only a unique target is safe."""
    signature = os.getenv("HYPRLAND_INSTANCE_SIGNATURE", "")
    if signature:
        return signature
    try:
        instances = json.loads(subprocess.check_output(
            ["hyprctl", "instances", "-j"], text=True, timeout=3))
    except (subprocess.SubprocessError, ValueError, OSError) as error:
        raise ValueError("Cannot resolve a unique compositor instance") from error
    if not isinstance(instances, list) or len(instances) != 1:
        raise ValueError("Cannot resolve a unique compositor instance")
    row = instances[0]
    signature = row.get("instance") if isinstance(row, dict) else None
    if not isinstance(signature, str) or not signature:
        raise ValueError("Unique compositor instance has no signature")
    # Subsequent hyprctl calls and reconnects must share the selected stream.
    os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = signature
    return signature


def run():
    # Resolve before creating a lock or clearing a valid cached state.
    signature = compositor_instance()
    RUNTIME.mkdir(parents=True, exist_ok=True)
    with (RUNTIME / ".hypr-taskbar-attention.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        state = {}
        save(state)
        while True:
            try:
                event_socket = event_socket_path(RUNTIME, signature)
                if event_socket is None:
                    raise FileNotFoundError("No compositor event socket")
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
                    connection.connect(str(event_socket))
                    with connection.makefile("r") as stream:
                        for line in stream:
                            event, _, payload = line.strip().partition(">>")
                            if event not in {"urgent", "activewindowv2", "closewindow"}:
                                continue
                            try:
                                windows = current_clients() if event == "urgent" else []
                                active = active_address() if event == "urgent" else ""
                                if apply_event(state, event, payload, windows, active):
                                    save(state)
                            except (subprocess.SubprocessError, ValueError, OSError):
                                continue
            except (ConnectionError, OSError):
                pass
            # EOF and failure both invalidate attention from the old stream.
            # A restart can lose close/focus events while the connection is down.
            if state:
                state.clear()
                save(state)
            time.sleep(1)


if __name__ == "__main__":
    try:
        run()
    except ValueError as error:
        print(f"hypr-taskbar-attention: {error}", file=sys.stderr)
        sys.exit(2)
