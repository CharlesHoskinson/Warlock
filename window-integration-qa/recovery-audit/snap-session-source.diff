+def session_state(state, instance):
+    """Keep reload hydration within its original compositor incarnation."""
+    if not isinstance(state, dict) or (state.get('instance') and state['instance'] != instance):
+        state = {'version': 1, 'snapped': {}, 'groups': [], 'next_id': 0}
+    state['instance'] = instance
+    return state
+
+def compositor_instance():
+    """Select one compositor before loading or replacing persistent state."""
+    instance = os.getenv('HYPRLAND_INSTANCE_SIGNATURE', '')
+    if instance:
+        return instance
+    try:
+        instances = json.loads(ctl('instances', '-j'))
+    except (OSError, ValueError, subprocess.SubprocessError) as error:
+        raise ValueError('Unable to identify the compositor instance') from error
+    if not isinstance(instances, list) or len(instances) != 1:
+        raise ValueError('Set HYPRLAND_INSTANCE_SIGNATURE when no unique compositor instance is available')
+    instance = instances[0].get('instance') if isinstance(instances[0], dict) else None
+    if not isinstance(instance, str) or not instance:
+        raise ValueError('The compositor instance has no valid signature')
+    # hyprctl queries and mutations must use the instance that owns the tag.
+    os.environ['HYPRLAND_INSTANCE_SIGNATURE'] = instance
+    return instance
+
