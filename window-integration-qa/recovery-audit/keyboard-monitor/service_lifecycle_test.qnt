module service_lifecycle_test {
  import service_lifecycle.* from "./service_lifecycle"
  run adoptionDoesNotInferGrabsTest=init.then(fire(Owner(1))).then(fire(Adopt((1,1))))
    .then(all {assert(adopted==1 and subscriptions.size()==0),fire(Request(1))})
    .then(all {assert(subscriptions==Set(1)),fire(Release)})
  run ownerChurnRejectsStaleAdoptionTest=init.then(fire(Owner(1))).then(fire(Owner(2)))
    .then(fire(Adopt((1,1)))).then(fire(Request(1)))
    .then(all {assert(denied and subscriptions.size()==0),fire(Adopt((2,2)))})
    .then(fire(Request(2))).then(all {assert(subscriptions==Set(2)),fire(Release)})
  run heldFalsePreparePreservesSubscriptionsTest=init.then(fire(Owner(1))).then(fire(Adopt((1,1))))
    .then(fire(Request(1))).then(fire(Capture)).then(fire(Prepare))
    .then(all {assert(not(ready) and not(retiring) and subscriptions==Set(1)),fire(Release)})
  run dirtyCapsNumRefusesUnloadTest=init.then(fire(Owner(1))).then(fire(Adopt((1,1))))
    .then(fire(Request(1))).then(fire(DirtyLocks)).then(fire(Prepare))
    .then(all {assert(not(ready) and subscriptions==Set(1)),fire(ReconcileLocks)})
    .then(fire(Prepare)).then(all {assert(ready and retiring),fire(Release)})
  run retirementRejectsAllReactivationTest=init.then(fire(Owner(1))).then(fire(Adopt((1,1))))
    .then(fire(Request(1))).then(fire(Prepare)).then(fire(Request(1)))
    .then(all {assert(denied and retiring and subscriptions.size()==0),fire(Reconnect((1,1)))})
    .then(all {assert(denied and subscriptions.size()==0),fire(Capture)})
    .then(all {assert(not(held)),fire(Release)})
  run restartNeedsFreshExplicitReplayTest=init.then(fire(Owner(1))).then(fire(Adopt((1,1))))
    .then(fire(Request(1))).then(fire(Prepare)).then(fire(Reload)).then(fire(Adopt((1,1))))
    .then(fire(Reconnect((1,1))))
    .then(all {assert(denied and subscriptions.size()==0 and epoch==2),fire(Reconnect((2,1)))})
    .then(all {assert(subscriptions==Set(1) and not(retiring)),fire(Release)})
}
