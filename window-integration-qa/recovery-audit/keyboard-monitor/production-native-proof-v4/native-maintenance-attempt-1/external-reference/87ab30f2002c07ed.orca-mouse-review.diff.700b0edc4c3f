-
-        msg = f"MOUSE REVIEW: Setting enable mouse review to {value}."
-        debug.print_message(debug.LEVEL_INFO, msg, True)
-        if value == self._active:
-            return True
-
+        # Explicit user intent survives temporary backend loss. Write it before
