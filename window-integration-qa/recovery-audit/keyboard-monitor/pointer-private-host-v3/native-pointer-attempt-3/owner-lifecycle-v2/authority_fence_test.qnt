module authority_fence_test {
 import authority_fence.* from "./authority_fence"
 action finish=fire(ReceiveReply).then(fire(CompleteFence)).then(fire(Emit))
 run pendingLossSameUniqueReclaimMotionReplyTest=init.then(fire(Query)).then(fire(Lose)).then(fire(Claim)).then(fire(Motion)).then(fire(StartFence)).then(fire(ProcessFence))
  .then(fire(ReceiveOwner)).then(fire(Drain)).then(fire(ReceiveOwner)).then(fire(Drain)).then(finish)
  .then(all {assert(emissions.length()==0 and notes.length()==0 and cacheEpoch==3),fire(Motion)})
 run locallyEmptyCannotBypassUnseenDaemonLossTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Lose)).then(fire(StartFence)).then(fire(ProcessFence)).then(fire(ReceiveReply))
  .then(all {assert(fence==2 and prior==1 and local.length()==0),fire(Emit)})
  .then(all {assert(emissions.length()==0),fire(ReceiveOwner)}).then(fire(Drain)).then(finish)
 run aliasChurnInvalidatesPendingOldPrincipalTest=init.then(fire(Query)).then(fire(Alias)).then(fire(Motion)).then(fire(StartFence)).then(fire(ProcessFence)).then(fire(ReceiveOwner)).then(fire(Drain)).then(finish)
  .then(all {assert(wireOwner==1 and cacheOwner==1 and emissions.length()==0),fire(Motion)})
 run validFencedSnapshotEmitsOnceTest=init.then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(ProcessFence)).then(finish)
  .then(all {assert(emissions==List((1,1,1,1))),fire(Motion)})
 run futureUnseenOwnerLossIsInFlightBoundaryTest=init.then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(ProcessFence)).then(fire(Lose)).then(finish)
  .then(all {assert(wireOwner==0 and emissions==List((1,1,1,1))),fire(ReceiveOwner)})
 run knownLaterOwnerLossCancelsBeforeEnqueueTest=init.then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(ProcessFence)).then(fire(ReceiveReply)).then(fire(CompleteFence)).then(fire(Lose)).then(fire(ReceiveOwner)).then(fire(Drain)).then(fire(Emit))
  .then(all {assert(emissions.length()==0),fire(Motion)})
 run retirementAfterCompletionRejectsLateCallbackTest=init.then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(ProcessFence)).then(fire(ReceiveReply)).then(fire(CompleteFence)).then(fire(Retire)).then(fire(Emit))
  .then(all {assert(retired and emissions.length()==0),fire(CompleteFence)})
 run busLossAfterCompletionRejectsLateCallbackTest=init.then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(ProcessFence)).then(fire(ReceiveReply)).then(fire(CompleteFence)).then(fire(BusLoss)).then(fire(Emit))
  .then(all {assert(retired and emissions.length()==0),fire(ReceiveOwner)})
 run timeoutPreservesOtherAcceptedNoteTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(Timeout))
  .then(all {assert(notes==List(1)),fire(StartFence)}).then(fire(ProcessFence)).then(finish)
  .then(all {assert(emissions==List((1,1,1,1))),fire(Motion)})
 run noOwnerSnapshotNeverEmitsTest=init.then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(NoOwner)).then(finish)
  .then(all {assert(emissions.length()==0 and notes.length()==0),fire(Query)})
 run mismatchedOwnerSnapshotNeverEmitsTest=init.then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(Mismatch)).then(finish)
  .then(all {assert(emissions.length()==0),fire(Query)})
 run saturatedQueueRefusesNewQueryPreservesAcceptedNotesTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Query)).then(fire(Motion)).then(fire(Query))
  .then(all {assert(refused and notes==List(1,1)),fire(StartFence)}).then(fire(ProcessFence)).then(finish)
  .then(all {assert(notes==List(1) and emissions.length()==1),fire(Motion)})
 run nextAuthorizedQueryRearmsAfterTimeoutTest=init.then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(Timeout)).then(fire(Query)).then(fire(Motion)).then(fire(StartFence)).then(fire(ProcessFence)).then(finish)
  .then(all {assert(emissions==List((1,1,1,1))),fire(Motion)})
 run boundedDrainMustFinishPriorOwnerMessagesTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Lose)).then(fire(Claim)).then(fire(StartFence)).then(fire(ProcessFence)).then(fire(ReceiveOwner)).then(fire(Drain)).then(fire(ReceiveReply))
  .then(all {assert(fence==2 and prior==1),fire(Emit)}).then(all {assert(emissions.length()==0),fire(ReceiveOwner)})
 run overflowRetiresWithoutStaleDeliveryTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Overflow)).then(fire(Emit))
  .then(all {assert(retired and emissions.length()==0),fire(Query)})
}
