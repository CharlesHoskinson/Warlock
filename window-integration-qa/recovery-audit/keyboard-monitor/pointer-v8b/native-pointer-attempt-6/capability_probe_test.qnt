module capability_probe_test {
  import capability_probe.* from "./capability_probe"
  run constructorBeforeReleaseTest=init.then(fire(EvConstruct(1)))
    .then(all {assert(owned and fresh and phase==1),fire(EvNegotiate)})
    .then(all {assert(not(owned) and phase==2),fire(EvProbe)})
    .then(fire(EvReclaim)).then(all {assert(owned and available and not(fresh)),fire(EvReplay)})
  run replayOnlyAfterReclaimTest=init.then(fire(EvConstruct(1))).then(fire(EvNegotiate)).then(fire(EvArm)).then(fire(EvReplay))
    .then(all {assert(not(selected)),fire(EvProbe)}).then(fire(EvReclaim)).then(fire(EvArm)).then(fire(EvReplay))
    .then(all {assert(selected),fire(EvRelease)})
  run unknownFreshnessRefusesTest=init.then(fire(EvNegotiate))
    .then(all {assert(refused and not(owned)),fire(EvRelease)})
  run staleEpochCannotNegotiateTest=init.then(fire(EvConstruct(1))).then(fire(EvOwnerEpoch)).then(fire(EvNegotiate))
    .then(all {assert(refused and not(fresh) and not(selected)),fire(EvRelease)})
  run existingDeviceProbeDoesNotReleaseTest=init.then(fire(EvConstruct(1))).then(fire(EvNegotiate))
    .then(fire(EvProbe)).then(fire(EvReclaim)).then(fire(EvArm)).then(fire(EvReplay)).then(fire(EvHold)).then(fire(EvExistingProbe))
    .then(all {assert(owned and held and selected),fire(EvNegotiate)})
    .then(all {assert(refused and owned and held and selected),fire(EvRelease)})
  run capabilityExceptionStillReclaimsOwnNameTest=init.then(fire(EvConstruct(1)))
    .then(fire(EvNegotiate)).then(fire(EvFail)).then(fire(EvReclaim)).then(fire(EvArm)).then(fire(EvReplay))
    .then(all {assert(owned and not(available) and not(selected)),fire(EvRelease)})
  run heldFreshPolicyRefusesWithoutOwnershipLossTest=init.then(fire(EvConstruct(1)))
    .then(fire(EvUnexpectedPolicies)).then(fire(EvHold)).then(fire(EvNegotiate))
    .then(all {assert(refused and owned and held and selected),fire(EvRelease)})
  run dirtyFreshPolicyRefusesWithoutOwnershipLossTest=init.then(fire(EvConstruct(1)))
    .then(fire(EvUnexpectedPolicies)).then(fire(EvDirty)).then(fire(EvNegotiate))
    .then(all {assert(refused and owned and debt and selected),fire(EvClean)})
  run ownerReplacementDuringProbeReclaimsWithoutReplayTest=init.then(fire(EvConstruct(1)))
    .then(fire(EvNegotiate)).then(fire(EvOwnerEpoch)).then(fire(EvReclaim)).then(fire(EvArm)).then(fire(EvReplay))
    .then(all {assert(owned and not(available) and not(selected) and not(fresh)),fire(EvRelease)})
  run explicitAuthorizedQueryNeededBeforePolicyReplayTest=init.then(fire(EvConstruct(1)))
    .then(fire(EvNegotiate)).then(fire(EvProbe)).then(fire(EvReclaim)).then(fire(EvReplay))
    .then(all {assert(not(selected) and phase==4),fire(EvArm)}).then(fire(EvReplay))
    .then(all {assert(selected and phase==5),fire(EvRelease)})
  run authorizedUnknownBootstrapCountsAsArmTest=init.then(fire(EvConstruct(1)))
    .then(fire(EvNegotiate)).then(fire(EvProbe)).then(fire(EvReclaim)).then(fire(EvArmUnknown)).then(fire(EvReplay))
    .then(all {assert(selected and phase==5),fire(EvRelease)})
  run accessDeniedBootstrapMustNotCountRecoveryTest=init.then(fire(EvConstruct(1)))
    .then(fire(EvNegotiate)).then(fire(EvProbe)).then(fire(EvReclaim)).then(fire(EvArmDenied)).then(fire(EvReplay))
    .then(all {assert(owned and not(available) and not(selected)),fire(EvRelease)})
  run unsupportedCapabilityCannotArmOrReplayTest=init.then(fire(EvConstruct(1)))
    .then(fire(EvNegotiate)).then(fire(EvUnsupported)).then(fire(EvReclaim)).then(fire(EvArm)).then(fire(EvReplay))
    .then(all {assert(owned and not(available) and not(selected) and phase==4),fire(EvRelease)})
}
