prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: libweston API
Description: Header files for libweston compositors development
Version: 15.0.1
Requires.private: wayland-server >=  1.22.0, pixman-1 >=  0.25.2, xkbcommon >=  0.5.0
Libs: -L${libdir} -lweston-15
Cflags: -I${includedir}/libweston-15
