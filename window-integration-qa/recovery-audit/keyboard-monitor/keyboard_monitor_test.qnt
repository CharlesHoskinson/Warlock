module keyboard_monitor_test {
  import keyboard_monitor.* from "./keyboard_monitor"
  run defaultReaderDisabledTypingAndShortcutPassTest=init.then(fire(Press(4)))
    .then(all {assert(not(lastConsumed) and not(lastNotified) and not(readerEnabled)),fire(Release(4))})
    .then(fire(Press(3))).then(all {assert(not(lastConsumed) and delivered.contains(3)),fire(Release(3))})
  run watchDoesNotConsumeTest=init.then(fire(ClaimReader(1))).then(fire(Watch(1))).then(fire(Press(4)))
    .then(all {assert(lastNotified and not(lastConsumed)),fire(Release(4))})
    .then(all {assert(lastNotified and not(lastConsumed)),fire(Unwatch(1))})
  run exactStrokeBalancedPressReleaseTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,false,true))))
    .then(fire(Press(2))).then(all {assert(lastConsumed and lastNotified),fire(SetGrabs((1,false,false)))})
    .then(fire(Release(2))).then(all {assert(lastConsumed and captured.size()==0),fire(Press(4))})
    .then(all {assert(not(lastConsumed)),fire(Release(4))})
  run customModifierChordSuppressesToggleAndTypingTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,true,false))))
    .then(fire(Press(1))).then(all {assert(lastConsumed and not(locked)),fire(Press(4))})
    .then(all {assert(lastConsumed and lastNotified),fire(Release(1))})
    .then(fire(Release(4))).then(all {assert(lastConsumed and not(locked)),fire(Tick)})
  run secondStandaloneModifierTapPassesToggleTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,true,false))))
    .then(fire(Press(1))).then(fire(Release(1))).then(fire(Tick)).then(fire(Press(1)))
    .then(all {assert(not(lastConsumed) and locked),fire(Release(1))})
    .then(all {assert(not(lastConsumed)),fire(Tick)})
  run modifierChordDisarmsDoubleTapTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,true,false))))
    .then(fire(Press(1))).then(fire(Press(4))).then(fire(Release(4))).then(fire(Release(1))).then(fire(Press(1)))
    .then(all {assert(lastConsumed and not(locked)),fire(Release(1))})
  run ordinaryPressBetweenStandaloneTapsDisarmsTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,true,false))))
    .then(fire(Press(1))).then(fire(Release(1))).then(fire(Press(4))).then(fire(Release(4)))
    .then(all {assert(not(tapArmed)),fire(Press(1))})
    .then(all {assert(lastConsumed and not(locked)),fire(Release(1))})
  run delayedModifierTapStaysCapturedTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,true,false))))
    .then(fire(Press(1))).then(fire(Release(1))).then(fire(Tick)).then(fire(Tick)).then(fire(Press(1)))
    .then(all {assert(lastConsumed and not(locked)),fire(Release(1))})
  run changedGrabDefinitionDisarmsDoubleTapTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,true,false))))
    .then(fire(Press(1))).then(fire(Release(1))).then(fire(SetGrabs((1,true,true))))
    .then(all {assert(not(tapArmed)),fire(Press(1))})
    .then(all {assert(lastConsumed and not(locked)),fire(Release(1))})
  run clientIdentityChangeDisarmsDoubleTapTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,true,false))))
    .then(fire(Press(1))).then(fire(Release(1))).then(fire(ClaimReader(2)))
    .then(all {assert(not(tapArmed)),fire(Press(1))})
    .then(all {assert(lastConsumed and not(locked)),fire(Release(1))})
  run clientDisconnectRetainsOnlyReleaseTombstoneTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,false,true))))
    .then(fire(Press(2))).then(fire(Disconnect(1))).then(fire(Press(4)))
    .then(all {assert(not(lastConsumed) and not(lastNotified)),fire(Release(2))})
    .then(all {assert(lastConsumed and not(lastNotified)),fire(Press(2))})
    .then(all {assert(not(lastConsumed)),fire(Release(2))})
  run preexistingClientPressStillReceivesReleaseUnderGrabTest=init.then(fire(Press(3)))
    .then(fire(ClaimReader(1))).then(fire(GrabAll(1))).then(fire(Release(3)))
    .then(all {assert(not(lastConsumed) and delivered.size()==0),fire(Press(4))})
    .then(all {assert(lastConsumed),fire(Release(4))})
  run fullGrabBlocksLockAndUngrabRetainsExactStrokeTest=init.then(fire(ClaimReader(1)))
    .then(fire(SetGrabs((1,false,true)))).then(fire(GrabAll(1))).then(fire(Press(1)))
    .then(all {assert(lastConsumed and not(locked)),fire(Release(1))}).then(fire(UngrabAll(1)))
    .then(fire(Press(2))).then(all {assert(lastConsumed),fire(Release(2))})
    .then(fire(Press(4))).then(all {assert(not(lastConsumed)),fire(Release(4))})
  run unauthorizedCallerCannotWatchOrGrabTest=init.then(fire(ClaimReader(1))).then(fire(Watch(2)))
    .then(all {assert(lastDenied and not(watched)),fire(SetGrabs((2,true,true)))})
    .then(all {assert(lastDenied and not(modifierGrab) and not(strokeGrab)),fire(Press(4))})
    .then(all {assert(not(lastConsumed) and not(lastNotified)),fire(Release(4))})
  run serviceStopFailsOpenForNewKeysTest=init.then(fire(ClaimReader(1))).then(fire(GrabAll(1)))
    .then(fire(Press(2))).then(fire(StopService)).then(fire(Press(3)))
    .then(all {assert(not(lastConsumed) and not(lastNotified)),fire(Release(2))})
    .then(all {assert(lastConsumed),fire(Release(3))})
  run registeredClientsRemainIndependentTest=init.then(fire(ClaimReader(1))).then(fire(Watch(1)))
    .then(fire(ClaimReader(2))).then(fire(SetGrabs((2,false,true)))).then(fire(Disconnect(1)))
    .then(all {assert(not(watched) and registered==Set(2) and strokeGrab),fire(Press(2))})
    .then(all {assert(lastConsumed and lastNotified),fire(Release(2))})
    .then(fire(Disconnect(2))).then(fire(Press(3)))
    .then(all {assert(not(lastConsumed) and not(lastNotified)),fire(Release(3))})
  run revokedPermissionRetainsSilentCapturedReleaseTest=init.then(fire(ClaimReader(1))).then(fire(GrabAll(1)))
    .then(fire(Press(2))).then(fire(SetPermission(false))).then(fire(Release(2)))
    .then(all {assert(lastConsumed and not(lastNotified) and captured.size()==0),fire(Press(4))})
    .then(all {assert(not(lastConsumed) and not(lastNotified)),fire(Release(4))})
  run keymapReplacementKeepsCapturedReleaseTest=init.then(fire(ClaimReader(1))).then(fire(SetGrabs((1,true,false))))
    .then(fire(Press(1))).then(fire(KeymapChange)).then(fire(Release(1)))
    .then(all {assert(lastConsumed and captured.size()==0 and not(tapArmed)),fire(Press(1))})
    .then(all {assert(lastConsumed and not(locked)),fire(Release(1))})
  run deviceRemovalDropsOnlyRetiredRoutesTest=init.then(fire(ClaimReader(1))).then(fire(GrabAll(1)))
    .then(fire(Press(2))).then(fire(RemoveDevice)).then(fire(UngrabAll(1)))
    .then(all {assert(captured.size()==0 and held.size()==0 and delivered.size()==0),fire(Press(2))})
    .then(all {assert(not(lastConsumed)),fire(Release(2))})
}
