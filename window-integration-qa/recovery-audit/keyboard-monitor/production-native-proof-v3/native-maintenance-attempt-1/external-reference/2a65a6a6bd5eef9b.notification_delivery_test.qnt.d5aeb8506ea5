module notification_delivery_test {
 import notification_delivery.* from "./notification_delivery"
 run queuedOwnerBlocksDeliveryTest=init.then(fire(Query)).then(fire(Motion)).then(fire(OwnerLoss)).then(fire(Deliver))
  .then(all {assert(signals.length()==0 and owners.length()==1),fire(Drain)}).then(fire(Deliver))
  .then(all {assert(signals.length()==0 and notes.length()==0),fire(Motion)})
 run sameConnectionReclaimDropsOldEpochTest=init.then(fire(Query)).then(fire(Motion)).then(fire(OwnerLoss)).then(fire(Reclaim)).then(fire(Drain))
  .then(all {assert(owners.length()==1),fire(Deliver)}).then(all {assert(signals.length()==0),fire(Drain)}).then(fire(Deliver))
  .then(all {assert(cachedOwner==2 and signals.length()==0),fire(Motion)})
 run freshEpochQueryCanDeliverTest=init.then(fire(OwnerLoss)).then(fire(Reclaim)).then(fire(Drain)).then(fire(Drain)).then(fire(Query)).then(fire(Motion)).then(fire(Deliver))
  .then(all {assert(signals==List(2)),fire(Motion)})
 run ownerLossAfterCaptureBeforeEmitTest=init.then(fire(Query)).then(fire(Motion)).then(fire(OwnerLoss)).then(fire(Drain)).then(fire(Deliver))
  .then(all {assert(not(stale) and signals.length()==0),fire(Motion)})
 run boundedDrainDefersAtRemainingOwnerTest=init.then(fire(Query)).then(fire(Motion)).then(fire(OwnerLoss)).then(fire(Reclaim)).then(fire(Drain)).then(fire(Deliver))
  .then(all {assert(owners.length()==1 and notes.length()==1 and signals.length()==0),fire(Drain)})
 run irreversibleRetirementRejectsLateCallbacksTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Retire)).then(fire(Reclaim)).then(fire(Query)).then(all {assert(refused),fire(Deliver)})
  .then(all {assert(retired and notes.length()==0 and signals.length()==0),fire(Drain)})
 run busLossClearsNotificationsTest=init.then(fire(Query)).then(fire(Motion)).then(fire(BusLoss)).then(fire(Deliver))
  .then(all {assert(retired and pending==0 and notes.length()==0 and signals.length()==0),fire(Motion)})
 run repeatedQueriesCoalesceTest=init.then(fire(Query)).then(fire(Query)).then(fire(Motion)).then(fire(Motion)).then(fire(Deliver))
  .then(all {assert(signals==List(1)),fire(Deliver)})
 run awayBackPreservesCapturedChangeTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Motion)).then(fire(Deliver))
  .then(all {assert(point==0 and signals==List(1)),fire(Motion)})
 run fullNotificationBudgetRefusesQueryPreservesNotesTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Query)).then(fire(Motion)).then(fire(Query))
  .then(all {assert(refused and notes.length()==2 and pending==0),fire(Deliver)}).then(fire(Deliver))
  .then(all {assert(signals==List(1,1)),fire(Motion)})
 run overflowFailsClosedTest=init.then(fire(Query)).then(fire(Motion)).then(fire(Overflow)).then(fire(Deliver))
  .then(all {assert(retired and signals.length()==0),fire(Query)})
 run legacyDirectSourceCounterexampleTest=init.then(fire(Query)).then(fire(OwnerLoss)).then(fire(LegacyDirect))
  .then(all {assert(stale and signals==List(1)),fire(Retire)})
}
