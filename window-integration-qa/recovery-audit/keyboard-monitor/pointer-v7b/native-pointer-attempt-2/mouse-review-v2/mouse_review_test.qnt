module mouse_review_test {
  import mouse_review.* from "./mouse_review"
  run disabledDefaultTest=init.then(all {assert(not(requested) and not(active)),fire(Disable)})
  run trueFalseTrueTest=init.then(fire(Enable(true)))
    .then(all {assert(active and handlers==1),fire(Enable(false))})
    .then(all {assert(not(active) and handlers==0 and currentItem==0),fire(Enable(true))})
    .then(all {assert(active and handlers==1),fire(Activate)})
    .then(all {assert(handlers==1),fire(Activate)})
  run toggleAlternatesTest=init.then(fire(Toggle))
    .then(all {assert(active and requested),fire(Toggle)})
    .then(all {assert(not(active) and not(requested)),fire(Disable)})
  run refreshPreservesRequestTest=init.then(fire(Enable(true))).then(fire(Refresh((0,false))))
    .then(all {assert(requested and not(active) and currentItem==0),fire(Refresh((2,true)))})
    .then(all {assert(requested and active and device==2 and handlers==1),fire(Activate)})
  run disabledRefreshStaysDisabledTest=init.then(fire(Refresh((2,true))))
    .then(all {assert(not(active) and not(requested) and handlers==0),fire(Disable)})
  run oldDeviceSignalRejectedTest=init.then(fire(Enable(true))).then(fire(Refresh((2,true))))
    .then(fire(Signal((1,1)))).then(fire(Process(1)))
    .then(all {assert(currentItem==0 and queue.size()==0),fire(Disable)})
  run oldTimeoutCannotConsumeNewQueueTest=init.then(fire(Enable(true)))
    .then(fire(Signal((1,0)))).then(fire(Refresh((2,true))))
    .then(fire(Signal((2,1)))).then(fire(Process(0)))
    .then(all {assert(queue==Set(1) and currentItem==0),fire(Process(1))})
    .then(all {assert(currentItem==2),fire(Disable)})
  run disableClearsCurrentItemTest=init.then(fire(Enable(true))).then(fire(Signal((1,0))))
    .then(fire(Process(0))).then(all {assert(currentItem==1),fire(Enable(false))})
    .then(all {assert(currentItem==0 and not(active)),fire(Disable)})
  run disableDuringBackendLossCancelsIntentTest=init.then(fire(Enable(true)))
    .then(fire(Refresh((0,false)))).then(fire(Enable(false)))
    .then(all {assert(not(requested) and not(active)),fire(Refresh((2,true)))})
    .then(all {assert(not(requested) and not(active) and handlers==0),fire(Disable)})
  run temporarilyInactiveDisableCancelsIntentTest=init.then(fire(Enable(true))).then(fire(Disable))
    .then(all {assert(requested and not(active)),fire(Enable(false))})
    .then(fire(Refresh((2,true))))
    .then(all {assert(not(requested) and not(active)),fire(Disable)})
  run outageToggleCancelsIntentTest=init.then(fire(Enable(true))).then(fire(Refresh((0,false))))
    .then(fire(Toggle)).then(fire(Refresh((2,true))))
    .then(all {assert(not(requested) and not(active)),fire(Disable)})
  run enableDuringOutageReplaysOnReturnTest=init.then(fire(Refresh((0,false))))
    .then(fire(Enable(true))).then(all {assert(requested and not(active)),fire(Refresh((2,true)))})
    .then(all {assert(requested and active),fire(Disable)})
}

