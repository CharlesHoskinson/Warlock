   self.assertEqual(hashlib.sha256((source/'native-fixture/popup_geometry.py').read_bytes()).hexdigest(),'ae8098f52e7961ef1035d2c6a800c5d7e0f709c4c6838b12e9c0ceedcefbb76c')
