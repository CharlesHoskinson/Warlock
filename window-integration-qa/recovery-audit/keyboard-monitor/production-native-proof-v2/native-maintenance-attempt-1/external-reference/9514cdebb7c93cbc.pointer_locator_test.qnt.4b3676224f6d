module pointer_locator_test {
  import pointer_locator.* from "./pointer_locator"
  action check(p:bool):bool=all {assert(p),fire(KeyboardFocus(keyboard))}
  run noNameImplicitSubscriptionTest = init.then(fire(Claim(1)))
    .then(fire(Move((1,2)))).then(check(pending==Set() and sent==Set()))
  run unauthorizedQueryCannotArmTest = init.then(fire(Query((1,0,true))))
    .then(check(denied and pending==Set())).then(fire(Move((1,2))))
    .then(check(sent==Set()))
  run oneQueryOneMotionTest = init.then(fire(Claim(1))).then(fire(Query((1,1,true))))
    .then(fire(Move((1,2)))).then(check(sent==Set((1,1)) and pending==Set()))
    .then(fire(Move((2,3)))).then(check(sent==Set()))
  run stationaryRefocusDoesNotNotifyTest = init.then(fire(Claim(1)))
    .then(fire(Query((1,1,true)))).then(fire(KeyboardFocus(12)))
    .then(fire(Move((0,0)))).then(check(sent==Set() and pending==Set((1,1))))
  run queryCoalescesAndCallersStayIndependentTest = init.then(fire(Claim(1)))
    .then(fire(Claim(2))).then(fire(Query((1,1,true))))
    .then(fire(Query((1,1,true)))).then(fire(Query((2,1,true))))
    .then(fire(Move((3,4)))).then(check(sent==Set((1,1),(2,1))))
    .then(fire(Query((1,1,true)))).then(fire(Move((4,5))))
    .then(check(sent==Set((1,1))))
  run unknownToplevelStillArmsTest = init.then(fire(Claim(1)))
    .then(fire(Query((1,1,false)))).then(check(replyError=="UnknownToplevel" and pending==Set((1,1))))
    .then(fire(Move((1,1))))
    .then(check(sent==Set((1,1))))
  run ownerReplacementRejectsOldQueryTest = init.then(fire(Claim(1)))
    .then(fire(Query((1,1,true)))).then(fire(Claim(1)))
    .then(fire(Query((1,1,true)))).then(check(denied and pending==Set()))
    .then(fire(Move((2,2)))).then(check(sent==Set()))
  run disconnectClearsOnlyThatOwnerTest = init.then(fire(Claim(1)))
    .then(fire(Claim(2))).then(fire(Query((1,1,true))))
    .then(fire(Query((2,1,true)))).then(fire(Disconnect((1,1))))
    .then(fire(Move((2,2)))).then(check(sent==Set((2,1))))
  run hoverIndependentOfKeyboardFocusTest = init.then(fire(Claim(1)))
    .then(fire(Hover((11,-3,4)))).then(fire(KeyboardFocus(12)))
    .then(fire(Move((-1,7)))).then(fire(Query((1,1,true))))
    .then(check(replyTarget==11 and keyboard==12 and replyX==2 and replyY==3))
  run retirementCannotReactivateTest = init.then(fire(Claim(1)))
    .then(fire(Query((1,1,true)))).then(fire(Retire)).then(fire(Claim(2)))
    .then(fire(Query((2,1,true)))).then(fire(Move((2,2))))
    .then(check(retired and denied==false and pending==Set() and sent==Set()))
  run oldDisconnectCannotRemoveNewOwnerTest = init.then(fire(Claim(1)))
    .then(fire(Claim(1))).then(fire(Query((1,2,true))))
    .then(fire(Disconnect((1,1)))).then(fire(Move((2,2))))
    .then(check(registered==Set(1) and sent==Set((1,2))))
}
