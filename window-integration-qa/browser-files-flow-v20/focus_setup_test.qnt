module focus_setup_test {
 import focus_setup.* from "./focus_setup"
 run setupThenSwappedMotionsTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move(good))).then(fire(Press)).then(all{assert(pressed),fire(LoseFocus)})
 run motionsWithoutSetupRefusedTest=init.then(fire(Move(second))).then(fire(Move(good))).then(fire(Press)).then(all{assert(not(pressed)),fire(LoseFocus)})
 run ackWithoutFocusRefusedTest=init.then(fire(Establish({...goodSetup,nativeFocus:2}))).then(all{assert(not(setup)),fire(Press)})
 run refusedAckTest=init.then(fire(Establish({...goodSetup,ack:false}))).then(all{assert(not(setup)),fire(Press)})
 run wrongPointerOwnerTest=init.then(fire(Establish({...goodSetup,pointerOwner:2}))).then(all{assert(not(setup)),fire(Press)})
 run heldInputRefusedTest=init.then(fire(Establish({...goodSetup,clear:false}))).then(all{assert(not(setup)),fire(Press)})
 run lifetimeChangedDuringSetupTest=init.then(fire(Establish({...goodSetup,stable:false}))).then(all{assert(not(setup)),fire(Press)})
 run staleOwnerTest=init.then(fire(Establish({...goodSetup,owner:{...original,window:2}}))).then(all{assert(not(setup)),fire(Press)})
 run stalePidTest=init.then(fire(Establish({...goodSetup,owner:{...original,pid:2}}))).then(all{assert(not(setup)),fire(Press)})
 run staleStartTest=init.then(fire(Establish({...goodSetup,owner:{...original,start:2}}))).then(all{assert(not(setup)),fire(Press)})
 run staleSessionTest=init.then(fire(Establish({...goodSetup,owner:{...original,session:2}}))).then(all{assert(not(setup)),fire(Press)})
 run zeroMotionRefusedTest=init.then(fire(Establish(goodSetup))).then(fire(Move(good))).then(all{assert(not(pending)),fire(Press)})
 run unchangedOneAxisRefusedTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move({...good,x:20}))).then(all{assert(not(ready)),fire(Press)})
 run lostFocusBetweenMovesTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move({...good,focus:2}))).then(all{assert(not(setup) and not(ready)),fire(Press)})
 run lostPointerBetweenMovesTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move({...good,pointer:2}))).then(all{assert(not(setup) and not(ready)),fire(Press)})
 run stalePageSessionMoveTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move({...good,owner:{...original,session:2}}))).then(all{assert(not(ready)),fire(Press)})
 run staleEventRefusedTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move({...good,fresh:false}))).then(all{assert(not(ready)),fire(Press)})
 run translationMismatchRefusedTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move({...good,exactTranslation:false}))).then(all{assert(not(ready)),fire(Press)})
 run finalFocusLossRefusesPressTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move(good))).then(fire(LoseFocus)).then(fire(Press)).then(all{assert(not(pressed)),fire(LoseFocus)})
 run finalLifetimeChangeRefusesPressTest=init.then(fire(Establish(goodSetup))).then(fire(Move(second))).then(fire(Move(good))).then(fire(Change({...original,start:2}))).then(fire(Press)).then(all{assert(not(pressed)),fire(LoseFocus)})
 run setupIsNeverClickAcceptanceTest=init.then(fire(Establish(goodSetup))).then(fire(Press)).then(all{assert(setup and not(pressed)),fire(LoseFocus)})
}
